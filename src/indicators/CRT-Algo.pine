f_allrun(_tf_ok,_tf_ok_V,_val_ses,name,_arr_sesy,_arr_sesz,_show_smt, _smt_clr,_hsmt_clr,_smt_txt_clr,_show_hsmt,X_SSMT, X_label,X_text,X_ext,X_bias,shortname, arrst, Lib.QCISD_Alerts alerts)=>

    var qcisd_store = array.new<Lib.QCISD_Data>()

    if barstate.isfirst and array.size(qcisd_store) == 0

        for i = 0 to 10

            array.push(qcisd_store, Lib.QCISD_Data.new(array.new_line(), array.new_label(), array.new_int(), array.new_bool(), array.new_bool()))

    

    Lib.QCISD_Data current_qcisd = array.get(qcisd_store, arrst)



    [hmaxt,lmint,hmax2,lmin2,hmax1,lmin1,hmax,lmin,hmaxt1,lmint1,clsmax,clsmax1,clsmaxt1,clsmin,clsmin1,clsmint1,clsmaxt,clsmint,o0,txt0,mbias, hmax_o, hmax_c, hmax_l, hmax_po, lmin_o, lmin_c, lmin_h, lmin_po] 

     = f_main_process(_tf_ok,_tf_ok_V, _val_ses,open,close,high,low,time,name,_arr_sesy,_arr_sesz)

    [chmaxt,clmint,chmax2,clmin2,chmax1,clmin1,chmax,clmin,chmaxt1,clmint1,cclsmax,cclsmax1,cclsmaxt1,cclsmin,cclsmin1,cclsmint1,cclsmaxt,cclsmint,co0,ctxt0,xbias, d1, d2, d3, d4, d5, d6, d7, d8]            

     = f_main_process(_tf_ok,_tf_ok_V, _val_ses,xo0,xc0,xh0,xl0,xt0,"",_arr_sesy,_arr_sesz)

    _ssmt_label = ""

    //array.set(xy_ext,0, chmax)

    //array.set(xy_ext,1, clmin)  

    nm1 = lblfrmt == "Emoji" ? anime1 : ssmt_pair

    nm2 = lblfrmt == "Emoji" ? anime2 : ssmt_pair2

    label l_be1 = na, label l_bu1 = na

    label l_hbe1 = na, label l_hbu1 = na

    [bear1,bear0,bull1,bull0, l_be1_t, l_bu1_t] = f_ssmt(hmax2,hmax1,hmax,lmin2,lmin1,lmin,

         chmax2,chmax1,chmax,clmin2,clmin1,clmin,hmaxt,lmint,hmaxt1,lmint1,_tf_ok,_val_ses,_show_smt, _smt_clr,_smt_txt_clr,false,2,xh0,xl0, _tf_ok_V,shortname +" "+ nm1 ,name,2,array.get(arr_inv,0))

    l_be1 := l_be1_t

    l_bu1 := l_bu1_t

    array.set(X_SSMT,0,bear1)

    array.set(X_SSMT,1,bear0)    

    array.set(X_SSMT,2,bull1)

    array.set(X_SSMT,3,bull0)

    if tf_ok //and tf_ok_V

        _ssmt_label := bear0 ? _ssmt_label +" " + name +  " Normal Bearish SSMT "+ ssmt_pair + '\n' : _ssmt_label

        _ssmt_label := bull0 ? _ssmt_label +" " + name +  " Normal Bullish SSMT "+ ssmt_pair + '\n' : _ssmt_label



    [hidbear2,hidbull2, l_hbe1_t, l_hbu1_t] = f_hidden_ssmt(clsmax,clsmax1,clsmin,clsmin1,clsmaxt,clsmaxt1,

         clsmint,clsmint1,cclsmax,cclsmax1,cclsmin,cclsmin1,_tf_ok,_show_hsmt,_hsmt_clr,_smt_txt_clr,false,2,

         _val_ses, hmax1 ,hmax, lmin1,lmin,chmax1,chmax,clmin1,clmin,xh0,xl0 ,

          _tf_ok_V,shortname +" (hd) "+ nm1,name,2,array.get(arr_inv,0))

    l_hbe1 := l_hbe1_t

    l_hbu1 := l_hbu1_t

    array.set(X_SSMT,4,hidbear2)

    array.set(X_SSMT,5,hidbull2)

    if tf_ok  //and tf_ok_V   

        _ssmt_label := hidbear2 ? _ssmt_label +" " + name +  " Hidden Bearish SSMT "+ ssmt_pair + '\n' : _ssmt_label

        _ssmt_label := hidbull2 ? _ssmt_label +" " + name +  " Hidden Bullish SSMT "+ ssmt_pair + '\n' : _ssmt_label



    bool final_bear = bear0

    bool final_bull = bull0



    if triad_ok and _tf_ok

        [dhmaxt,dlmint,dhmax2,dlmin2,dhmax1,dlmin1,dhmax,dlmin,dhmaxt1,dlmint1,dclsmax,dclsmax1,dclsmaxt1,dclsmin,dclsmin1,dclsmint1,dclsmaxt,dclsmint,do0,dtxt0,ybias, d9, d10, d11, d12, d13, d14, d15, d16]            

         = f_main_process(_tf_ok,_tf_ok_V, _val_ses,yo0,yc0,yh0,yl0,yt0,"",_arr_sesy,_arr_sesz)



        label l_be2 = na, label l_bu2 = na

        label l_hbe2 = na, label l_hbu2 = na

        [bear13,bear03,bull13,bull03, l_be2_t, l_bu2_t] = f_ssmt(hmax2,hmax1,hmax,lmin2,lmin1,lmin,

             dhmax2,dhmax1,dhmax,dlmin2,dlmin1,dlmin,hmaxt,lmint,hmaxt1,lmint1,_tf_ok,_val_ses,_show_smt, _smt_clr,_smt_txt_clr,true,2,yh0,yl0, _tf_ok_V,shortname +" "+ nm2,name,3,array.get(arr_inv,1))

        l_be2 := l_be2_t

        l_bu2 := l_bu2_t

        if bear03

            array.set(X_SSMT,6,bear03)            

        if bull03

            array.set(X_SSMT,7,bull03)

        final_bear := final_bear or bear03

        final_bull := final_bull or bull03

        if tf_ok  //and tf_ok_V           

            _ssmt_label := bear03 ? _ssmt_label +" " + name + " Normal Bearish SSMT "+ ssmt_pair2 + '\n' : _ssmt_label

            _ssmt_label := bull03 ? _ssmt_label +" " + name + " Normal Bullish SSMT "+ ssmt_pair2 + '\n' : _ssmt_label



        [hidbear3,hidbull3, l_hbe2_t, l_hbu2_t] = f_hidden_ssmt(clsmax,clsmax1,clsmin,clsmin1,clsmaxt,clsmaxt1,

             clsmint,clsmint1,dclsmax,dclsmax1,dclsmin,dclsmin1,_tf_ok,_show_hsmt,_hsmt_clr,_smt_txt_clr,true,2,

             _val_ses, hmax1 ,hmax, lmin1,lmin,dhmax1,dhmax,dlmin1,dlmin,yh0,yl0 ,

              _tf_ok_V,shortname +" (hd) "+ nm2,name,3,array.get(arr_inv,1))  

        l_hbe2 := l_hbe2_t

        l_hbu2 := l_hbu2_t

        if hidbear3

            array.set(X_SSMT,8,true)            

        if hidbull3

            array.set(X_SSMT,9,true)

        if tf_ok //and tf_ok_V

            _ssmt_label := hidbear3 ? _ssmt_label +" " + name + " Hidden Bearish SSMT "+ ssmt_pair2+ '\n' : _ssmt_label

            _ssmt_label := hidbull3 ? _ssmt_label +" " + name + " Hidden Bullish SSMT "+ ssmt_pair2+ '\n' : _ssmt_label

        

        if not na(l_be1) and not na(l_be2)

            label.set_text(l_be1, shortname + " " + nm1 + " + " + nm2)

            label.delete(l_be2)

        if not na(l_bu1) and not na(l_bu2)

            label.set_text(l_bu1, shortname + " " + nm1 + " + " + nm2)

            label.delete(l_bu2)

        if not na(l_hbe1) and not na(l_hbe2)

            label.set_text(l_hbe1, shortname + " (hd) " + nm1 + " + " + nm2)

            label.delete(l_hbe2)

        if not na(l_hbu1) and not na(l_hbu2)

            label.set_text(l_hbu1, shortname + " (hd) " + nm1 + " + " + nm2)

            label.delete(l_hbu2)



        array.set(X_bias,2, ybias)



    color qcisd_text_color_applied = qcisd_text_clr, color.new(color.white, 100)

    current_qcisd.manage_qcisd(alerts, _show_smt, _tf_ok, arrst, final_bear, final_bear[1], final_bull, final_bull[1], hmaxt, hmaxt[1], lmint, lmint[1], hmax_c, hmax_o, hmax_po, lmin_c, lmin_o, lmin_po, mbias, show_qcisd, settings.smart_alert, qcisd_bear_clr, qcisd_bull_clr, qcisd_pend_clr, qcisd_text_color_applied, qcisd_width, qcisd_lbl_size, qcisd_mono, qcisd_max_limit, name + " QCISD", name)



    // array.set(X_label,0,_ssmt_label)////table



    //──────────────────────────────

    // Combine Pair1 + Pair2 Signals

    //──────────────────────────────

    _bear_pair1 = array.get(X_SSMT,1) or array.get(X_SSMT,4)   // Normal or Hidden Bearish from pair1

    _bull_pair1 = array.get(X_SSMT,3) or array.get(X_SSMT,5)   // Normal or Hidden Bullish from pair1

    _bear_pair2 = array.get(X_SSMT,6) or array.get(X_SSMT,8)   // Normal or Hidden Bearish from pair2

    _bull_pair2 = array.get(X_SSMT,7) or array.get(X_SSMT,9)   // Normal or Hidden Bullish from pair2



    _combined_label = _ssmt_label  // start with original text



    if tf_ok

        if (_bear_pair1 and _bear_pair2)

            _combined_label := name + " 🐾 Combined Bearish SSMT (" + ssmt_pair + " + " + ssmt_pair2 + ")" + '\n'

        if (_bull_pair1 and _bull_pair2)

            _combined_label := name + " 🐾 Combined Bullish SSMT (" + ssmt_pair + " + " + ssmt_pair2 + ")" + '\n'



    // Store final label

    array.set(X_label,0,_combined_label)





    array.set(X_ext,0, hmax)

    array.set(X_ext,1, lmin)

    array.set(X_ext,2, clsmax)

    array.set(X_ext,3, clsmin)    



    array.set(X_bias,0, mbias)

    array.set(X_bias,1, xbias)





             

////////////////////////////////////////////////////////////////////////////////////////////////////////////////

qcisd_alerts = Lib.QCISD_Alerts.new()

f_allrun(tf_ok    ,tf_ok_V,    val_ses ,"90m",  arr_sesy, arr_sesz, show_smtN, smtN_clr,hsmtN_clr,smt_txt_all,show_hsmtN,N_SSMT,N_label,N_text,N_ext,N_bias,"90m", 1, qcisd_alerts)

f_allrun(tf_ok_mic,tf_ok_mic_V,val_sesm,"Micro",arr_sesmy,arr_sesmz,show_smtm, smtm_clr,hsmtm_clr,smt_txt_all,show_hsmtm,m_SSMT,m_label,m_text,m_ext,m_bias,"Mic.", 0, qcisd_alerts)

f_allrun(tf_okD   ,tf_okD_V  , val_sesD,"Daily",    arr_sesDy,arr_sesDz,show_smtD, smtD_clr,hsmtD_clr,smt_txt_all,show_hsmtD,D_SSMT,D_label,D_text,D_ext,D_bias,"D", 2, qcisd_alerts)

f_allrun(tf_okW   ,tf_okW_V  , val_sesW,"Weekly",    arr_sesWy,arr_sesWz,show_smtW, smtW_clr,hsmtW_clr,smt_txt_all,show_hsmtW,W_SSMT,W_label,W_text,W_ext,W_bias,"W", 3, qcisd_alerts)

f_allrun(tf_okMo  ,tf_okMo_V and val_sesMo != 4 , val_sesMo,"Monthly",   arr_sesMoy,arr_sesMoz,show_smtMo,smtMo_clr,hsmtMo_clr,smt_txt_all,show_hsmtMo,M_SSMT,M_label,M_text,M_ext,M_bias,"M", 4, qcisd_alerts)

f_allrun(tf_okQ   ,tf_okQ_V  , val_sesQ ,"Quarterly", arr_sesQy, arr_sesQz, show_smtQ, smtQ_clr, hsmtQ_clr, smt_txt_all, show_hsmtQ, Q_SSMT, Q_label, Q_text, Q_ext, Q_bias,"Q", 6, qcisd_alerts)

f_allrun(tf_okY   ,tf_okY_V  , val_sesY ,"Yearly",    arr_sesYy, arr_sesYz, show_smtY, smtY_clr, hsmtY_clr, smt_txt_all, show_hsmtY, Y_SSMT, Y_label, Y_text, Y_ext, Y_bias,"Y", 5, qcisd_alerts)



// Trigger QCISD Alerts

//if qcisd_alerts.alert_msg != ""

//    string qcisd_payload = '{' + auth_key + 

//          '"type": "QCISD", "symbol": "' + syminfo.ticker + '", ' +

//          '"content": "⚡ **QCISD Confirmation:**\\n' + str.replace_all(qcisd_alerts.alert_msg, "\n", "\\n") + '"}'

//    alert(qcisd_payload, alert.freq_once_per_bar_close)

//    qcisd_alerts.alert_msg := ""



if show_cyclesMo and tf_okMo and tf_okMo_V

    f_cycle_box_manage(newMo, arr_sesMoy, val_sesMo)

if show_cyclesQ and tf_okQ and tf_okQ_V

    f_cycle_box_manage(newQ, arr_sesQy, val_sesQ)

if show_cyclesY and tf_okY and tf_okY_V

    f_cycle_box_manage(newY, arr_sesYy, val_sesY)

if show_cyclesW and tf_okW and tf_okW_V

    f_cycle_box_manage(newW, arr_sesWy, val_sesW)

if show_cyclesD and tf_okD and tf_okD_V

    f_cycle_box_manage(newD, arr_sesDy, val_sesD)

if show_cycles90 and tf_ok and tf_ok_V

    f_cycle_box_manage(newN, arr_sesy, val_ses)

if show_cyclesmic and tf_ok_mic and tf_ok_mic_V

    f_cycle_box_manage(newm, arr_sesmy, val_sesm)







//+------------------------------------------------------------------------------------------------------------+//

//+--- Alerts Logic (Moved & Updated)                                                                       ---+//

//+------------------------------------------------------------------------------------------------------------+//



f_check_ssmt_arr(bool[] arr) =>

    bool b_bear = array.get(arr, 1) or array.get(arr, 4) or array.get(arr, 6) or array.get(arr, 8)

    bool b_bull = array.get(arr, 3) or array.get(arr, 5) or array.get(arr, 7) or array.get(arr, 9)

    [b_bull, b_bear]



[m_bu, m_be] = f_check_ssmt_arr(m_SSMT)

[N_bu, N_be] = f_check_ssmt_arr(N_SSMT)

[D_bu, D_be] = f_check_ssmt_arr(D_SSMT)

[W_bu, W_be] = f_check_ssmt_arr(W_SSMT)

[M_bu, M_be] = f_check_ssmt_arr(M_SSMT)

[Q_bu, Q_be] = f_check_ssmt_arr(Q_SSMT)

[Y_bu, Y_be] = f_check_ssmt_arr(Y_SSMT)



bool ssmt_bull_active = m_bu or N_bu or D_bu or W_bu or M_bu or Q_bu or Y_bu

bool ssmt_bear_active = m_be or N_be or D_be or W_be or M_be or Q_be or Y_be

bool current_ssmt_active = htf_auto.crt_bull ? ssmt_bull_active : ssmt_bear_active

// Temporary test line - delete after testing

// if barstate.islast







// Fetch Bias Data

tf_r1_ltf = "60"

tf_r2_ltf = "240"

tf_r3_ltf = "1D"

tf_r4_ltf = "1W"

[r1_stb, r1_cs] = request.security(syminfo.tickerid, tf_r1_ltf, Lib.f_bias_engine(usebody_for_confirmation))

[r2_stb, r2_cs] = request.security(syminfo.tickerid, tf_r2_ltf, Lib.f_bias_engine(usebody_for_confirmation))

[r3_stb, r3_cs] = request.security(syminfo.tickerid, tf_r3_ltf, Lib.f_bias_engine(usebody_for_confirmation))

[r4_stb, r4_cs] = request.security(syminfo.tickerid, tf_r4_ltf, Lib.f_bias_engine(usebody_for_confirmation))



string active_htf_bias = "Neutral"

if settings.bias_source == "1H"

    active_htf_bias := r1_stb

else if settings.bias_source == "4H"

    active_htf_bias := r2_stb

else

    active_htf_bias := r3_stb



//+--- Fetch Parent Fractal Status ---+//

[p_auto_bull, p_auto_bear] = request.security(syminfo.tickerid, Lib.f_get_parent_tf(aligned_tf), Lib.f_fractal_check_prev(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[p1_bull, p1_bear] = request.security(syminfo.tickerid, Lib.f_get_parent_tf(htf_1), Lib.f_fractal_check_prev(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[p2_bull, p2_bear] = request.security(syminfo.tickerid, Lib.f_get_parent_tf(htf_2), Lib.f_fractal_check_prev(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[p3_bull, p3_bear] = request.security(syminfo.tickerid, Lib.f_get_parent_tf(htf_3), Lib.f_fractal_check_prev(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[p4_bull, p4_bear] = request.security(syminfo.tickerid, Lib.f_get_parent_tf(htf_4), Lib.f_fractal_check_prev(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[p5_bull, p5_bear] = request.security(syminfo.tickerid, Lib.f_get_parent_tf(htf_5), Lib.f_fractal_check_prev(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[p6_bull, p6_bear] = request.security(syminfo.tickerid, Lib.f_get_parent_tf(htf_6), Lib.f_fractal_check_prev(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)



// Update CandleSets with Parent Fractal Status

if p_auto_bull

    htf_auto.last_parent_fractal := 1

else if p_auto_bear

    htf_auto.last_parent_fractal := -1



if p1_bull

    htf1.last_parent_fractal := 1

else if p1_bear

    htf1.last_parent_fractal := -1

if p2_bull

    htf2.last_parent_fractal := 1

else if p2_bear

    htf2.last_parent_fractal := -1

if p3_bull

    htf3.last_parent_fractal := 1

else if p3_bear

    htf3.last_parent_fractal := -1

if p4_bull

    htf4.last_parent_fractal := 1

else if p4_bear

    htf4.last_parent_fractal := -1

if p5_bull

    htf5.last_parent_fractal := 1

else if p5_bear

    htf5.last_parent_fractal := -1

if p6_bull

    htf6.last_parent_fractal := 1

else if p6_bear

    htf6.last_parent_fractal := -1



// Fetch HTF POI Data

[h_bull_t, h_bull_b, h_bull_ty, h_bear_t, h_bear_b, h_bear_ty] = request.security(syminfo.tickerid, aligned_tf, Lib.f_htf_poi_arrays())

[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead=barmerge.lookahead_on)

[pwh, pwl] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead=barmerge.lookahead_on)

[pmh, pml] = request.security(syminfo.tickerid, "M", [high[1], low[1]], lookahead=barmerge.lookahead_on)



htf_auto.poi_bull_tops := h_bull_t, htf_auto.poi_bull_bots := h_bull_b, htf_auto.poi_bull_types := h_bull_ty

htf_auto.poi_bear_tops := h_bear_t, htf_auto.poi_bear_bots := h_bear_b, htf_auto.poi_bear_types := h_bear_ty



if not na(htf_auto.poi_bull_tops)

    htf_auto.poi_bull_tops.push(pdl), htf_auto.poi_bull_bots.push(pdl), htf_auto.poi_bull_types.push(6)

    htf_auto.poi_bull_tops.push(pwl), htf_auto.poi_bull_bots.push(pwl), htf_auto.poi_bull_types.push(6)

    htf_auto.poi_bull_tops.push(pml), htf_auto.poi_bull_bots.push(pml), htf_auto.poi_bull_types.push(6)

    if htf_auto.candles.size() > 1

        float prev_htf_low = htf_auto.candles.get(1).l

        htf_auto.poi_bull_tops.push(prev_htf_low), htf_auto.poi_bull_bots.push(prev_htf_low), htf_auto.poi_bull_types.push(7)



if not na(htf_auto.poi_bear_tops)

    htf_auto.poi_bear_tops.push(pdh), htf_auto.poi_bear_bots.push(pdh), htf_auto.poi_bear_types.push(6)

    htf_auto.poi_bear_tops.push(pwh), htf_auto.poi_bear_bots.push(pwh), htf_auto.poi_bear_types.push(6)

    htf_auto.poi_bear_tops.push(pmh), htf_auto.poi_bear_bots.push(pmh), htf_auto.poi_bear_types.push(6)

    if htf_auto.candles.size() > 1

        float prev_htf_high = htf_auto.candles.get(1).h

        htf_auto.poi_bear_tops.push(prev_htf_high), htf_auto.poi_bear_bots.push(prev_htf_high), htf_auto.poi_bear_types.push(7)



if htf_mode == "Auto"

    if htf1.settings.htf == aligned_tf

        htf1.settings.show := false

    if htf2.settings.htf == aligned_tf

        htf2.settings.show := false

    if htf3.settings.htf == aligned_tf

        htf3.settings.show := false

    if htf4.settings.htf == aligned_tf

        htf4.settings.show := false

    if htf5.settings.htf == aligned_tf

        htf5.settings.show := false

    if htf6.settings.htf == aligned_tf

        htf6.settings.show := false



int cnt = 0

int enabled = 0

enabled += (htf1.settings.show ? 1 : 0)

enabled += (htf2.settings.show ? 1 : 0)

enabled += (htf3.settings.show ? 1 : 0)

enabled += (htf4.settings.show ? 1 : 0)

enabled += (htf5.settings.show ? 1 : 0)

enabled += (htf6.settings.show ? 1 : 0)

int last_htf_idx = math.min(enabled, max_sets)



if htf_mode == "Auto"

    last_htf_idx += 1



int offset = settings.offset

if Lib.ValidTimeframe(aligned_tf)

    htf_auto.settings.htf := aligned_tf

    htf_auto.settings.show := show_htf_candles

    htf_auto.settings.max_display := htf_candle_count

    htf_auto.UpdateTime(settings)

    htf_auto.Monitor(psp_t2_o_auto, psp_t2_c_auto, psp_t2_h_auto, psp_t2_l_auto, psp_t3_o_auto, psp_t3_c_auto, psp_t3_h_auto, psp_t3_l_auto, settings)

      .Update(psp_t2_o_auto, psp_t2_c_auto, psp_t2_h_auto, psp_t2_l_auto, psp_t3_o_auto, psp_t3_c_auto, psp_t3_h_auto, psp_t3_l_auto, settings, psp_show, psp_t2_inv, psp_bull_color, psp_bear_color, tpd_bull_color, tpd_bear_color)

      .FindImbalance(settings)

      .DetectSwings()

      .ScanPatterns(settings, active_htf_bias, usebody_for_confirmation)

    

    if htf_auto.crt_id == invalidated_crt_id

        htf_auto.crt_active := false

    

    if barstate.isrealtime or barstate.islast

        htf_auto.Reorder(offset, settings, show_swing_lines, confirmed_swing_style, potential_swing_style, swing_high_color, swing_color, swing_line_width, show_eq_line, eq_line_color, eq_line_width, eq_line_style_input, htf_label_bold, htf_mode, aligned_tf)



    cnt := cnt + 1

    offset := offset + (cnt > 0 ? htf_auto.candles.size() * settings.width + (htf_auto.candles.size() > 0 ? (htf_auto.candles.size() - 1) * settings.buffer : 0) + settings.htf_buffer : 0)



if (htf1.settings.show or htf1.settings.htf == aligned_tf) and Lib.ValidTimeframe(htf1.settings.htf)

    htf1.UpdateTime(settings)

    htf1.Monitor(psp_t2_o_1, psp_t2_c_1, psp_t2_h_1, psp_t2_l_1, psp_t3_o_1, psp_t3_c_1, psp_t3_h_1, psp_t3_l_1, settings).Update(psp_t2_o_1, psp_t2_c_1, psp_t2_h_1, psp_t2_l_1, psp_t3_o_1, psp_t3_c_1, psp_t3_h_1, psp_t3_l_1, settings, psp_show, psp_t2_inv, psp_bull_color, psp_bear_color, tpd_bull_color, tpd_bear_color).FindImbalance(settings).DetectSwings()

    if htf1.settings.show

        htf1.Reorder(offset, settings, show_swing_lines, confirmed_swing_style, potential_swing_style, swing_high_color, swing_color, swing_line_width, show_eq_line, eq_line_color, eq_line_width, eq_line_style_input, htf_label_bold, htf_mode, aligned_tf)

        cnt := cnt + 1

        offset := offset + (cnt > 0 ? htf1.candles.size() * settings.width + (htf1.candles.size() > 0 ? (htf1.candles.size() - 1) * settings.buffer : 0) + settings.htf_buffer : 0)



if ((htf2.settings.show and cnt < last_htf_idx) or htf2.settings.htf == aligned_tf) and Lib.ValidTimeframe(htf2.settings.htf)

    htf2.UpdateTime(settings)

    htf2.Monitor(psp_t2_o_2, psp_t2_c_2, psp_t2_h_2, psp_t2_l_2, psp_t3_o_2, psp_t3_c_2, psp_t3_h_2, psp_t3_l_2, settings).Update(psp_t2_o_2, psp_t2_c_2, psp_t2_h_2, psp_t2_l_2, psp_t3_o_2, psp_t3_c_2, psp_t3_h_2, psp_t3_l_2, settings, psp_show, psp_t2_inv, psp_bull_color, psp_bear_color, tpd_bull_color, tpd_bear_color).FindImbalance(settings).DetectSwings()

    if htf2.settings.show

        htf2.Reorder(offset, settings, show_swing_lines, confirmed_swing_style, potential_swing_style, swing_high_color, swing_color, swing_line_width, show_eq_line, eq_line_color, eq_line_width, eq_line_style_input, htf_label_bold, htf_mode, aligned_tf)

        cnt := cnt + 1

        offset := offset + (cnt > 0 ? htf2.candles.size() * settings.width + (htf2.candles.size() > 0 ? (htf2.candles.size() - 1) * settings.buffer : 0) + settings.htf_buffer : 0)



if ((htf3.settings.show and cnt < last_htf_idx) or htf3.settings.htf == aligned_tf) and Lib.ValidTimeframe(htf3.settings.htf)

    htf3.UpdateTime(settings)

    htf3.Monitor(psp_t2_o_3, psp_t2_c_3, psp_t2_h_3, psp_t2_l_3, psp_t3_o_3, psp_t3_c_3, psp_t3_h_3, psp_t3_l_3, settings).Update(psp_t2_o_3, psp_t2_c_3, psp_t2_h_3, psp_t2_l_3, psp_t3_o_3, psp_t3_c_3, psp_t3_h_3, psp_t3_l_3, settings, psp_show, psp_t2_inv, psp_bull_color, psp_bear_color, tpd_bull_color, tpd_bear_color).FindImbalance(settings).DetectSwings()

    if htf3.settings.show

        htf3.Reorder(offset, settings, show_swing_lines, confirmed_swing_style, potential_swing_style, swing_high_color, swing_color, swing_line_width, show_eq_line, eq_line_color, eq_line_width, eq_line_style_input, htf_label_bold, htf_mode, aligned_tf)

        cnt := cnt + 1

        offset := offset + (cnt > 0 ? htf3.candles.size() * settings.width + (htf3.candles.size() > 0 ? (htf3.candles.size() - 1) * settings.buffer : 0) + settings.htf_buffer : 0)



if ((htf4.settings.show and cnt < last_htf_idx) or htf4.settings.htf == aligned_tf) and Lib.ValidTimeframe(htf4.settings.htf)

    htf4.UpdateTime(settings)

    htf4.Monitor(psp_t2_o_4, psp_t2_c_4, psp_t2_h_4, psp_t2_l_4, psp_t3_o_4, psp_t3_c_4, psp_t3_h_4, psp_t3_l_4, settings).Update(psp_t2_o_4, psp_t2_c_4, psp_t2_h_4, psp_t2_l_4, psp_t3_o_4, psp_t3_c_4, psp_t3_h_4, psp_t3_l_4, settings, psp_show, psp_t2_inv, psp_bull_color, psp_bear_color, tpd_bull_color, tpd_bear_color).FindImbalance(settings).DetectSwings()

    if htf4.settings.show

        htf4.Reorder(offset, settings, show_swing_lines, confirmed_swing_style, potential_swing_style, swing_high_color, swing_color, swing_line_width, show_eq_line, eq_line_color, eq_line_width, eq_line_style_input, htf_label_bold, htf_mode, aligned_tf)

        cnt := cnt + 1

        offset := offset + (cnt > 0 ? htf4.candles.size() * settings.width + (htf4.candles.size() > 0 ? (htf4.candles.size() - 1) * settings.buffer : 0) + settings.htf_buffer : 0)



if ((htf5.settings.show and cnt < last_htf_idx) or htf5.settings.htf == aligned_tf) and Lib.ValidTimeframe(htf5.settings.htf)

    htf5.UpdateTime(settings)

    htf5.Monitor(psp_t2_o_5, psp_t2_c_5, psp_t2_h_5, psp_t2_l_5, psp_t3_o_5, psp_t3_c_5, psp_t3_h_5, psp_t3_l_5, settings).Update(psp_t2_o_5, psp_t2_c_5, psp_t2_h_5, psp_t2_l_5, psp_t3_o_5, psp_t3_c_5, psp_t3_h_5, psp_t3_l_5, settings, psp_show, psp_t2_inv, psp_bull_color, psp_bear_color, tpd_bull_color, tpd_bear_color).FindImbalance(settings).DetectSwings()

    if htf5.settings.show

        htf5.Reorder(offset, settings, show_swing_lines, confirmed_swing_style, potential_swing_style, swing_high_color, swing_color, swing_line_width, show_eq_line, eq_line_color, eq_line_width, eq_line_style_input, htf_label_bold, htf_mode, aligned_tf)

        cnt := cnt + 1

        offset := offset + (cnt > 0 ? htf5.candles.size() * settings.width + (htf5.candles.size() > 0 ? (htf5.candles.size() - 1) * settings.buffer : 0) + settings.htf_buffer : 0)



if ((htf6.settings.show and cnt < last_htf_idx) or htf6.settings.htf == aligned_tf) and Lib.ValidTimeframe(htf6.settings.htf)

    htf6.UpdateTime(settings)

    htf6.Monitor(psp_t2_o_6, psp_t2_c_6, psp_t2_h_6, psp_t2_l_6, psp_t3_o_6, psp_t3_c_6, psp_t3_h_6, psp_t3_l_6, settings).Update(psp_t2_o_6, psp_t2_c_6, psp_t2_h_6, psp_t2_l_6, psp_t3_o_6, psp_t3_c_6, psp_t3_h_6, psp_t3_l_6, settings, psp_show, psp_t2_inv, psp_bull_color, psp_bear_color, tpd_bull_color, tpd_bear_color).FindImbalance(settings).DetectSwings()

    if htf6.settings.show

        htf6.Reorder(offset, settings, show_swing_lines, confirmed_swing_style, potential_swing_style, swing_high_color, swing_color, swing_line_width, show_eq_line, eq_line_color, eq_line_width, eq_line_style_input, htf_label_bold, htf_mode, aligned_tf)

        cnt := cnt + 1

        offset := offset + (cnt > 0 ? htf6.candles.size() * settings.width + (htf6.candles.size() > 0 ? (htf6.candles.size() - 1) * settings.buffer : 0) + settings.htf_buffer : 0)



//+------------------------------------------------------------------------------------------------------------+//

//+--- CRT-Algo | FULL INTEGRATED SIGNAL & EXIT ENGINE                                                 ---+//

//+------------------------------------------------------------------------------------------------------------+//

///+------------------------------------------------------------------------------------------------------------+//

//+--- Setup Scoring & Alert Generation                                                                     ---+//

//+------------------------------------------------------------------------------------------------------------+//



[_, _, alert_phase] = Lib.f_get_qt_data(minsFromDayStart)



// --- New Confluences Calculation ---

// 1. OTE Filter (Based on CRT High/Low Impulse Leg)

float crt_h_ote = htf_auto.crt_high_level

float crt_l_ote = htf_auto.crt_low_level

float crt_rng_ote = crt_h_ote - crt_l_ote



// Bullish: Draw from High to Low (OTE is in the Discount/Bottom)

// Bearish: Draw from Low to High (OTE is in the Premium/Top)

float ote_62 = htf_auto.crt_bull ? crt_h_ote - crt_rng_ote * 0.62 : crt_l_ote + crt_rng_ote * 0.62

float ote_79 = htf_auto.crt_bull ? crt_h_ote - crt_rng_ote * 0.79 : crt_l_ote + crt_rng_ote * 0.79



bool entry_in_ote = close >= math.min(ote_62, ote_79) and close <= math.max(ote_62, ote_79)

string ote_price_range = str.tostring(math.min(ote_62, ote_79), format.mintick) + "-" + str.tostring(math.max(ote_62, ote_79), format.mintick)



// 2. Volume Confirmation

float vol_avg = ta.sma(volume, 20)

bool vol_curr = volume > vol_avg

int sweep_idx = htf_auto.crt_active ? (htf_auto.crt_bull ? htf_auto.crt_low_idx : htf_auto.crt_high_idx) : na

int sweep_lookback = not na(sweep_idx) ? math.min(4999, math.max(0, bar_index - sweep_idx)) : 0

bool vol_sweep = not na(sweep_idx) and (bar_index - sweep_idx <= 4999) and volume[sweep_lookback] > 1.5 * vol_avg[sweep_lookback]

bool vol_conf = vol_curr or vol_sweep



// 3. HTF Alignment (Improved: Using the selected active HTF bias from the table instead of hardcoded 1H and 4H)

bool htf_align = (htf_auto.crt_bull and active_htf_bias == "Bullish") or (not htf_auto.crt_bull and active_htf_bias == "Bearish")



// 4. Day of Week

bool hi_dow = dayofweek == dayofweek.tuesday or dayofweek == dayofweek.wednesday



// 5. Sweep Quality

bool swp_qual = Lib.f_check_sweep_quality(htf_auto.crt_stop_level, pdh, pdl, pwh, pwl, pmh, pml, htf_auto.crt_bull)



// 6. R:R Calculation & Filter

float crt_tp2 = htf_auto.crt_bull ? htf_auto.crt_high_level : htf_auto.crt_low_level

float atr_buf = atr_14 * 0.25

float crt_sl = htf_auto.crt_bull ? htf_auto.crt_stop_level - atr_buf : htf_auto.crt_stop_level + atr_buf

float crt_rr = Lib.f_calc_rr(htf_auto.crt_entry_level, crt_sl, crt_tp2)

bool rr_filter = crt_rr >= min_rr_ratio



// --- Sticky Scoring Logic (Locking Grade at time of formation) ---

var int   fixed_score = 0

var string fixed_notes = ""

var bool   fixed_ote   = false

var bool   fixed_swp   = false

var bool   fixed_vol   = false

var bool   fixed_align = false

var float  fixed_rr    = 0.0

var string fixed_ote_txt = ""



// --- Individual Confluence Latches (Cumulative) ---

var bool l_bias  = false

var bool l_poi   = false

var bool l_smt_bull = false

var bool l_smt_bear = false

var bool l_ote   = false

var bool l_htf   = false

var bool l_kz    = false

var bool l_cyc   = false

var bool l_vol   = false

var bool l_dow   = false

var bool l_swp   = false



// --- Signal Detection ---

var int last_crt_id = -1

var int last_reset_id = -1

bool is_new_signal = htf_auto.crt_active and htf_auto.crt_id != last_crt_id



// --- One-Time Reset for Latches & Scoring ---

if htf_auto.crt_active and htf_auto.crt_id != last_reset_id

    last_reset_id := htf_auto.crt_id

    fixed_score := 0

    fixed_notes := ""

    fixed_ote   := false

    fixed_swp   := false

    fixed_vol   := false

    fixed_align := false

    fixed_rr    := 0.0

    fixed_ote_txt := ""

    

    // Reset Latches

    l_bias  := false

    l_poi   := false

    l_smt_bull := false

    l_smt_bear := false

    l_ote   := false

    l_htf   := false

    l_kz    := false

    l_cyc   := false

    l_vol   := false

    l_dow   := false

    l_swp   := false

    

    // Initial Latch from Sweep (SMT)

    int s_idx = htf_auto.crt_bull ? htf_auto.crt_low_idx : htf_auto.crt_high_idx

    int lookback = math.min(4999, math.max(0, bar_index - s_idx))

    l_smt_bull := ssmt_bull_active[lookback]

    l_smt_bear := ssmt_bear_active[lookback]



if htf_auto.crt_active

    // Continuous Latching

    l_bias  := l_bias  or ((htf_auto.crt_bull and current_main_bias == "Bullish") or (not htf_auto.crt_bull and current_main_bias == "Bearish"))

    l_poi   := l_poi   or htf_auto.crt_at_poi

    l_smt_bull := l_smt_bull or ssmt_bull_active

    l_smt_bear := l_smt_bear or ssmt_bear_active

    l_ote   := l_ote   or entry_in_ote

    l_htf   := l_htf   or htf_align

    l_kz    := l_kz    or Lib.f_is_killzone()

    l_vol   := l_vol   or vol_conf

    l_dow   := l_dow   or hi_dow

    l_swp   := l_swp   or swp_qual

    

    // Cycle Aligned (Simplified latch)

    [_, _, p_name] = Lib.f_get_qt_data(minsFromDayStart)

    l_cyc := l_cyc or (p_name == "Distribution" or p_name == "Cont/Rev")



// --- Setup Scoring & Alert Generation ---

// Pass latched values to ensure grade never drops and notes stay consistent

[alert_score, alert_notes] = Lib.f_get_setup_rating(htf_auto, htf_auto.crt_bull, l_kz, current_main_bias, val_ses, l_smt_bull, l_smt_bear, l_ote, l_vol, l_htf, l_dow, l_swp)



// Update fixed values (Cumulative)

if htf_auto.crt_active

    if is_new_signal or alert_score > fixed_score

        fixed_score := alert_score

        fixed_notes := alert_notes

        fixed_ote   := l_ote

        fixed_swp   := l_swp

        fixed_vol   := l_vol

        fixed_align := l_htf

        fixed_rr    := crt_rr





// Sync with htf_auto state for table display (Using fixed values)

if htf_auto.crt_active and entry_in_ote

    fixed_ote := true



fixed_ote_txt := (fixed_ote ? "✅ " : "❌ ") + ote_price_range



htf_auto.crt_ote_valid := fixed_ote

htf_auto.crt_sweep_quality := fixed_swp

htf_auto.crt_vol_quality := fixed_vol

htf_auto.crt_rr := fixed_rr



// Calculate CRT levels based on the updated htf_auto state

float low_crt  = htf_auto.crt_active ? htf_auto.crt_low_level : na

float high_crt = htf_auto.crt_active ? htf_auto.crt_high_level : na

float eq_crt   = htf_auto.crt_active ? (low_crt + high_crt) / 2 : na



bool smart_bull = settings.smart_alert and htf_auto.crt_active and htf_auto.crt_bull and alert_score >= 1 and (alert_phase == "Accumulation" or alert_phase == "Manipulation" or alert_phase == "Distribution" or alert_phase == "Cont/Rev") and rr_filter and low > htf_auto.crt_stop_level

bool smart_bear = settings.smart_alert and htf_auto.crt_active and not htf_auto.crt_bull and alert_score >= 1 and (alert_phase == "Accumulation" or alert_phase == "Manipulation" or alert_phase == "Distribution" or alert_phase == "Cont/Rev") and rr_filter and high < htf_auto.crt_stop_level



//+------------------------------------------------------------------------------------------------------------+//

//+--- SHARP TP/SL TRACKING (SINGLE-FIRE INTRABAR)                                                          ---+//

//+------------------------------------------------------------------------------------------------------------+//

var bool  trade_active = false



var bool  tp1_hit      = false

var bool  tp2_hit      = false

var float active_tp1   = na

var float active_tp2   = na

var float active_sl    = na

var float active_be    = na

var string active_side = ""

var bool   skip_first_bar = false



var int last_trade_id = -1

var bool alert_sent = false

var float last_alert_entry = na



if not htf_auto.crt_active and not trade_active

    alert_sent := false

    last_alert_entry := na



bool is_new_trade_signal = htf_auto.crt_active and (not alert_sent or htf_auto.crt_id != last_trade_id)



if is_new_trade_signal

    skip_first_bar := true

else

    skip_first_bar := false



// Setup Trigger Logic

bool setup_trigger = (smart_bull or smart_bear) and barstate.isconfirmed and is_new_trade_signal



// Update tracking values when a new CRT setup is detected

if is_new_trade_signal

    // Reset trade state only if it is a completely new pattern ID or alert hasn't been sent

    if not alert_sent or htf_auto.crt_id != last_trade_id

        trade_active := false 

        htf_auto.trade_is_live := false

    

    if setup_trigger

        trade_active := true

        htf_auto.trade_is_live := true

        tp1_hit      := false

        tp2_hit      := false

        active_tp1   := eq_crt

        active_tp2   := htf_auto.crt_bull ? high_crt : low_crt

        active_be    := htf_auto.crt_entry_level

        float atr_buffer = ta.atr(14) * 0.25

        active_sl    := htf_auto.crt_bull ? htf_auto.crt_stop_level - atr_buffer : htf_auto.crt_stop_level + atr_buffer

        active_side  := htf_auto.crt_bull ? "BULL" : "BEAR"



// Delay ID tracking updates until bar confirms to ensure logic triggers on the close tick

if barstate.isconfirmed

    last_crt_id   := htf_auto.crt_id

    last_trade_id := htf_auto.crt_id

    if setup_trigger

        alert_sent := true

        last_alert_entry := htf_auto.crt_entry_level



// 1. TP1 Hit (Instant Tap - Single Fire)

if trade_active and not tp1_hit and not skip_first_bar

    bool tp1_check = active_side == "BULL" ? high >= active_tp1 : low <= active_tp1

    if tp1_check

        tp1_hit := true // Invalidate this level immediately

        string tp1_payload = '{' + auth_key + 

             '"type": "EXIT", "status": "TP1", "symbol": "' + syminfo.ticker + '", ' +

             '"side": "' + active_side + '", ' +

             '"content": "🎯 **TP1 HIT:** ' + syminfo.ticker + ' | Level Cleared"}'

        alert(tp1_payload, alert.freq_once_per_bar)



// 2. TP2 Hit (Instant Tap - Single Fire)

if trade_active and not tp2_hit and not skip_first_bar

    bool tp2_check = active_side == "BULL" ? high >= active_tp2 : low <= active_tp2

    if tp2_check

        tp2_hit      := true

        trade_active := false // Kill the trade logic immediately

        htf_auto.crt_active := false

        htf_auto.trade_is_live := false

        invalidated_crt_id := htf_auto.crt_id

        string tp2_payload = '{' + auth_key +  

             '"type": "EXIT", "status": "TP2", "symbol": "' + syminfo.ticker + '", ' +

             '"side": "' + active_side + '", ' +

             '"content": "🚀 **TP2 HIT:** ' + syminfo.ticker + ' | Final Level Cleared"}'

        alert(tp2_payload, alert.freq_once_per_bar)



// 3. SL Hit (Instant Tap - Single Fire)

if trade_active and not tp2_hit and not skip_first_bar

    float current_sl = tp1_hit ? active_be : active_sl

    bool sl_check = active_side == "BULL" ? low <= current_sl : high >= current_sl

    if sl_check

        trade_active := false // Kill the trade logic immediately

        htf_auto.crt_active := false

        htf_auto.trade_is_live := false

        invalidated_crt_id := htf_auto.crt_id

        string exit_status = tp1_hit ? "TP1 + SL (BE)" : "SL"

        string sl_payload = '{' + auth_key + 

             '"type": "EXIT", "status": "' + exit_status + '", "symbol": "' + syminfo.ticker + '", ' +

             '"side": "' + active_side + '", ' +

             '"content": "❌ **' + exit_status + ' HIT:** ' + syminfo.ticker + ' | Sharp Exit"}'

        alert(sl_payload, alert.freq_once_per_bar) // Will trigger instantly on tap, but only once



// 4. Global Setup Invalidation (Ensures level clears even if no trade is live)

if htf_auto.crt_active and not trade_active

    float setup_sl_price = htf_auto.crt_bull ? htf_auto.crt_stop_level - atr_14 * 0.25 : htf_auto.crt_stop_level + atr_14 * 0.25

    bool setup_invalidated = htf_auto.crt_bull ? low <= setup_sl_price : high >= setup_sl_price

    if setup_invalidated

        invalidated_crt_id := htf_auto.crt_id

        htf_auto.crt_active := false

        trade_active := false







//+------------------------------------------------------------------------------------------------------------+//

//+--- SIGNAL PATTERN & FORMATTING (DO NOT CHANGE)                                                          ---+//

//+------------------------------------------------------------------------------------------------------------+//



plot(alert_score, "Alert Score", display=display.none)

int phase_val = alert_phase == "Accumulation" ? 1 : alert_phase == "Manipulation" ? 2 : alert_phase == "Distribution" ? 3 : 4

plot(phase_val, "Alert Phase", display=display.none)



alertcondition(smart_bull and is_new_trade_signal, title="Bullish Smart Alert", message="Bullish CRT Setup Found! Phase: {{plot_1}}")

alertcondition(smart_bear and is_new_trade_signal, title="Bearish Smart Alert", message="Bearish CRT Setup Found! Phase: {{plot_1}}")



// Logic to trigger the Discord alert only on setup changes (Removing phase change to prevent duplicates)

// setup_trigger is defined above



if setup_trigger

    float entry_price = htf_auto.crt_entry_level

    float atr_buffer  = ta.atr(14) * 0.25

    float stop_loss   = htf_auto.crt_bull ? htf_auto.crt_stop_level - atr_buffer : htf_auto.crt_stop_level + atr_buffer

    float tp1         = eq_crt

    float tp2         = htf_auto.crt_bull ? high_crt : low_crt

    

    // R:R Calculation

    float risk = math.abs(entry_price - stop_loss)

    float reward = math.abs(tp2 - entry_price)

    float rr_ratio = reward / risk

    

    // Market Regime

    [_, _, adx_val] = ta.dmi(14, 14)

    string regime = adx_val > 25 ? "Trending" : "Ranging"



    string grade_text = alert_score >= 5 ? "⭐ A++" : alert_score == 4 ? "⭐ A+" : alert_score == 3 ? "⭐ Good" : "Normal"

    string grade_stars = ""

    if alert_score > 0

        for i = 1 to alert_score

            grade_stars += "⭐"



    string side_emo = htf_auto.crt_bull ? "🟢 BULLISH" : "🔴 BEARISH"

    

    // Cleaning for JSON safety

    string clean_notes_safe = str.replace_all(str.replace_all(str.replace_all(alert_notes, "\\", "\\\\"), '"', ""), "\\n", " ")

    string swp_text   = swp_qual ? "High" : "Normal"

    string align_text = htf_align ? "Aligned" : "Counter"



    string full_msg = "━━━━━━━━━━━━━━\\n" + 

         side_emo + " CRT SETUP | " + syminfo.ticker + "\\n" + 

         "━━━━━━━━━━━━━━\\n" + 

         "🕒 **TF Alignment:** " + Lib.HTFName(timeframe.period) + "-" + Lib.HTFName(aligned_tf) + "\\n" + 

         "🔄 **Alignment:** " + align_text + "\\n" + 

         "📊 **Grade:** " + grade_stars + " (" + grade_text + ")\\n" + 

         "🕒 **Phase:** " + alert_phase + "\\n" + 

         "📥 **Entry:** " + str.tostring(entry_price, format.mintick) + "\\n" +

         "🛡️ **Stop Loss:** " + str.tostring(stop_loss, format.mintick) + "\\n" +

         "🎯 **TP 1 (EQ):** " + str.tostring(tp1, format.mintick) + "\\n" +

         "🚀 **TP 2 (Target):** " + str.tostring(tp2, format.mintick) + "\\n" + 

         "📐 **OTE Zone:** " + ote_price_range + "\\n" +

         "🧹 **Sweep Quality:** " + swp_text + "\\n" +

         "⚖️ **R:R Ratio:** " + str.tostring(rr_ratio, "0.00") + "\\n" + 

         "📈 **Regime:** " + regime + "\\n" + 

         "━━━━━━━━━━━━━━\\n" + 

         "📝 Confluences: " + clean_notes_safe



    string clean_msg = str.replace_all(full_msg, '"', "")

    string trade_action = htf_auto.crt_bull ? "buy" : "sell"

    

    // Full ENTRY Payload (Updated to include R:R and Regime)

    string payload = '{' +  auth_key + 

          '"type": "ENTRY", ' +

          '"action": "' + trade_action + '", ' +

          '"symbol": "' + syminfo.ticker + '", ' +

          //'"exchange": "' + syminfo.prefix + '", ' +

          //'"close": "' + str.tostring(close) + '", ' +

          '"price": "' + str.tostring(entry_price, format.mintick) + '", ' +

          '"sl": "' + str.tostring(stop_loss, format.mintick) + '", ' +

          '"tp": "' + str.tostring(tp1, format.mintick) + '", ' +

          '"tp2": "' + str.tostring(tp2, format.mintick) + '", ' +

          '"rr": "' + str.tostring(rr_ratio, "0.00") + '", ' +

          '"regime": "' + regime + '", ' +

          '"ote_zone": "' + ote_price_range + '", ' +

          '"sweep_quality": "' + swp_text + '", ' +

          '"alignment": "' + align_text + '", ' +

          '"tf": "' + timeframe.period + '", ' +

          '"grade": "' + grade_stars + ' (' + grade_text + ')", ' +

          '"tf_names": "' + Lib.HTFName(timeframe.period) + '-' + Lib.HTFName(aligned_tf) + '", ' +

          '"phase": "' + alert_phase + '", ' +

          '"confluences": "' + clean_notes_safe + '", ' +

          '"content": "' + clean_msg + '"}'





    alert(payload, alert.freq_once_per_bar)



//+--- CRT & LTF Drawing Logic ---+//

var line crt_high_line = na

var line crt_low_line = na

var line crt_eq_line = na

var label crt_high_lbl = na

var label crt_low_lbl = na

var label crt_eq_lbl = na



var array<line> crt_history_lines = array.new<line>()

var array<label> crt_history_labels = array.new<label>()



var bool was_crt_active = false

var array<Lib.Imbalance> ltf_imbalances = array.new<Lib.Imbalance>()

var array<bool> ltf_imbalance_is_bull = array.new<bool>()



// Hard limit to prevent TradingView rendering crash from extremely old stale setups

if htf_auto.crt_active and (bar_index - htf_auto.crt_high_idx > 4900 or bar_index - htf_auto.crt_low_idx > 4900)

    htf_auto.crt_active := false

    trade_active := false

    htf_auto.trade_is_live := false



if htf_auto.crt_active

    // Draw CRT Levels

    line.delete(crt_high_line)

    line.delete(crt_low_line)

    line.delete(crt_eq_line)

    label.delete(crt_high_lbl)

    label.delete(crt_low_lbl)

    label.delete(crt_eq_lbl)

    

    color crt_col = htf_auto.crt_bull ? crt_bull_color : crt_bear_color

    float crt_eq_level = (htf_auto.crt_high_level + htf_auto.crt_low_level) / 2

    

    crt_high_line := line.new(htf_auto.crt_high_idx, htf_auto.crt_high_level, bar_index + 5, htf_auto.crt_high_level, color=crt_col, style=line.style_solid)

    crt_low_line := line.new(htf_auto.crt_low_idx, htf_auto.crt_low_level, bar_index + 5, htf_auto.crt_low_level, color=crt_col, style=line.style_solid)

    crt_eq_line := line.new(math.min(htf_auto.crt_high_idx, htf_auto.crt_low_idx), crt_eq_level, bar_index + 5, crt_eq_level, color=crt_col, style=line.style_dashed)

    

    string lbl_suffix = htf_auto.crt_label_text != "" ? "\n" + htf_auto.crt_label_text : ""

    crt_high_lbl := label.new(bar_index + 5, htf_auto.crt_high_level, htf_auto.crt_type + " CRT High" + lbl_suffix, style=label.style_label_left, color=color_transparent, textcolor=crt_label_color, size=i_font)

    crt_low_lbl := label.new(bar_index + 5, htf_auto.crt_low_level, htf_auto.crt_type + " CRT Low" + lbl_suffix, style=label.style_label_left, color=color_transparent, textcolor=crt_label_color, size=i_font)

    crt_eq_lbl := label.new(bar_index + 5, crt_eq_level, "50%", style=label.style_label_left, color=color_transparent, textcolor=crt_label_color, size=i_font)



    // Manage LTF CISD Persistence

    was_crt_active := true



    // LTF Features (Only if not on HTF chart)

    if timeframe.period != aligned_tf

        // --- FVG & Inversion FVG & BPR Logic ---

        float bull_fvg_top = na, float bull_fvg_bot = na

        float bear_fvg_top = na, float bear_fvg_bot = na



        // Detect FVG (Current)

        if high[2] < low and close[1] > open[1] // Bull FVG

            bull_fvg_top := low, bull_fvg_bot := high[2]

        if low[2] > high and close[1] < open[1] // Bear FVG

            bear_fvg_top := low[2], bear_fvg_bot := high

        

        // Update existing LTF FVGs (Invalidation & Extension)

        int i_inv = ltf_imbalances.size() - 1

        while i_inv >= 0

            Lib.Imbalance imb = ltf_imbalances.get(i_inv)

            box.set_right(imb.b, bar_index + 5)

            i_inv -= 1



        bool in_zone_bull = not na(bull_fvg_top) and bull_fvg_bot >= htf_auto.crt_low_level and bull_fvg_top <= htf_auto.crt_high_level

        bool in_zone_bear = not na(bear_fvg_top) and bear_fvg_bot >= htf_auto.crt_low_level and bear_fvg_top <= htf_auto.crt_high_level

        

        bool draw_bull_fvg = not na(bull_fvg_top) and settings.show_ltf_fvg and htf_auto.crt_bull and in_zone_bull

        bool draw_bear_fvg = not na(bear_fvg_top) and settings.show_ltf_fvg and not htf_auto.crt_bull and in_zone_bear



        if draw_bull_fvg

            int i = 0

            while i < ltf_imbalances.size()

                Lib.Imbalance imb = ltf_imbalances.get(i)

                bool overlap = math.max(imb.bottom, bull_fvg_bot) < math.min(imb.top, bull_fvg_top)

                if overlap

                    if (bull_fvg_top - bull_fvg_bot) > (imb.top - imb.bottom)

                        if barstate.isconfirmed

                            box.delete(imb.b)

                            ltf_imbalances.remove(i)

                            ltf_imbalance_is_bull.remove(i)

                            continue

                    else

                        draw_bull_fvg := false

                        break

                i += 1



        if draw_bear_fvg

            int i = 0

            while i < ltf_imbalances.size()

                Lib.Imbalance imb = ltf_imbalances.get(i)

                bool overlap = math.max(imb.bottom, bear_fvg_bot) < math.min(imb.top, bear_fvg_top)

                if overlap

                    if (bear_fvg_top - bear_fvg_bot) > (imb.top - imb.bottom)

                        if barstate.isconfirmed

                            box.delete(imb.b)

                            ltf_imbalances.remove(i)

                            ltf_imbalance_is_bull.remove(i)

                            continue

                    else

                        draw_bear_fvg := false

                        break

                i += 1



        // Draw Remaining

        if draw_bull_fvg

            box b = box.new(bar_index-1, bull_fvg_top, bar_index+5, bull_fvg_bot, bgcolor=color.new(color.green, 80), border_color=color_transparent)

            if barstate.isconfirmed

                ltf_imbalances.push(Lib.Imbalance.new(b, bar_index, bull_fvg_top, bull_fvg_bot))

                ltf_imbalance_is_bull.push(true)

        if draw_bear_fvg

            box b = box.new(bar_index-1, bear_fvg_top, bar_index+5, bear_fvg_bot, bgcolor=color.new(color.red, 80), border_color=color_transparent)

            if barstate.isconfirmed

                ltf_imbalances.push(Lib.Imbalance.new(b, bar_index, bear_fvg_top, bear_fvg_bot))

                ltf_imbalance_is_bull.push(false)

        

        while ltf_imbalances.size() > settings.ltf_fvg_limit

            Lib.Imbalance rem = ltf_imbalances.shift()

            box.delete(rem.b)

            ltf_imbalance_is_bull.shift()



else

    if was_crt_active

        // Cleanup levels on invalidation

        line.delete(crt_high_line)

        line.delete(crt_low_line)

        line.delete(crt_eq_line)

        label.delete(crt_high_lbl)

        label.delete(crt_low_lbl)

        label.delete(crt_eq_lbl)

        

        // Clear LTF imbalances

        while ltf_imbalances.size() > 0

            Lib.Imbalance imb = ltf_imbalances.pop()

            box.delete(imb.b)

        ltf_imbalance_is_bull.clear()



        was_crt_active := false

        

        // Update Color based on Performance

        color hist_col = htf_auto.crt_bull ? crt_bull_color : crt_bear_color



        // Deactivated, clear lines

        while ltf_imbalances.size() > 0

            Lib.Imbalance imb = ltf_imbalances.pop()

            box.delete(imb.b)

        ltf_imbalance_is_bull.clear()

        

        if settings.show_crt_history and settings.crt_history_limit > 0

            // Apply performance color to history lines

            line.set_color(crt_high_line, hist_col)

            line.set_color(crt_low_line, hist_col)

            line.set_color(crt_eq_line, hist_col)

            

            array.push(crt_history_lines, crt_high_line)

            array.push(crt_history_lines, crt_low_line)

            array.push(crt_history_lines, crt_eq_line)

            array.push(crt_history_labels, crt_high_lbl)

            array.push(crt_history_labels, crt_low_lbl)

            array.push(crt_history_labels, crt_eq_lbl)

            

            int max_hist = settings.crt_history_limit * 3

            while array.size(crt_history_lines) > max_hist

                line.delete(array.shift(crt_history_lines))

            while array.size(crt_history_labels) > max_hist

                label.delete(array.shift(crt_history_labels))

            

            crt_high_line := na

            crt_low_line := na

            crt_eq_line := na

            crt_high_lbl := na

            crt_low_lbl := na

            crt_eq_lbl := na

        else

            line.delete(crt_high_line)

            line.delete(crt_low_line)

            line.delete(crt_eq_line)

            label.delete(crt_high_lbl)

            label.delete(crt_low_lbl)

            label.delete(crt_eq_lbl)

            

            crt_high_line := na

            crt_low_line := na

            crt_eq_line := na

            crt_high_lbl := na

            crt_low_lbl := na

            crt_eq_lbl := na

            

            while array.size(crt_history_lines) > 0

                line.delete(array.pop(crt_history_lines))

            while array.size(crt_history_labels) > 0

                label.delete(array.pop(crt_history_labels))

    was_crt_active := false



//+------------------------------------------------------------------------------------------------------------+//

//+--- CISD Logic (Merged)                                                                                  ---+//

//+------------------------------------------------------------------------------------------------------------+//



// --- Internal Variables ---

var float h0 = high

var float l0 = low

var int h0bar = bar_index

var int l0bar = bar_index

var line ln1 = line.new(na, na, na, na)

var line ln2 = line.new(na, na, na, na)

var label lbl1 = label.new(na, na, na)

var label lbl2 = label.new(na, na, na)

var line last_confirmed_bear_line = na

var line last_confirmed_bull_line = na

var label last_confirmed_bear_label = na

var label last_confirmed_bull_label = na

var array<line> cisd_lines = array.new<line>()

var array<label> cisd_labels = array.new<label>()



// --- Helper Logic ---

cisd_up = close > open

cisd_dw = close < open

cisd_eq = close == open



// --- Track Highs and Lows ---

if high >= h0

    h0    := high

    h0bar := bar_index



if low <= l0

    l0     := low

    l0bar  := bar_index



// --- Bearish CISD Logic ---

if (close < be_csd and barstate.isconfirmed and bar_index != h0bar and high < h0) or (close[1] < be_csd[1] and h0 == high[1] and bar_index - h0bar == 1)

    l0     := low

    l0bar  := bar_index

    be_csd := 0.0

    

    dg = (close[1] < be_csd[1] and h0 == high[1] and bar_index - h0bar == 1) ? 1 : 0

    start_x = line.get_x1(ln1)

    safe_x = na(start_x) ? bar_index : math.max(bar_index - 500, start_x)

    

    if show_cisd

        last_confirmed_bear_line := line.new(safe_x, line.get_y1(ln1), bar_index - dg, line.get_y1(ln1), color=cisd_bear_color, width=1)

        last_confirmed_bear_label := label.new(int(math.avg(safe_x, bar_index - dg)), line.get_y1(ln1), show_cisd_lbl ? "-CISD" : "", color=color.new(color.white, 100), textcolor=show_cisd_lbl ? cisd_bear_color : color.new(color.white, 100), style=label.style_label_up, size=cisdSize)

        array.push(cisd_lines, last_confirmed_bear_line)

        array.push(cisd_labels, last_confirmed_bear_label)

        if array.size(cisd_lines) > cisd_history_limit

            line.delete(array.shift(cisd_lines))

            label.delete(array.shift(cisd_labels))

    

    line.delete(ln1)

    label.delete(lbl1)



// --- Bullish CISD Logic ---

if (close > bu_csd and barstate.isconfirmed and bar_index != l0bar and low > l0) or (close[1] > bu_csd[1] and l0 == low[1] and bar_index - l0bar == 1)

    h0     := high

    h0bar  := bar_index

    bu_csd := 1.0e12

    

    df = (close[1] > bu_csd[1] and l0 == low[1] and bar_index - l0bar == 1) ? 1 : 0

    start_x = line.get_x1(ln2)

    safe_x = na(start_x) ? bar_index : math.max(bar_index - 500, start_x)

    

    if show_cisd

        last_confirmed_bull_line := line.new(safe_x, line.get_y1(ln2), bar_index - df, line.get_y1(ln2), color=cisd_bull_color, width=1)

        last_confirmed_bull_label := label.new(int(math.avg(safe_x, bar_index - df)), line.get_y1(ln2), show_cisd_lbl ? "+CISD" : "", color=color.new(color.white, 100), textcolor=show_cisd_lbl ? cisd_bull_color : color.new(color.white, 100), style=label.style_label_down, size=cisdSize)

        array.push(cisd_lines, last_confirmed_bull_line)

        array.push(cisd_labels, last_confirmed_bull_label)

        if array.size(cisd_lines) > cisd_history_limit

            line.delete(array.shift(cisd_lines))

            label.delete(array.shift(cisd_labels))

    

    line.delete(ln2)

    label.delete(lbl2)



// --- Identify State of Delivery (The Levels) ---

if high == h0

    int lookback = math.min(bar_index, 10 + int(ta.atr(14) / syminfo.mintick / 100))

    float series_level = 1.0e20

    bool series_found = false

    int bx = 0

    for i = 0 to lookback

        if cisd_up[i]

            float val = usebody_for_confirmation ? math.min(open[i], close[i]) : low[i]

            if val < series_level or not series_found

                series_level := val

            series_found := true

            bx := i

        else if series_found

            break

    

    if series_found

        be_csd := series_level

        line.delete(ln1)

        label.delete(lbl1)

        if show_cisd

            ln1 := line.new(bar_index - bx, be_csd, bar_index + 1, be_csd, color=cisd_bear_color, style=line.style_dashed, width=1)

            lbl1 := label.new(bar_index + 1, be_csd, show_cisd_lbl ? "-CISD" : "", color=color.new(color.white, 100), textcolor=show_cisd_lbl ? cisd_bear_color : color.new(color.white, 100), style=label.style_label_up, size=cisdSize)



if h0[1] == h0 and be_csd != 0.0 and show_cisd

    line.set_x2(ln1, bar_index)

    label.set_x(lbl1, bar_index)



if low == l0

    int lookback = math.min(bar_index, 10 + int(ta.atr(14) / syminfo.mintick / 100))

    float series_level = -1.0e20

    bool series_found = false

    int bz = 0

    for i = 0 to lookback

        if cisd_dw[i]

            float val = usebody_for_confirmation ? math.max(open[i], close[i]) : high[i]

            if val > series_level or not series_found

                series_level := val

            series_found := true

            bz := i

        else if series_found

            break

            

    if series_found

        bu_csd := series_level

        line.delete(ln2)

        label.delete(lbl2)

        if show_cisd

            ln2 := line.new(bar_index - bz, bu_csd, bar_index + 1, bu_csd, color=cisd_bull_color, style=line.style_dashed, width=1)

            lbl2 := label.new(bar_index + 1, bu_csd, show_cisd_lbl ? "+CISD" : "", color=color.new(color.white, 100), textcolor=show_cisd_lbl ? cisd_bull_color : color.new(color.white, 100), style=label.style_label_down, size=cisdSize)



if l0[1] == l0 and bu_csd != 1.0e12 and show_cisd

    line.set_x2(ln2, bar_index)

    label.set_x(lbl2, bar_index)



//+------------------------------------------------------------------------------------------------------------+//

//+--- Alerts Logic                                                                                         ---+//

//+------------------------------------------------------------------------------------------------------------+//



//+------------------------------------------------------------------------------------------------------------+//

//+--- BIAS TABLE LOGIC (STICKY BIAS)                                                                       ---+//

//+------------------------------------------------------------------------------------------------------------+//



// --- 4. Table Drawing ---



grp_tbl = "CRT-Algo Bias Table"

show_bias_tbl = input.bool(true, "Show Bias Table", group=grp_tbl)

bias_tbl_tf = input.string("All", "Bias Timeframes", options=["All", "1H", "4H", "1D", "1W"], group=grp_tbl)

bias_tbl_pos_input = input.string("Bottom Right", "Position", options=["Top Right", "Middle Right", "Bottom Right", "Top Center", "Middle Center", "Bottom Center", "Top Left", "Middle Left", "Bottom Left"], group=grp_tbl)

bias_tbl_size = input.string(size.small, "Size", options=[size.tiny, size.small, size.normal, size.large, size.huge], group=grp_tbl)

bias_tbl_bg = input.color(color.black, "Background Color", group=grp_tbl)



bias_tbl_pos = bias_tbl_pos_input == "Top Right" ? position.top_right : bias_tbl_pos_input == "Middle Right" ? position.middle_right : bias_tbl_pos_input == "Bottom Right" ? position.bottom_right : bias_tbl_pos_input == "Top Center" ? position.top_center : bias_tbl_pos_input == "Middle Center" ? position.middle_center : bias_tbl_pos_input == "Bottom Center" ? position.bottom_center : bias_tbl_pos_input == "Top Left" ? position.top_left : bias_tbl_pos_input == "Middle Left" ? position.middle_left : position.bottom_left



f_draw_simple_row(table tbl, int row, string label_txt, string val_txt, color bg_color, color val_color, string sz) =>

    table.cell(tbl, 0, row, label_txt, bgcolor=bg_color, text_color=color.white, text_size=sz)

    table.cell(tbl, 1, row, val_txt, bgcolor=bg_color, text_color=val_color, text_size=sz)



int tbl_rows = (bias_tbl_tf == "All" ? 4 : 1) + 17 // Adjusted after removing PnL metrics

var table bias_tbl = table.new(bias_tbl_pos, 2, tbl_rows, border_width=1, border_color=color.gray)



f_fill_row(table t, int r, string tf, string stb) =>

    

    // Bias gradient

    color c_base = stb == "Bullish" ? color.green : stb == "Bearish" ? color.red : color.gray

    color c_stb = color.from_gradient(r, 1, 5, color.new(c_base, 30), color.new(c_base, 60))

    

    table.cell(t, 0, r, tf, text_color=color.white, bgcolor=bias_tbl_bg, text_size=bias_tbl_size)

    table.cell(t, 1, r, stb, text_color=color.white, bgcolor=c_stb, text_size=bias_tbl_size)



// --- Metrics Calculation ---

float current_entry_ref = trade_active ? active_be : htf_auto.crt_entry_level

float current_sl_ref    = trade_active ? (tp1_hit ? active_be : active_sl) : (htf_auto.crt_bull ? htf_auto.crt_stop_level - atr_14 * 0.25 : htf_auto.crt_stop_level + atr_14 * 0.25)

float initial_risk      = math.abs(current_entry_ref - (trade_active ? active_sl : current_sl_ref)) 



float live_r_val = htf_auto.crt_active and initial_risk > 0 ? (trade_active ? (active_side == "BULL" ? 1 : -1) : (htf_auto.crt_bull ? 1 : -1)) * (close - current_entry_ref) / initial_risk : 0.0

float pnl_clr_val = live_r_val >= 0 ? 1.0 : -1.0 // Simple helper for coloring RR

color pnl_clr = pnl_clr_val >= 0 ? color.lime : color.red



if barstate.islast and show_bias_tbl

    // Header

    table.cell(bias_tbl, 0, 0, "Timeframe", bgcolor=bias_tbl_bg, text_color=color.white, text_size=bias_tbl_size)

    table.cell(bias_tbl, 1, 0, "Bias", bgcolor=bias_tbl_bg, text_color=color.white, text_size=bias_tbl_size)

    

    int row_ptr = 1

    if bias_tbl_tf == "All"

        f_fill_row(bias_tbl, row_ptr, "1H", r1_stb), row_ptr += 1

        f_fill_row(bias_tbl, row_ptr, "4H", r2_stb), row_ptr += 1

        f_fill_row(bias_tbl, row_ptr, "1D", r3_stb), row_ptr += 1

        f_fill_row(bias_tbl, row_ptr, "1W", r4_stb), row_ptr += 1

    else if bias_tbl_tf == "1H"

        f_fill_row(bias_tbl, row_ptr, "1H", r1_stb), row_ptr += 1

    else if bias_tbl_tf == "4H"

        f_fill_row(bias_tbl, row_ptr, "4H", r2_stb), row_ptr += 1

    else if bias_tbl_tf == "1D"

        f_fill_row(bias_tbl, row_ptr, "1D", r3_stb), row_ptr += 1

    else if bias_tbl_tf == "1W"

        f_fill_row(bias_tbl, row_ptr, "1W", r4_stb), row_ptr += 1



    // Divider

    bool show_trade_info = htf_auto.crt_active

    string trade_title = trade_active ? "--- Active Trade ---" : (htf_auto.crt_active ? "--- Active Setup ---" : "--- Pending Setup ---")

    string trade_side = trade_active ? active_side : (htf_auto.crt_bull ? "BULL" : "BEAR")

    

    table.cell(bias_tbl, 0, row_ptr, trade_title, bgcolor=bias_tbl_bg, text_color=color.yellow, text_size=bias_tbl_size)

    table.cell(bias_tbl, 1, row_ptr, show_trade_info ? trade_side : "FLAT", bgcolor=bias_tbl_bg, text_color=color.gray, text_size=bias_tbl_size)

    row_ptr += 1



    float disp_be = trade_active ? active_be : htf_auto.crt_entry_level

    float disp_sl = trade_active ? (tp1_hit ? active_be : active_sl) : (htf_auto.crt_bull ? htf_auto.crt_stop_level - atr_14 * 0.25 : htf_auto.crt_stop_level + atr_14 * 0.25)

    float disp_tp1 = trade_active ? active_tp1 : eq_crt

    float disp_tp2 = trade_active ? active_tp2 : (htf_auto.crt_bull ? htf_auto.crt_high_level : htf_auto.crt_low_level)



    f_draw_simple_row(bias_tbl, row_ptr, "Entry:", show_trade_info ? str.tostring(disp_be, format.mintick) : "-", bias_tbl_bg, color.white, bias_tbl_size)

    row_ptr += 1



    f_draw_simple_row(bias_tbl, row_ptr, "Active Stop Loss:", show_trade_info ? str.tostring(disp_sl, format.mintick) : "-", bias_tbl_bg, trade_active ? color.red : color.white, bias_tbl_size)

    row_ptr += 1



    f_draw_simple_row(bias_tbl, row_ptr, "TP1 (EQ / 50%):", show_trade_info ? str.tostring(disp_tp1, format.mintick) : "-", bias_tbl_bg, trade_active ? (tp1_hit ? color.lime : color.yellow) : color.white, bias_tbl_size)

    row_ptr += 1



    f_draw_simple_row(bias_tbl, row_ptr, "TP2 (Final / 100%):", show_trade_info ? str.tostring(disp_tp2, format.mintick) : "-", bias_tbl_bg, trade_active ? color.lime : color.white, bias_tbl_size)

    row_ptr += 1



    // RR Metrics

    float init_r = math.abs(disp_be - disp_sl)

    float exp_rr = show_trade_info and init_r > 0 ? math.abs(disp_tp2 - disp_be) / init_r : 0.0

    f_draw_simple_row(bias_tbl, row_ptr, "Expected RR:", show_trade_info ? str.tostring(exp_rr, "0.00") + "R" : "-", bias_tbl_bg, color.white, bias_tbl_size)

    row_ptr += 1



    f_draw_simple_row(bias_tbl, row_ptr, "Live RR:", htf_auto.crt_active ? (live_r_val >= 0 ? "+" : "") + str.tostring(live_r_val, "0.00") + "R" : "-", bias_tbl_bg, pnl_clr, bias_tbl_size)

    row_ptr += 1



    // --- Original Setup Grade Rows ---

    f_draw_simple_row(bias_tbl, row_ptr, "OTE Status", htf_auto.crt_active ? fixed_ote_txt : "N/A", bias_tbl_bg, color.white, bias_tbl_size)

    row_ptr += 1



    f_draw_simple_row(bias_tbl, row_ptr, "HTF Alignment", htf_auto.crt_active ? (fixed_align ? "✅ Aligned" : "⚠️ Counter") : "-", bias_tbl_bg, color.white, bias_tbl_size)

    row_ptr += 1



    f_draw_simple_row(bias_tbl, row_ptr, "Sweep Quality", htf_auto.crt_active ? (htf_auto.crt_sweep_quality ? "✅ High" : "⚠️ Normal") : "-", bias_tbl_bg, color.white, bias_tbl_size)

    row_ptr += 1



    f_draw_simple_row(bias_tbl, row_ptr, "Volume Conf", htf_auto.crt_active ? (htf_auto.crt_vol_quality ? "✅ Confirmed" : "⚠️ Average") : "-", bias_tbl_bg, color.white, bias_tbl_size)

    row_ptr += 1



    f_draw_simple_row(bias_tbl, row_ptr, "CRT Setup Grade", htf_auto.crt_active ? str.repeat("⭐", fixed_score) : "Scanning...", bias_tbl_bg, color.white, bias_tbl_size)

    row_ptr += 1



    f_draw_simple_row(bias_tbl, row_ptr, "CRT Setup Reason", htf_auto.crt_active ? fixed_notes : "-", bias_tbl_bg, color.gray, bias_tbl_size)

    row_ptr += 1



    // 1. Get Dynamic Cycle Data

    [cycle_name, cycle_perc, phase_name] = Lib.f_get_qt_data(minsFromDayStart)



    // 2. Add Cycle Progress Row

    table.cell(bias_tbl, 0, row_ptr, cycle_name, bgcolor=bias_tbl_bg, text_color=color.white, text_size=bias_tbl_size)

    table.cell(bias_tbl, 1, row_ptr, Lib.f_render_bar(cycle_perc), bgcolor=bias_tbl_bg, text_color=color.white, text_size=bias_tbl_size)

    row_ptr += 1



    // 3. Add Phase Row (A, M, D, X)

    table.cell(bias_tbl, 0, row_ptr, "Cycle Phase", bgcolor=bias_tbl_bg, text_color=color.white, text_size=bias_tbl_size)

    table.cell(bias_tbl, 1, row_ptr, phase_name, bgcolor=bias_tbl_bg, text_color=color.white, text_size=bias_tbl_size)

    row_ptr += 1

// =======================================================================

// ADDITIONAL SFP MODULE

// =======================================================================

grp_sfp_mod = "══ Swing Failure Pattern (SFP) Extension ══"

sfp_showSFP = input.bool(true, "Show SFP Markings", group=grp_sfp_mod)

sfp_len = input.int(5, "SFP Swings Lookback", minval=1, group=grp_sfp_mod)

sfp_showSFPFib = input.bool(true, "Show SFP Fib Levels", group=grp_sfp_mod)

sfp_showTable = input.bool(true, "Show SFP Table", group=grp_sfp_mod)

enableMTFEntry = input.bool(true, "Enable SFP MTF Singles Table (Combined)", group=grp_sfp_mod)

sfp_tablePos = input.string("Bottom Left", "SFP Table Position", options=["Top Left", "Top Right", "Bottom Left", "Bottom Right", "Middle Left", "Middle Right"], group=grp_sfp_mod)



// UDT for SFP

type sfp_pivotData

    float swingPrice

    int swingBar

    float oppPrice

    int oppBar

    bool active

    bool confirmed

    line swingLine

    line oppLine

    line wickLine

    label wickLabel

    line[] fibLines

    label[] fibLabels

    float sfpPrice



// Pivot instances

var sfp_pivotData sfp_bearPivot = sfp_pivotData.new(na, na, na, na, false, false, na, na, na, na, array.new_line(), array.new_label(), na)

var sfp_pivotData sfp_bullPivot = sfp_pivotData.new(na, na, na, na, false, false, na, na, na, na, array.new_line(), array.new_label(), na)



type sfp_context

    int highSwing_barIndex

    float highSwing_price

    int lowSwing_barIndex

    float lowSwing_price

    bool ts_active

    string ts_side

    float ts_entryPrice

    float ts_slPrice

    float ts_tp_2rr

    float ts_tp_2_5

    float ts_tp_4

    float ts_tp_4_5

    bool ts_tp_2rr_hit

    bool ts_tp_2_5_hit

    bool ts_tp_4_hit

    bool ts_tp_4_5_hit

    bool ts_bear_confirmed_state

    bool ts_bull_confirmed_state

    bool ts_hist_tp_2rr_hit

    bool ts_hist_tp_2_5_hit

    bool ts_hist_tp_4_hit

    bool ts_hist_tp_4_5_hit

    int ts_bear_stars

    string ts_bear_notes

    int ts_bull_stars

    string ts_bull_notes



var sfp_context ctx = sfp_context.new(na, na, na, na, false, "", na, na, na, na, na, na, false, false, false, false, false, false, false, false, false, false, 0, "", 0, "")



sfp_INV = color.new(color.white, 100)

sfp_sfpHigh = ta.pivothigh(sfp_len, 1)

sfp_sfpLow = ta.pivotlow(sfp_len, 1)



// Helper Functions

f_clean_array(line[] lines, label[] labels) =>

    if not na(lines)

        while array.size(lines) > 0

            line.delete(array.pop(lines))

    if not na(labels)

        while array.size(labels) > 0

            label.delete(array.pop(labels))



f_clean_pivot(sfp_pivotData p) =>

    line.delete(p.swingLine)

    line.delete(p.oppLine)

    line.delete(p.wickLine)

    label.delete(p.wickLabel)

    f_clean_array(p.fibLines, p.fibLabels)



f_create_sfp_visuals(sfp_pivotData p, bool isBull, color col, color wickCol) =>

    p.swingLine := line.new(p.swingBar, p.swingPrice, bar_index, p.swingPrice, color=col)

    p.oppLine := line.new(p.oppBar, p.oppPrice, bar_index, p.oppPrice, color=col, style=line.style_dotted)

    p.wickLine := line.new(bar_index, p.sfpPrice, bar_index, p.swingPrice, color=wickCol, width=3)

    p.wickLabel := label.new(bar_index, p.sfpPrice, style=isBull ? label.style_label_up : label.style_label_down, text='SFP', textcolor=col, color=color.new(color.white, 100))



f_update_lines(sfp_pivotData p) =>

    if not na(p.swingLine)

        p.swingLine.set_x2(bar_index)

    if not na(p.oppLine)

        p.oppLine.set_x2(bar_index)



f_draw_fibs(int startBar, float oppPrice, float sfpPrice, bool isBull, line[] lines, label[] labels) =>

    if sfp_showSFPFib

        rng = math.abs(oppPrice - sfpPrice)

        for lvl in array.from(1.0, 0.0, -1.0, -2.0, -2.5, -3.0, -4.0, -4.5)

            fibPrice = isBull ? oppPrice - lvl * rng : oppPrice + lvl * rng

            array.push(lines, line.new(startBar, fibPrice, bar_index + 10, fibPrice, color=color.rgb(12, 50, 153), style=line.style_dotted))

            array.push(labels, label.new(bar_index + 10, fibPrice, text=" " + str.tostring(lvl), style=label.style_label_left, textcolor=color.rgb(12, 50, 153), color=color.new(color.white, 100), size=size.small))



f_execute_sfp_detection(sfp_context ctx, sfp_pivotData sfp_bearPivot, sfp_pivotData sfp_bullPivot) =>

    float swingPrice = na

    int swingBar = na

    float oppPrice = na

    int oppBar = na

    

    if sfp_showSFP

        // Bearish SFP

        if not na(sfp_sfpHigh)

            ctx.highSwing_barIndex := bar_index - 1

            ctx.highSwing_price := sfp_sfpHigh

        

        swingPrice := ctx.highSwing_price

        swingBar := ctx.highSwing_barIndex

        

        if close < swingPrice and open < swingPrice and high > swingPrice

            oppPrice := swingPrice

            oppBar := bar_index

            for counter = 1 to bar_index - swingBar - 1

                if low[counter] < oppPrice

                    oppPrice := low[counter]

                    oppBar := bar_index - counter

            

            if not sfp_bearPivot.confirmed

                f_clean_pivot(sfp_bearPivot)

            else

                f_clean_array(sfp_bearPivot.fibLines, sfp_bearPivot.fibLabels)

            

            sfp_bearPivot.swingPrice := swingPrice

            sfp_bearPivot.swingBar := swingBar

            sfp_bearPivot.oppPrice := oppPrice

            sfp_bearPivot.oppBar := oppBar

            sfp_bearPivot.active := true

            sfp_bearPivot.confirmed := false

            sfp_bearPivot.sfpPrice := high

            f_create_sfp_visuals(sfp_bearPivot, false, crt_bear_color, color.new(crt_bear_color, 50))

        

        if sfp_bearPivot.active

            if not sfp_bearPivot.confirmed

                f_update_lines(sfp_bearPivot)

            if not sfp_bearPivot.confirmed and close < sfp_bearPivot.oppPrice

                sfp_bearPivot.confirmed := true

                if not na(sfp_bearPivot.wickLabel) and sfp_bearPivot.wickLabel.get_x() == bar_index

                    sfp_bearPivot.wickLabel.set_text('SFP\n▼')

                else

                    label.new(bar_index, high, style=label.style_label_down, text='▼', textcolor=crt_bear_color, color=color.new(color.white, 100), size=size.normal)

                f_draw_fibs(sfp_bearPivot.swingBar, sfp_bearPivot.oppPrice, sfp_bearPivot.sfpPrice, false, sfp_bearPivot.fibLines, sfp_bearPivot.fibLabels)

        

        if bar_index - sfp_bearPivot.swingBar > 500 or close > sfp_bearPivot.swingPrice

            sfp_bearPivot.active := false

            if not sfp_bearPivot.confirmed

                f_clean_pivot(sfp_bearPivot)



        // Bullish SFP

        if not na(sfp_sfpLow)

            ctx.lowSwing_barIndex := bar_index - 1

            ctx.lowSwing_price := sfp_sfpLow

        

        swingPrice := ctx.lowSwing_price

        swingBar := ctx.lowSwing_barIndex

        

        if close > swingPrice and open > swingPrice and low < swingPrice

            oppPrice := swingPrice

            oppBar := bar_index

            for counter = 1 to bar_index - swingBar - 1

                if high[counter] > oppPrice

                    oppPrice := high[counter]

                    oppBar := bar_index - counter

            

            if not sfp_bullPivot.confirmed

                f_clean_pivot(sfp_bullPivot)

            else

                f_clean_array(sfp_bullPivot.fibLines, sfp_bullPivot.fibLabels)

            

            sfp_bullPivot.swingPrice := swingPrice

            sfp_bullPivot.swingBar := swingBar

            sfp_bullPivot.oppPrice := oppPrice

            sfp_bullPivot.oppBar := oppBar

            sfp_bullPivot.active := true

            sfp_bullPivot.confirmed := false

            sfp_bullPivot.sfpPrice := low

            f_create_sfp_visuals(sfp_bullPivot, true, crt_bull_color, color.new(crt_bull_color, 50))

        

        if sfp_bullPivot.active

            if not sfp_bullPivot.confirmed

                f_update_lines(sfp_bullPivot)

            if not sfp_bullPivot.confirmed and close > sfp_bullPivot.oppPrice

                sfp_bullPivot.confirmed := true

                if not na(sfp_bullPivot.wickLabel) and sfp_bullPivot.wickLabel.get_x() == bar_index

                    sfp_bullPivot.wickLabel.set_text('▲\nSFP')

                else

                    label.new(bar_index, low, style=label.style_label_up, text='▲', textcolor=crt_bull_color, color=color.new(color.white, 100), size=size.normal)

                f_draw_fibs(sfp_bullPivot.swingBar, sfp_bullPivot.oppPrice, sfp_bullPivot.sfpPrice, true, sfp_bullPivot.fibLines, sfp_bullPivot.fibLabels)

        

        if bar_index - sfp_bullPivot.swingBar > 500 or close < sfp_bullPivot.swingPrice

            sfp_bullPivot.active := false

            if not sfp_bullPivot.confirmed

                f_clean_pivot(sfp_bullPivot)



// SFP Rating Calculation

f_sfp_setup_rating(bool is_bull, bool at_poi) =>

    int pts = 0

    string n = ""

    is_b = (is_bull and current_main_bias == "Bullish") or (not is_bull and current_main_bias == "Bearish")

    pts += is_b ? 2 : 0

    if is_b

        n += "Bias "

    if at_poi

        pts += 2

        n += "POI "

    s_ali = (is_bull and ssmt_bull_active) or (not is_bull and ssmt_bear_active)

    s_opp = (is_bull and ssmt_bear_active and not ssmt_bull_active) or (not is_bull and ssmt_bull_active and not ssmt_bear_active)

    if s_ali

        pts += 2

        n += "SMT "

    if s_opp

        pts -= 2

        n += "!SMT "

    h_ali = (is_bull and active_htf_bias == "Bullish") or (not is_bull and active_htf_bias == "Bearish")

    if h_ali

        pts += 2

        n += "HTF "

    if Lib.f_is_killzone()

        pts += 1

        n += "KZ "

    dow_ok = dayofweek == dayofweek.tuesday or dayofweek == dayofweek.wednesday

    if dow_ok

        pts += 1

        n += "DOW "

    

    stars = pts >= 8 ? 5 : pts >= 6 ? 4 : pts >= 4 ? 3 : pts >= 2 ? 2 : pts >= 1 ? 1 : 0

    [stars, n]



// Fetch SFP POI Rejection Checks (Fixed: Low/High sweep range checked to detect wick penetrations)

[sfp_bull_at_poi, sfp_bull_poi_reason] = if sfp_bullPivot.active

    htf_auto.check_poi_rejection(sfp_bullPivot.sfpPrice, sfp_bullPivot.swingPrice, true)

else

    [false, ""]



[sfp_bear_at_poi, sfp_bear_poi_reason] = if sfp_bearPivot.active

    htf_auto.check_poi_rejection(sfp_bearPivot.swingPrice, sfp_bearPivot.sfpPrice, false)

else

    [false, ""]



[sfp_bull_stars, sfp_bull_notes] = f_sfp_setup_rating(true, sfp_bull_at_poi)

[sfp_bear_stars, sfp_bear_notes] = f_sfp_setup_rating(false, sfp_bear_at_poi)



// Sticky Scoring logic (Locking Grade and Confluences at time of formation)

var bool prev_bear_active = false

var bool prev_bull_active = false



is_new_bear = sfp_bearPivot.active and not prev_bear_active

prev_bear_active := sfp_bearPivot.active



if sfp_bearPivot.active or ctx.ts_active

    if is_new_bear or sfp_bear_stars > ctx.ts_bear_stars

        ctx.ts_bear_stars := sfp_bear_stars

        ctx.ts_bear_notes := sfp_bear_notes

else

    ctx.ts_bear_stars := 0

    ctx.ts_bear_notes := ""



is_new_bull = sfp_bullPivot.active and not prev_bull_active

prev_bull_active := sfp_bullPivot.active



if sfp_bullPivot.active or ctx.ts_active

    if is_new_bull or sfp_bull_stars > ctx.ts_bull_stars

        ctx.ts_bull_stars := sfp_bull_stars

        ctx.ts_bull_notes := sfp_bull_notes

else

    ctx.ts_bull_stars := 0

    ctx.ts_bull_notes := ""



f_get_stars(int count) =>

    count == 5 ? "⭐⭐⭐⭐⭐" : count == 4 ? "⭐⭐⭐⭐" : count == 3 ? "⭐⭐⭐" : count == 2 ? "⭐⭐" : count == 1 ? "⭐" : ""



f_send_sfp_entry_alert(bool is_bull, float entry_price, float stop_loss, float tp1, float tp2, float tp3, float tp4, int alert_score, string confl_notes) =>

    string grade_stars = f_get_stars(alert_score)

    string grade_text = alert_score >= 5 ? "A++" : alert_score == 4 ? "A+" : alert_score == 3 ? "Good" : "Normal"

    string clean_notes_safe = str.replace_all(str.replace_all(str.replace_all(confl_notes, "\\", "\\\\"), '"', ""), "\\n", " ")

    

    string side_emo = is_bull ? "🟢 BULLISH" : "🔴 BEARISH"

    string full_msg = "━━━━━━━━━━━━━━\n" + 

         side_emo + " SFP SETUP | " + syminfo.ticker + "\n" + 

         "━━━━━━━━━━━━━━\n" + 

         "📊 **Grade:** " + grade_stars + " (" + grade_text + ")\n" + 

         "🕒 **Phase:** " + alert_phase + "\n" + 

         "📥 **Entry:** " + str.tostring(entry_price, format.mintick) + "\n" +

         "🛡️ **Stop Loss:** " + str.tostring(stop_loss, format.mintick) + "\n" +

         "🎯 **TP 1 (2RR):** " + str.tostring(tp1, format.mintick) + "\n" +

         "🎯 **TP 2 (2.5RR):** " + str.tostring(tp2, format.mintick) + "\n" +

         "🎯 **TP 3 (4RR):** " + str.tostring(tp3, format.mintick) + "\n" +

         "🚀 **TP 4 (4.5RR):** " + str.tostring(tp4, format.mintick) + "\n" + 

         "⚖️ **R:R Ratio:** 4.50\n" + 

         "━━━━━━━━━━━━━━\n" + 

         "📝 Confluences: " + clean_notes_safe



    string clean_msg = str.replace_all(full_msg, '"', "")

    string trade_action = is_bull ? "buy" : "sell"

    

    string payload = '{' + auth_key + 

          '"type": "SFP_ENTRY", ' +

          '"action": "' + trade_action + '", ' +

          '"symbol": "' + syminfo.ticker + '", ' +

          '"price": "' + str.tostring(entry_price, format.mintick) + '", ' +

          '"sl": "' + str.tostring(stop_loss, format.mintick) + '", ' +

          '"tp": "' + str.tostring(tp1, format.mintick) + '", ' +

          '"tp2": "' + str.tostring(tp2, format.mintick) + '", ' +

          '"tp3": "' + str.tostring(tp3, format.mintick) + '", ' +

          '"tp4": "' + str.tostring(tp4, format.mintick) + '", ' +

          '"rr": "4.50", ' +

          '"tf": "' + timeframe.period + '", ' +

          '"grade": "' + grade_stars + ' (' + grade_text + ')", ' +

          '"phase": "' + alert_phase + '", ' +

          '"confluences": "' + clean_notes_safe + '", ' +

          '"content": "' + clean_msg + '"}'

          

    alert(payload, alert.freq_once_per_bar)



f_send_sfp_exit_alert(string status, string side, string content) =>

    string payload = '{' + auth_key + 

         '"type": "SFP_EXIT", "status": "' + status + '", "symbol": "' + syminfo.ticker + '", ' +

         '"side": "' + side + '", ' +

         '"content": "' + content + '"}'

    alert(payload, alert.freq_once_per_bar)



f_execute_sfp_trade_tracking(sfp_context ctx, sfp_pivotData sfp_bearPivot, sfp_pivotData sfp_bullPivot) =>

    bear_trig = sfp_bearPivot.confirmed and not ctx.ts_bear_confirmed_state

    bull_trig = sfp_bullPivot.confirmed and not ctx.ts_bull_confirmed_state



    if bull_trig

        sfp_bearPivot.confirmed := false

        sfp_bearPivot.active := false

        f_clean_pivot(sfp_bearPivot)

        risk = sfp_bullPivot.oppPrice - sfp_bullPivot.sfpPrice

        ctx.ts_tp_2rr := sfp_bullPivot.oppPrice + 2.0 * risk

        ctx.ts_tp_2_5 := sfp_bullPivot.oppPrice + 2.5 * risk

        ctx.ts_tp_4 := sfp_bullPivot.oppPrice + 4.0 * risk

        ctx.ts_tp_4_5 := sfp_bullPivot.oppPrice + 4.5 * risk

        

    if bear_trig

        sfp_bullPivot.confirmed := false

        sfp_bullPivot.active := false

        f_clean_pivot(sfp_bullPivot)

        risk = sfp_bearPivot.sfpPrice - sfp_bearPivot.oppPrice

        ctx.ts_tp_2rr := sfp_bearPivot.oppPrice - 2.0 * risk

        ctx.ts_tp_2_5 := sfp_bearPivot.oppPrice - 2.5 * risk

        ctx.ts_tp_4 := sfp_bearPivot.oppPrice - 4.0 * risk

        ctx.ts_tp_4_5 := sfp_bearPivot.oppPrice - 4.5 * risk



    if barstate.isconfirmed

        ctx.ts_bear_confirmed_state := sfp_bearPivot.confirmed

        ctx.ts_bull_confirmed_state := sfp_bullPivot.confirmed



    if bear_trig and barstate.isconfirmed

        ctx.ts_active := true

        ctx.ts_side := "BEAR"

        ctx.ts_entryPrice := sfp_bearPivot.oppPrice

        ctx.ts_slPrice := sfp_bearPivot.sfpPrice

        ctx.ts_tp_2rr_hit := false

        ctx.ts_tp_2_5_hit := false

        ctx.ts_tp_4_hit := false

        ctx.ts_tp_4_5_hit := false

        

        f_send_sfp_entry_alert(false, ctx.ts_entryPrice, ctx.ts_slPrice, ctx.ts_tp_2rr, ctx.ts_tp_2_5, ctx.ts_tp_4, ctx.ts_tp_4_5, ctx.ts_bear_stars, ctx.ts_bear_notes)



    if bull_trig and barstate.isconfirmed

        ctx.ts_active := true

        ctx.ts_side := "BULL"

        ctx.ts_entryPrice := sfp_bullPivot.oppPrice

        ctx.ts_slPrice := sfp_bullPivot.sfpPrice

        ctx.ts_tp_2rr_hit := false

        ctx.ts_tp_2_5_hit := false

        ctx.ts_tp_4_hit := false

        ctx.ts_tp_4_5_hit := false

        

        f_send_sfp_entry_alert(true, ctx.ts_entryPrice, ctx.ts_slPrice, ctx.ts_tp_2rr, ctx.ts_tp_2_5, ctx.ts_tp_4, ctx.ts_tp_4_5, ctx.ts_bull_stars, ctx.ts_bull_notes)



    if ctx.ts_active

        if ctx.ts_side == "BEAR"

            if not ctx.ts_tp_2rr_hit and low <= ctx.ts_tp_2rr

                ctx.ts_tp_2rr_hit := true

                ctx.ts_slPrice := ctx.ts_entryPrice

                f_send_sfp_exit_alert("TP1", "BEAR", "🎯 **TP1 HIT: SFP BEAR | SL Moved to BE**")

            

            if not ctx.ts_tp_2_5_hit and low <= ctx.ts_tp_2_5

                ctx.ts_tp_2_5_hit := true

                f_send_sfp_exit_alert("TP2", "BEAR", "🎯 **TP2 HIT: SFP BEAR**")

            

            if not ctx.ts_tp_4_hit and low <= ctx.ts_tp_4

                ctx.ts_tp_4_hit := true

                f_send_sfp_exit_alert("TP3", "BEAR", "🎯 **TP3 (4RR) HIT: SFP BEAR**")

                

            if not ctx.ts_tp_4_5_hit and low <= ctx.ts_tp_4_5

                ctx.ts_tp_4_5_hit := true

                ctx.ts_active := false

                sfp_bearPivot.confirmed := false

                sfp_bearPivot.active := false

                f_clean_pivot(sfp_bearPivot)

                f_send_sfp_exit_alert("TP4", "BEAR", "🚀 **TP4 (4.5RR) HIT: SFP BEAR | Final Target Cleared**")

                

            if ctx.ts_active and high >= ctx.ts_slPrice

                ctx.ts_active := false

                sfp_bearPivot.confirmed := false

                sfp_bearPivot.active := false

                f_clean_pivot(sfp_bearPivot)

                if ctx.ts_tp_2rr_hit

                    string exit_status = ctx.ts_tp_4_hit ? "TP3 + BE" : ctx.ts_tp_2_5_hit ? "TP2 + BE" : "TP1 + BE"

                    f_send_sfp_exit_alert(exit_status, "BEAR", "❌ **" + exit_status + " HIT: SFP BEAR | Breakeven Exit**")

                else

                    f_send_sfp_exit_alert("SL", "BEAR", "❌ **SL HIT: SFP BEAR | Sharp Exit**")

        else // ts_side == "BULL"

            if not ctx.ts_tp_2rr_hit and high >= ctx.ts_tp_2rr

                ctx.ts_tp_2rr_hit := true

                ctx.ts_slPrice := ctx.ts_entryPrice

                f_send_sfp_exit_alert("TP1", "BULL", "🎯 **TP1 HIT: SFP BULL | SL Moved to BE**")

            

            if not ctx.ts_tp_2_5_hit and high >= ctx.ts_tp_2_5

                ctx.ts_tp_2_5_hit := true

                f_send_sfp_exit_alert("TP2", "BULL", "🎯 **TP2 HIT: SFP BULL**")

            

            if not ctx.ts_tp_4_hit and high >= ctx.ts_tp_4

                ctx.ts_tp_4_hit := true

                f_send_sfp_exit_alert("TP3", "BULL", "🎯 **TP3 (4RR) HIT: SFP BULL**")

                

            if not ctx.ts_tp_4_5_hit and high >= ctx.ts_tp_4_5

                ctx.ts_tp_4_5_hit := true

                ctx.ts_active := false

                sfp_bullPivot.confirmed := false

                sfp_bullPivot.active := false

                f_clean_pivot(sfp_bullPivot)

                f_send_sfp_exit_alert("TP4", "BULL", "🚀 **TP4 (4.5RR) HIT: SFP BULL | Final Target Cleared**")

                

            if ctx.ts_active and low <= ctx.ts_slPrice

                ctx.ts_active := false

                sfp_bullPivot.confirmed := false

                sfp_bullPivot.active := false

                f_clean_pivot(sfp_bullPivot)

                if ctx.ts_tp_2rr_hit

                    string exit_status = ctx.ts_tp_4_hit ? "TP3 + BE" : ctx.ts_tp_2_5_hit ? "TP2 + BE" : "TP1 + BE"

                    f_send_sfp_exit_alert(exit_status, "BULL", "❌ **" + exit_status + " HIT: SFP BULL | Breakeven Exit**")

                else

                    f_send_sfp_exit_alert("SL", "BULL", "❌ **SL HIT: SFP BULL | Sharp Exit**")



    // Historical Target Tracker

    if bear_trig or bull_trig

        ctx.ts_hist_tp_2rr_hit := false

        ctx.ts_hist_tp_2_5_hit := false

        ctx.ts_hist_tp_4_hit := false

        ctx.ts_hist_tp_4_5_hit := false



    if sfp_bearPivot.confirmed

        risk = sfp_bearPivot.sfpPrice - sfp_bearPivot.oppPrice

        if risk > 0

            if low <= sfp_bearPivot.oppPrice - 2.0 * risk

                ctx.ts_hist_tp_2rr_hit := true

            if low <= sfp_bearPivot.oppPrice - 2.5 * risk

                ctx.ts_hist_tp_2_5_hit := true

            if low <= sfp_bearPivot.oppPrice - 4.0 * risk

                ctx.ts_hist_tp_4_hit := true

            if low <= sfp_bearPivot.oppPrice - 4.5 * risk

                ctx.ts_hist_tp_4_5_hit := true



    if sfp_bullPivot.confirmed

        risk = sfp_bullPivot.oppPrice - sfp_bullPivot.sfpPrice

        if risk > 0

            if high >= sfp_bullPivot.oppPrice + 2.0 * risk

                ctx.ts_hist_tp_2rr_hit := true

            if high >= sfp_bullPivot.oppPrice + 2.5 * risk

                ctx.ts_hist_tp_2_5_hit := true

            if high >= sfp_bullPivot.oppPrice + 4.0 * risk

                ctx.ts_hist_tp_4_hit := true

            if high >= sfp_bullPivot.oppPrice + 4.5 * risk

                ctx.ts_hist_tp_4_5_hit := true









// Execution



f_execute_sfp_detection(ctx, sfp_bearPivot, sfp_bullPivot)



f_execute_sfp_trade_tracking(ctx, sfp_bearPivot, sfp_bullPivot)




// Evaluate SFP parameters globally to pass to library

sfp_stars = ""

sfp_confluence = ""

if ctx.ts_active

    if ctx.ts_side == "BEAR"

        sfp_stars := f_get_stars(ctx.ts_bear_stars)

        sfp_confluence := ctx.ts_bear_notes

    else

        sfp_stars := f_get_stars(ctx.ts_bull_stars)

        sfp_confluence := ctx.ts_bull_notes

else if sfp_bearPivot.active or sfp_bearPivot.confirmed

    sfp_stars := f_get_stars(ctx.ts_bear_stars)

    sfp_confluence := ctx.ts_bear_notes

else if sfp_bullPivot.active or sfp_bullPivot.confirmed

    sfp_stars := f_get_stars(ctx.ts_bull_stars)

    sfp_confluence := ctx.ts_bull_notes

else

    sfp_stars := "-"

    sfp_confluence := "-"



if sfp_stars == ""

    sfp_stars := "-"



// Draw the SFP + MTF table utilizing KIMOO_Core_Lib

Lib.f_draw_sfp_mtf_table(

     sfp_showTable, enableMTFEntry, sfp_tablePos, "small", color.black, color.white,

     ctx.ts_active, ctx.ts_side, sfp_bearPivot.confirmed, sfp_bullPivot.confirmed, sfp_bearPivot.active, sfp_bullPivot.active,

     sfp_stars, sfp_confluence,

     ctx.ts_entryPrice, sfp_bearPivot.oppPrice, sfp_bullPivot.oppPrice,

     ctx.ts_slPrice, sfp_bearPivot.sfpPrice, sfp_bullPivot.sfpPrice,

     ctx.ts_active ? ctx.ts_tp_2rr_hit : ctx.ts_hist_tp_2rr_hit, ctx.ts_hist_tp_2rr_hit, ctx.ts_tp_2rr,

     ctx.ts_active ? ctx.ts_tp_2_5_hit : ctx.ts_hist_tp_2_5_hit, ctx.ts_hist_tp_2_5_hit, ctx.ts_tp_2_5,

     ctx.ts_active ? ctx.ts_tp_4_hit : ctx.ts_hist_tp_4_hit, ctx.ts_hist_tp_4_hit, ctx.ts_tp_4,

     ctx.ts_active ? ctx.ts_tp_4_5_hit : ctx.ts_hist_tp_4_5_hit, ctx.ts_hist_tp_4_5_hit, ctx.ts_tp_4_5

 )

