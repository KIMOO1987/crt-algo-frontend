crt_bear_color = input.color(color.red, "Bearish CRT Color", group=grp_crt)

crt_label_color = input.color(color.black, "CRT Label Color", group=grp_crt)



grp_aplus = "CRT-Algo A+ Filters"

settings.smart_alert := input.bool(true, "Smart Alert", group=grp_aplus)

min_rr_ratio = input.float(1.5, "Min R:R for Alert", minval=0.1, step=0.1, group=grp_aplus, tooltip="Minimum Risk:Reward ratio required to trigger a smart alert.")

settings.filter_time := input.bool(false, "Filter by Killzones", group=grp_aplus, tooltip="Pattern must form within active Killzones.")

settings.filter_poi := input.bool(false, "Filter by HTF POI Rejection", group=grp_aplus, tooltip="Pattern must show rejection at HTF POI levels.")

