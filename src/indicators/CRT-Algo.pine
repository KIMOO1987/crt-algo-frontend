settings.bias_source := input.string("1H", "Bias Source", options=["1H", "4H", "1D"], group=grp_aplus, tooltip="Timeframe to use for determining HTF market bias for CRT.")



//+--- Market Structure Settings ---+//

msGroup = 'CRT-Algo Market Structures'

msShow = input.bool (true, 'Show Market Structures', group = msGroup, inline="ms_show")

msTerm = input.string('Intermediate Term', 'Detection', options = ['Short Term', 'Intermediate Term', 'Long Term'], group = msGroup)

msLineStyle = "Solid"

msHistoryLimit = input.int(2, 'History Limit', minval = 1, group = msGroup)

msSize = input.string(size.tiny, 'Label Size', options=[size.tiny, size.small, size.normal, size.large, size.huge], group = msGroup)

msBullColor = input.color(#089981, 'Bullish Color', group = msGroup, inline = 'MS')

msBearColor = input.color(#f23645, 'Bearish Color', group = msGroup, inline = 'MS')



//+--- Fractal & CISD Settings ---+//

usebody_for_confirmation = true

show_cisd = input.bool(true, "Show CISD", group="CRT-Algo Fractal & CISD", inline="cisd_show")

show_cisd_lbl = input.bool(true, "Show Label", group="CRT-Algo Fractal & CISD", inline="cisd_show")

cisd_history_limit = input.int(2, "CISD History Limit", minval=1, group="CRT-Algo Fractal & CISD")

cisdSize = input.string(size.tiny, "Label Size", options=[size.tiny, size.small, size.normal, size.large, size.huge], group="CRT-Algo Fractal & CISD")

cisd_bull_color = input.color(color.green, "Bullish CISD Color", group="CRT-Algo Fractal & CISD", inline = 'CISD')

cisd_bear_color = input.color(color.red, "Bearish CISD Color", group="CRT-Algo Fractal & CISD", inline = 'CISD')





string aligned_tf = ""

if htf_mode == "Custom"

    aligned_tf := custom_htf

else

    int m_calc = timeframe.in_seconds() / 60

    if m_calc <= 1

        aligned_tf := "15"

    else if m_calc <= 3

        aligned_tf := "30"

    else if m_calc <= 5

        aligned_tf := "60"

    else if m_calc <= 15

        aligned_tf := "240"

    else if m_calc <= 30

        aligned_tf := "360"

    else if m_calc <= 60

        aligned_tf := "1D"

    else if m_calc <= 240

        aligned_tf := "1W"

    else if m_calc <= 1440

        aligned_tf := "1M"

    else

        aligned_tf := "3M"

        

var array<line> separator_lines = array.new<line>() 



if show_separator and timeframe.in_seconds() < timeframe.in_seconds(aligned_tf) and ta.change(time(aligned_tf)) != 0

    sep_style = separator_style == "Solid" ? line.style_solid : separator_style == "Dashed" ? line.style_dashed : line.style_dotted 

    sep_line = line.new(bar_index, high, bar_index, low, extend=extend.both, color=separator_color, style=sep_style, width=1)

    array.push(separator_lines, sep_line)

    if array.size(separator_lines) > 4

        line.delete(array.shift(separator_lines))



// --- Market Structure (Moved up for Bias calculation) ---

var Lib.MS_State ms_state = Lib.MS_State_Init()

ms_state.MS_Calc(msShow, msTerm, msLineStyle, msBullColor, msBearColor, msHistoryLimit, msSize)



// --- Determine Main Bias for Scoring ---

float htf_high = request.security(syminfo.tickerid, "D", high[1])

float htf_low  = request.security(syminfo.tickerid, "D", low[1])

bool ms_bullish = ms_state.stMS.type == 1

string current_main_bias = ms_bullish ? (close > htf_low ? "Bullish" : "Neutral") : (close < htf_high ? "Bearish" : "Neutral")

if close > htf_high

    current_main_bias := "Bullish"

else if close < htf_low

    current_main_bias := "Bearish"



