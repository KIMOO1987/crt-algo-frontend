mdl1 = "Auto => indiCATor"

mdl2 = "User => manuel"

canvas_theme    = input.string("Dark", "Theme", options=["Dark", "Light", "Custom"], inline= "al0", group = g0, tooltip=" Dark: Optimized for dark backgrounds. \n Light: Optimized for light backgrounds. \n Custom: Use user-defined colors below.")

modeltype       = input.string(defval =  mdl1, title = "Settings => ", options=[ mdl1, mdl2 ],inline= "al1",group = g0,tooltip= "Auto: \n Uses predefined settings optimized by indiCATor. \n User: \n Allows manual customization of settings below.")

lblfrmt         = input.string(defval="Symbol Name",title="SSMT Label Format ",options=["Symbol Name", "Emoji"],inline= "al2",group = g0, tooltip="Symbol Name: Displays the symbol name in the SSMT labels. \n Emoji: Displays an emoji representation in the SSMT labels.")

i_font          = input.string("tiny", "Chart Text Size",  options = ["tiny", "small",  "normal", "large", "huge"],inline="al3",group = g0, tooltip="Controls the size of the chart text.")



botm = "1", topm = "2", botN = "3", topN = "10", botD = "15", topD = "30", botW = "60", topW = "720", botMo = "180", topMo = "360", botQ = "1D", topQ = "1D", botY = "1W", topY = "1W"



show_cyclesmic  = input.bool(defval=false,title="Micro Cycle  ", inline="1",group  = g1)

show_cycles90   = input.bool(defval=false,title="90m Cycle     ",inline="1",group = g1)

show_cyclesD    = input.bool(defval=false,title="Daily Cycle   ",inline="1",group = g1)

show_cyclesW    = input.bool(defval=false,title= "Weekly Cycle",inline="1",group = g1)

show_cyclesMo   = input.bool(defval=false,title= "Monthly Cycle",inline="2",group = g1)

show_cyclesQ    = input.bool(defval=false,title= "Quarterly Cycle",inline="2",group = g1)

show_cyclesY    = input.bool(defval=false,title= "Yearly Cycle",inline="2",group = g1)

show_today_only = input.bool(defval=false, title="Current Day Only",inline="2", group=g1)

hidelines  = input.bool(defval=false,title=  "Hide lines",inline="00",group = g6)

ssmt_history_limit = input.int(50, "SSMT History Limit", minval = 1, maxval = 100, group = g6, tooltip="Controls the maximum number of Normal and Hidden SSMT lines/labels to show.")

hidelabels = input.bool(defval=false,title=  "Hide labels",inline="00",group = g6)

show_smtMo = input.bool(defval=true ,title=  "Normal Monthly " ,inline="m0",group = g6)

show_smtW  = input.bool(defval=true ,title=  "Normal Weekly " ,inline="0",group = g6)

show_smtD  = input.bool(defval=true ,title=  "Normal Daily   ",inline="1",group = g6)

show_smtN  = input.bool(defval=true ,title=  "Normal 90m    " ,inline="2",group = g6)

show_smtm  = input.bool(defval=true ,title=  "Normal Micro  " ,inline="3",group = g6)

show_smtQ  = input.bool(defval=true ,title=  "Normal Quarterly" ,inline="q0",group = g6)

show_smtY  = input.bool(defval=true ,title=  "Normal Yearly " ,inline="y0",group = g6)

smtMo_clr_in  = input.color(color.orange, title  = "N",inline="m0",group= g6)

smtW_clr_in   = input.color(color.blue  , title  = "N",inline="0",group= g6)

smtD_clr_in   = input.color(color.black , title  = "N",inline="1",group= g6)

smtN_clr_in   = input.color(color.purple, title  = "N",inline="2",group= g6)

smtm_clr_in   = input.color(color.navy  , title  = "N",inline="3",group= g6)

smtQ_clr_in   = input.color(color.lime, title  = "N",inline="q0",group = g6)

smtY_clr_in   = input.color(color.olive, title  = "N",inline="y0",group = g6)

smtMo_clr = canvas_theme == "Dark" ? #ff9800 : canvas_theme == "Light" ? #e65100 : smtMo_clr_in

smtW_clr  = canvas_theme == "Dark" ? #2979ff : canvas_theme == "Light" ? #1565c0 : smtW_clr_in

smtD_clr  = canvas_theme == "Dark" ? #eeeeee : canvas_theme == "Light" ? #212121 : smtD_clr_in

smtN_clr  = canvas_theme == "Dark" ? #ea80fc : canvas_theme == "Light" ? #7b1fa2 : smtN_clr_in

smtm_clr  = canvas_theme == "Dark" ? #8c9eff : canvas_theme == "Light" ? #283593 : smtm_clr_in

smtQ_clr = canvas_theme == "Dark" ? #c6ff00 : canvas_theme == "Light" ? #76ff03 : smtQ_clr_in

smtY_clr = canvas_theme == "Dark" ? #c0ca33 : canvas_theme == "Light" ? #827717 : smtY_clr_in



show_hsmtMo = input.bool(defval=true ,title=  "Hidden Monthly " ,inline="m0",group = g6)

show_hsmtW  = input.bool(defval=true ,title=  "Hidden Weekly " ,inline="0",group = g6)

show_hsmtD  = input.bool(defval=true ,title=  "Hidden Daily   ",inline="1",group = g6)

show_hsmtN  = input.bool(defval=true ,title=  "Hidden 90m    " ,inline="2",group = g6)

show_hsmtm  = input.bool(defval=true ,title=  "Hidden Micro  " ,inline="3",group = g6)

show_hsmtQ  = input.bool(defval=true ,title=  "Hidden Quarterly" ,inline="q0",group = g6)

show_hsmtY  = input.bool(defval=true ,title=  "Hidden Yearly " ,inline="y0",group = g6)

hsmtMo_clr_in = input.color(color.new(#f23645,0), title  = "H",inline="m0",group= g6)

hsmtW_clr_in  = input.color(color.new(#00bcd4,0)  , title  = "H",inline="0",group= g6)

hsmtD_clr_in  = input.color(color.new(#808080,0) , title  = "H",inline="1",group= g6)

hsmtN_clr_in  = input.color(color.new(#f06292,0), title  = "H",inline="2",group= g6)

hsmtm_clr_in  = input.color(color.new(#006064,0)  , title  = "H",inline="3",group= g6)

hsmtQ_clr_in  = input.color(color.new(#b2ff59,0), title  = "H",inline="q0",group = g6)

hsmtY_clr_in  = input.color(color.new(#808000,0), title  = "H",inline="y0",group = g6)

hsmtMo_clr = canvas_theme == "Dark" ? color.new(#ff5252, 30) : canvas_theme == "Light" ? color.new(#c62828, 30) : hsmtMo_clr_in

hsmtW_clr  = canvas_theme == "Dark" ? color.new(#00e5ff, 30) : canvas_theme == "Light" ? color.new(#00838f, 30) : hsmtW_clr_in

hsmtD_clr  = canvas_theme == "Dark" ? color.new(#bdbdbd, 30) : canvas_theme == "Light" ? color.new(#616161, 30) : hsmtD_clr_in

hsmtN_clr  = canvas_theme == "Dark" ? color.new(#ff4081, 30) : canvas_theme == "Light" ? color.new(#c2185b, 30) : hsmtN_clr_in

hsmtm_clr  = canvas_theme == "Dark" ? color.new(#18ffff, 30) : canvas_theme == "Light" ? color.new(#006064, 30) : hsmtm_clr_in

hsmtQ_clr  = canvas_theme == "Dark" ? color.new(#b2ff59, 30) : canvas_theme == "Light" ? color.new(#aeea00, 30) : hsmtQ_clr_in

hsmtY_clr  = canvas_theme == "Dark" ? color.new(#808000, 30) : canvas_theme == "Light" ? color.new(#558b2f, 30) : hsmtY_clr_in



g8 = "QCISD"

show_qcisd      = input.bool(true, "Show QCISD", inline="a", group=g8)

qcisd_bull_clr_in  = input.color(color.green, "Bullish", inline="d", group=g8)

qcisd_bear_clr_in  = input.color(color.red, "Bearish", inline="d", group=g8)

qcisd_pend_clr_in  = input.color(color.orange, "Pending", inline="d", group=g8)

qcisd_style_str = input.string("Solid", "Line Style", options=["Solid", "Dotted", "Dashed"], inline="e", group=g8)

qcisd_style     = qcisd_style_str == "Solid" ? line.style_solid : qcisd_style_str == "Dotted" ? line.style_dotted : line.style_dashed

qcisd_width     = input.int(1, "Line Width", minval=1, inline="f", group=g8)

qcisd_lbl_size  = input.string(size.small, "Label Size", options=[size.tiny, size.small, size.normal, size.large, size.huge], inline="g", group=g8)

qcisd_text_clr_in  = input.color(color.black, "Text Color", inline="h", group=g8)

qcisd_mono      = input.bool(true, "Monospace Text", inline="h", group=g8)

qcisd_max_limit = input.int(50, "Max QCISD Limit", minval=1, maxval=500, group=g8)



qcisd_bull_clr = canvas_theme == "Dark" ? color.green : canvas_theme == "Light" ? color.green : qcisd_bull_clr_in

qcisd_bear_clr = canvas_theme == "Dark" ? color.red : canvas_theme == "Light" ? color.red : qcisd_bear_clr_in

qcisd_pend_clr = canvas_theme == "Dark" ? color.orange : canvas_theme == "Light" ? color.orange : qcisd_pend_clr_in

qcisd_text_clr = canvas_theme == "Dark" ? color.white : canvas_theme == "Light" ? color.black : qcisd_text_clr_in



smt_txt_all_in = input.color(color.black, title = "SSMT Text Color", group=g6)

smt_txt_all = canvas_theme == "Dark" ? color.white : canvas_theme == "Light" ? color.black : smt_txt_all_in



normstyle  = input.string(line.style_solid ,title="Normal SSMT line style => ",options=[line.style_solid,line.style_dotted,line.style_dashed],group = g6)

hiddstyle  = input.string(line.style_dashed,title="Hidden SSMT line style => ",options=[line.style_solid,line.style_dotted,line.style_dashed],group = g6)











tz = input.string('UTC-5', title='Timezone', options=['UTC-11', 'UTC-10', 'UTC-9', 'UTC-8', 'UTC-7', 'UTC-6', 'UTC-5','UTC-4', 'UTC-3', 'UTC-2', 'UTC-1', 'UTC', 'UTC+1', 'UTC+2', 'UTC+3', 'UTC+4', 'UTC+5','UTC+5:30', 'UTC+6', 'UTC+7', 'UTC+8', 'UTC+9', 'UTC+10', 'UTC+11', 'UTC+12'],inline="s6", group='CRT-Algo Timezone')

dayStartHour = input.int(18, "Day Start Hour (TZ)", minval=0, maxval=23, group=g1, tooltip="Defines the hour when a new trading day starts based on the selected timezone.")



//---------------------------------------------------------------------------------





n = bar_index

tf = timeframe.period

sym = syminfo.tickerid

tipo = syminfo.type

arr_inv = array.from(false,false)

var string current_ticker = syminfo.ticker



f_check_match(input_sym) =>

    // Check if the input symbol is empty or doesn't contain a colon.

    if str.length(input_sym) == 0 or not str.contains(input_sym, ":")

        false // Return false to prevent runtime errors on empty/invalid inputs.

    else

        // Safely split and get the ticker part.

        t_sym = array.get(str.split(input_sym, ":"), 1)

        (current_ticker == t_sym) or str.contains(sym, t_sym) or str.contains(input_sym, current_ticker)



match_m1_1 = f_check_match(st1_m1), match_m1_2 = f_check_match(st2_m1), match_m1_3 = f_check_match(st3_m1)

match_m2_1 = f_check_match(st1_m2), match_m2_2 = f_check_match(st2_m2), match_m2_3 = f_check_match(st3_m2)

match_m3_1 = f_check_match(st1_m3), match_m3_2 = f_check_match(st2_m3), match_m3_3 = f_check_match(st3_m3)

match_m4_1 = f_check_match(st1_m4), match_m4_2 = f_check_match(st2_m4), match_m4_3 = f_check_match(st3_m4)



is_in_manual_m1 = tr1A and enable_m1 and (match_m1_1 or match_m1_2 or match_m1_3)

is_in_manual_m2 = tr1A and enable_m2 and (match_m2_1 or match_m2_2 or match_m2_3)

is_in_manual_m3 = tr1A and enable_m3 and (match_m3_1 or match_m3_2 or match_m3_3)

is_in_manual_m4 = tr1A and enable_m4 and (match_m4_1 or match_m4_2 or match_m4_3)

is_in_manual = is_in_manual_m1 or is_in_manual_m2 or is_in_manual_m3 or is_in_manual_m4 

var st1 = ""

var st2 = ""

var st3 = ""

if is_in_manual_m1 and enable_m1

    st1 := st1_m1, st2 := st2_m1, st3 := st3_m1 

else if is_in_manual_m2 and enable_m2

    st1 := st1_m2, st2 := st2_m2, st3 := st3_m2 

else if is_in_manual_m3 and enable_m3

    st1 := st1_m3, st2 := st2_m3, st3 := st3_m3

else if is_in_manual_m4 and enable_m4

    st1 := st1_m4, st2 := st2_m4, st3 := st3_m4



// --- 2. AUTO MATCHING GROUPS (Fixed for Futures) ---

//Future Assets

is_nq_asset = str.contains(sym, "NQ") or str.contains(sym, "MNQ")

is_es_asset = str.contains(sym, "ES") or str.contains(sym, "MES")

is_ym_asset = str.contains(sym, "YM") or str.contains(sym, "MYM")



is_gc_asset = str.contains(sym, "GC") or str.contains(sym, "MGC")

is_si_asset = str.contains(sym, "SI") or str.contains(sym, "MSI")

is_sl_asset = str.contains(sym, "PL") or str.contains(sym, "MSL")



is_in_g2 = tr1B and (str.contains(sym, "XAU") or str.contains(sym, "XAG") or str.contains(sym, "XPT"))

is_in_g3 = tr1C and (str.contains(sym, "BTC") or str.contains(sym, "ETH") or str.contains(sym, "TOTAL3"))

is_in_g4 = tr1D and (is_nq_asset or is_es_asset or is_ym_asset)

is_in_g5 = tr1E and (str.contains(sym, "EURUSD") or str.contains(sym, "GBPUSD") or str.contains(sym, "DXY"))

is_in_g6 = tr1F and (str.contains(sym, "US100") or str.contains(sym, "USTEC") or str.contains(sym, "NAS100") or str.contains(sym, "US500") or str.contains(sym, "SPX500") or str.contains(sym, "SP500") or str.contains(sym, "US30"))

is_in_g7 = tr1G and (is_gc_asset or is_si_asset or is_sl_asset)

// --- 3. TRIAD STATUS ---

// Logic: If Auto, check auto groups. If Manual, check manual group.

triad_valid = triad_selection_mode == "Off" ? false : 

           triad_selection_mode == "Auto" ? (is_in_g2 or is_in_g3 or is_in_g4 or is_in_g5 or is_in_g6 or is_in_g7) : 

           is_in_manual



match_1 = f_check_match(st1)

match_2 = f_check_match(st2)

match_3 = f_check_match(st3)



// --- 4. ASSIGNMENT LOGIC ---

var triad_inv = array.from(false, false)

array.set(triad_inv, 0, false)

array.set(triad_inv, 1, false)



var t_sym2 = sym

var t_sym3 = sym



if triad_valid

    // MANUAL TRIAD ASSIGNMENT

    if is_in_manual

        if match_1

            t_sym2 := st2

            t_sym3 := st3

            if (is_in_manual_m1 and inv_m1) or (is_in_manual_m2 and inv_m2) or (is_in_manual_m3 and inv_m3) or (is_in_manual_m4 and inv_m4)

                array.set(triad_inv, 1, true) // Invert st3

        else if match_2

            t_sym2 := st1

            t_sym3 := st3

            if (is_in_manual_m1 and inv_m1) or (is_in_manual_m2 and inv_m2) or (is_in_manual_m3 and inv_m3) or (is_in_manual_m4 and inv_m4)

                array.set(triad_inv, 1, true) // Invert st3

        else if match_3

            t_sym2 := st1

            t_sym3 := st2

            if (is_in_manual_m1 and inv_m1) or (is_in_manual_m2 and inv_m2) or (is_in_manual_m3 and inv_m3) or (is_in_manual_m4 and inv_m4)

                // When on st3, both st1 and st2 are correlated pairs. Invert both.

                array.set(triad_inv, 0, true)

                array.set(triad_inv, 1, true)

    // AUTO TRIAD ASSIGNMENT

    else if is_in_g2

        t_sym2 := str.contains(sym, "XAU") ? st5 : st4

        t_sym3 := str.contains(sym, "XPT") ? st5 : st6

    else if is_in_g3

        t_sym2 := str.contains(sym, "BTC") ? st8 : (str.contains(sym, "ETH") ? st7 : st7)

        t_sym3 := str.contains(sym, "BTC") ? st9 : (str.contains(sym, "ETH") ? st9 : st8)

    else if is_in_g4

        if is_nq_asset

            t_sym2 := st11, t_sym3 := st12

        else if is_es_asset

            t_sym2 := st10, t_sym3 := st12

        else if is_ym_asset

            t_sym2 := st10, t_sym3 := st11

    else if is_in_g5

        t_sym2 := str.contains(sym, "EURUSD") ? st14 : (str.contains(sym, "GBPUSD") ? st13 : st13)

        t_sym3 := str.contains(sym, "EURUSD") ? st15 : (str.contains(sym, "GBPUSD") ? st15 : st14)

        if str.contains(t_sym3, "DXY")

            array.set(triad_inv, 1, true)

        if str.contains(sym, "DXY")

            array.set(triad_inv, 0, true), array.set(triad_inv, 1, true)

    else if is_in_g6

        t_sym2 := str.contains(sym, "US100") ? st17 : (str.contains(sym, "US500") ? st16 : st16)

        t_sym3 := str.contains(sym, "US100") ? st18 : (str.contains(sym, "US500") ? st18 : st17)

    else if is_in_g7

        if is_gc_asset

            t_sym2 := st20, t_sym3 := st21

        else if is_si_asset

            t_sym2 := st19, t_sym3 := st21

        else if is_sl_asset

            t_sym2 := st19, t_sym3 := st20



// Ensure tsym2 and tsym3 are not the same as the main symbol (Safety check)

if t_sym2 == sym or array.get(str.split(t_sym2, ":"), 1) == current_ticker

    // Fallback logic could go here, but the specific assignments above usually prevent this.

    t_sym2 := t_sym2 



var d_sym = sym

var dyad_inv = array.from(false, false)

array.set(dyad_inv, 0, false)

dyad_valid = dyad_selection_mode != "Off"



if triad_valid

    t_sym2 := syminfo.type == "futures" ? (ticker.modify(t_sym2,session = syminfo.session,backadjustment=badj ? backadjustment.off:backadjustment.on) ) :t_sym2

    t_sym3 := syminfo.type == "futures" ? (ticker.modify(t_sym3,session = syminfo.session,backadjustment=badj ? backadjustment.off:backadjustment.on) ) :t_sym3



if dyad_valid

    if dyad_selection_mode == "Manual"

        is_on_dyad_m1 = enable_dyad_m1 and dyad_m1_sym1 != "" and dyad_m1_sym2 != "" and (f_check_match(dyad_m1_sym1) or f_check_match(dyad_m1_sym2))

        is_on_dyad_m2 = enable_dyad_m2 and dyad_m2_sym1 != "" and dyad_m2_sym2 != "" and (f_check_match(dyad_m2_sym1) or f_check_match(dyad_m2_sym2))

        is_on_dyad_m3 = enable_dyad_m3 and dyad_m3_sym1 != "" and dyad_m3_sym2 != "" and (f_check_match(dyad_m3_sym1) or f_check_match(dyad_m3_sym2))

        is_on_dyad_m4 = enable_dyad_m4 and dyad_m4_sym1 != "" and dyad_m4_sym2 != "" and (f_check_match(dyad_m4_sym1) or f_check_match(dyad_m4_sym2))



        if is_on_dyad_m1

            d_sym := f_check_match(dyad_m1_sym1) ? dyad_m1_sym2 : dyad_m1_sym1

            if inv_dyad_m1 and f_check_match(dyad_m1_sym1)

                array.set(dyad_inv, 0, true)

        else if is_on_dyad_m2

            d_sym := f_check_match(dyad_m2_sym1) ? dyad_m2_sym2 : dyad_m2_sym1

            if inv_dyad_m2 and f_check_match(dyad_m2_sym1)

                array.set(dyad_inv, 0, true)

        else if is_on_dyad_m3

            d_sym := f_check_match(dyad_m3_sym1) ? dyad_m3_sym2 : dyad_m3_sym1

            if inv_dyad_m3 and f_check_match(dyad_m3_sym1)

                array.set(dyad_inv, 0, true)

        else if is_on_dyad_m4

            d_sym := f_check_match(dyad_m4_sym1) ? dyad_m4_sym2 : dyad_m4_sym1

            if inv_dyad_m4 and f_check_match(dyad_m4_sym1)

                array.set(dyad_inv, 0, true)



    else if dyad_selection_mode == "Auto"

        // Checks against the hidden s1-s8 variables

        if str.contains(sym, s1) or sym == s1

            d_sym := s2

        else if str.contains(sym, s2) or sym == s2

            d_sym := s1

        else if str.contains(sym, s3) or sym == s3

            d_sym := s4

        else if str.contains(sym, s4) or sym == s4

            d_sym := s3

        else if str.contains(sym, s5) or sym == s5

            d_sym := s6

        else if str.contains(sym, s6) or sym == s6

            d_sym := s5

        else if str.contains(sym, s7) or sym == s7

            d_sym := s8

        else if str.contains(sym, s8) or str.contains(sym, "ETH") or sym == s8

            d_sym := s7

        else if is_nq_asset // Uses the helper boolean from above

            d_sym := s10 // Pair NQ with ES

        else if is_es_asset

            d_sym := s9  // Pair ES with NQ

        else if is_gc_asset // Uses the helper boolean from above

            d_sym := s12 // Pair GC with ES

        else if is_si_asset

            d_sym := s11  // Pair SI with NQ



    // Apply futures modification if needed

    d_sym  := syminfo.type == "futures" ? (ticker.modify(d_sym,session = syminfo.session,backadjustment=badj ? backadjustment.on:backadjustment.off) ) :d_sym





// --- ASSIGNMENT TO FUNCTIONS ---



// PSP Assignment

var psp_s2 = ""

var psp_s3 = ""

var psp_i2 = false

var psp_i3 = false



if triad_valid and (triad_usage == "TPD/PSP" or triad_usage == "Both")

    psp_s2 := t_sym2, psp_s3 := t_sym3

    psp_i2 := array.get(triad_inv, 0), psp_i3 := array.get(triad_inv, 1)

else if dyad_valid and (dyad_usage == "TPD/PSP" or dyad_usage == "Both")

    psp_s2 := d_sym

    psp_i2 := array.get(dyad_inv, 0)



// SMT Assignment

var csym = sym

var tsym3 = sym

var smt_s2 = ""

var smt_s3 = ""

var smt_i2 = false

var smt_i3 = false

triad_ok = false

dyad_ok = false



if triad_valid and (triad_usage == "SMT" or triad_usage == "Both") and t_sym2 != sym

    csym := t_sym2, tsym3 := t_sym3

    smt_s2 := t_sym2, smt_s3 := t_sym3

    smt_i2 := array.get(triad_inv, 0), smt_i3 := array.get(triad_inv, 1)

    array.set(arr_inv, 0, array.get(triad_inv, 0))

    array.set(arr_inv, 1, array.get(triad_inv, 1))

    triad_ok := true

else if dyad_valid and (dyad_usage == "SMT" or dyad_usage == "Both") and d_sym != sym

    csym := d_sym

    smt_s2 := d_sym

    smt_i2 := array.get(dyad_inv, 0)

    array.set(arr_inv, 0, array.get(dyad_inv, 0))

    dyad_ok := true



//+------------------------------------------------------------------------------------------------------------+//

//+--- PSP Settings                                                                                         ---+//

//+------------------------------------------------------------------------------------------------------------+//



psp_grp = "CRT-Algo PSP & TPD"

psp_show        = input.bool(true, "Show PSP", group=psp_grp, tooltip="Shows the PSP/TPD on the HTF Candles.")

psp_bull_color  = input.color(color.new(color.green, 50), "PSP Bull", group=psp_grp, inline = "PSP")

psp_bear_color  = input.color(color.new(color.red, 50), "PSP Bear", group=psp_grp, inline = "PSP")

tpd_bull_color  = input.color(color.new(color.blue, 50), "TPD Bull", group=psp_grp, inline = "TPD")

tpd_bear_color  = input.color(color.new(color.orange, 50), "TPD Bear", group=psp_grp, inline = "TPD")



//+--- PSP Data Fetching ---+//

psp_t2_id = psp_s2

psp_t3_id = psp_s3

psp_t2_inv = psp_i2

psp_t3_inv = psp_i3



// Helper function to fetch PSP data safely

get_psp_data(string id, string tf, bool cond) =>

    if cond and id != ""

        request.security(id, tf, [open, close, high, low], ignore_invalid_symbol=true)

    else

        [float(na), float(na), float(na), float(na)]



// Fetch PSP data for all configured HTFs

[psp_t2_o_auto, psp_t2_c_auto, psp_t2_h_auto, psp_t2_l_auto] = get_psp_data(psp_t2_id, aligned_tf, psp_show)

[psp_t3_o_auto, psp_t3_c_auto, psp_t3_h_auto, psp_t3_l_auto] = get_psp_data(psp_t3_id, aligned_tf, psp_show)



[psp_t2_o_1, psp_t2_c_1, psp_t2_h_1, psp_t2_l_1] = get_psp_data(psp_t2_id, htf_1, psp_show and htf1.settings.show)

[psp_t3_o_1, psp_t3_c_1, psp_t3_h_1, psp_t3_l_1] = get_psp_data(psp_t3_id, htf_1, psp_show and htf1.settings.show)



[psp_t2_o_2, psp_t2_c_2, psp_t2_h_2, psp_t2_l_2] = get_psp_data(psp_t2_id, htf_2, psp_show and htf2.settings.show)

[psp_t3_o_2, psp_t3_c_2, psp_t3_h_2, psp_t3_l_2] = get_psp_data(psp_t3_id, htf_2, psp_show and htf2.settings.show)



[psp_t2_o_3, psp_t2_c_3, psp_t2_h_3, psp_t2_l_3] = get_psp_data(psp_t2_id, htf_3, psp_show and htf3.settings.show)

[psp_t3_o_3, psp_t3_c_3, psp_t3_h_3, psp_t3_l_3] = get_psp_data(psp_t3_id, htf_3, psp_show and htf3.settings.show)



[psp_t2_o_4, psp_t2_c_4, psp_t2_h_4, psp_t2_l_4] = get_psp_data(psp_t2_id, htf_4, psp_show and htf4.settings.show)

[psp_t3_o_4, psp_t3_c_4, psp_t3_h_4, psp_t3_l_4] = get_psp_data(psp_t3_id, htf_4, psp_show and htf4.settings.show)



[psp_t2_o_5, psp_t2_c_5, psp_t2_h_5, psp_t2_l_5] = get_psp_data(psp_t2_id, htf_5, psp_show and htf5.settings.show)

[psp_t3_o_5, psp_t3_c_5, psp_t3_h_5, psp_t3_l_5] = get_psp_data(psp_t3_id, htf_5, psp_show and htf5.settings.show)



[psp_t2_o_6, psp_t2_c_6, psp_t2_h_6, psp_t2_l_6] = get_psp_data(psp_t2_id, htf_6, psp_show and htf6.settings.show)

[psp_t3_o_6, psp_t3_c_6, psp_t3_h_6, psp_t3_l_6] = get_psp_data(psp_t3_id, htf_6, psp_show and htf6.settings.show)





// Convert swing settings

confirmed_swing_style_value = confirmed_swing_style == "Solid" ? line.style_solid : confirmed_swing_style == "Dashed" ? line.style_dashed : line.style_dotted

potential_swing_style_value = potential_swing_style == "Solid" ? line.style_solid : potential_swing_style == "Dashed" ? line.style_dashed : line.style_dotted

eq_line_style_value = eq_line_style_input == "Solid" ? line.style_solid : eq_line_style_input == "Dashed" ? line.style_dashed : line.style_dotted



//+--- SMT Data Fetching ---+//

smt_t2_id = smt_s2

smt_t3_id = smt_s3



[smt_t2_o_auto, smt_t2_c_auto, smt_t2_h_auto, smt_t2_l_auto] = get_psp_data(smt_t2_id, aligned_tf, settings.htf_smt_show and htf_mode == "Auto")

[smt_t3_o_auto, smt_t3_c_auto, smt_t3_h_auto, smt_t3_l_auto] = get_psp_data(smt_t3_id, aligned_tf, settings.htf_smt_show and htf_mode == "Auto")



[smt_t2_o_1, smt_t2_c_1, smt_t2_h_1, smt_t2_l_1] = get_psp_data(smt_t2_id, htf_1, settings.htf_smt_show and htf1.settings.show)

[smt_t3_o_1, smt_t3_c_1, smt_t3_h_1, smt_t3_l_1] = get_psp_data(smt_t3_id, htf_1, settings.htf_smt_show and htf1.settings.show)



[smt_t2_o_2, smt_t2_c_2, smt_t2_h_2, smt_t2_l_2] = get_psp_data(smt_t2_id, htf_2, settings.htf_smt_show and htf2.settings.show)

[smt_t3_o_2, smt_t3_c_2, smt_t3_h_2, smt_t3_l_2] = get_psp_data(smt_t3_id, htf_2, settings.htf_smt_show and htf2.settings.show)



[smt_t2_o_3, smt_t2_c_3, smt_t2_h_3, smt_t2_l_3] = get_psp_data(smt_t2_id, htf_3, settings.htf_smt_show and htf3.settings.show)

[smt_t3_o_3, smt_t3_c_3, smt_t3_h_3, smt_t3_l_3] = get_psp_data(smt_t3_id, htf_3, settings.htf_smt_show and htf3.settings.show)



[smt_t2_o_4, smt_t2_c_4, smt_t2_h_4, smt_t2_l_4] = get_psp_data(smt_t2_id, htf_4, settings.htf_smt_show and htf4.settings.show)

[smt_t3_o_4, smt_t3_c_4, smt_t3_h_4, smt_t3_l_4] = get_psp_data(smt_t3_id, htf_4, settings.htf_smt_show and htf4.settings.show)



[smt_t2_o_5, smt_t2_c_5, smt_t2_h_5, smt_t2_l_5] = get_psp_data(smt_t2_id, htf_5, settings.htf_smt_show and htf5.settings.show)

[smt_t3_o_5, smt_t3_c_5, smt_t3_h_5, smt_t3_l_5] = get_psp_data(smt_t3_id, htf_5, settings.htf_smt_show and htf5.settings.show)



[smt_t2_o_6, smt_t2_c_6, smt_t2_h_6, smt_t2_l_6] = get_psp_data(smt_t2_id, htf_6, settings.htf_smt_show and htf6.settings.show)

[smt_t3_o_6, smt_t3_c_6, smt_t3_h_6, smt_t3_l_6] = get_psp_data(smt_t3_id, htf_6, settings.htf_smt_show and htf6.settings.show)



//+------------------------------------------------------------------------------------------------------------+//

//+------------------------------------------------------------------------------------------------------------+//

//+--- Variables                                                                                            ---+//



//+------------------------------------------------------------------------------------------------------------+//



color color_transparent = #ffffff00



//+------------------------------------------------------------------------------------------------------------+//

//+--- Internal Functions                                                                                   ---+//

//+------------------------------------------------------------------------------------------------------------+//



//+--- QTxCRT SSMT Logic                                                                                    ---+//

//+------------------------------------------------------------------------------------------------------------+//





//-----------------------------------------------------------------------------{

day_week  = dayofweek(time,'America/New_York')

num_candles  = 5



//-----------------------------------------------------------------------------}

//Functions

//-----------------------------------------------------------------------------{

tf_ok_mic = timeframe.in_seconds(tf) <= timeframe.in_seconds("5")

tf_ok = timeframe.in_seconds(tf) <= timeframe.in_seconds("10")

tf_okD = timeframe.in_seconds(tf) <= timeframe.in_seconds("30")

tf_okW = timeframe.in_seconds(tf) <= timeframe.in_seconds("120")

tf_okMo = timeframe.in_seconds(tf) <= timeframe.in_seconds("360")

tf_okQ = timeframe.in_seconds(tf) <= timeframe.in_seconds("1D")

tf_okY  = timeframe.in_seconds(tf) <= timeframe.in_seconds("1W")



// --- Visibility Logic ---

// Auto Mode: Use the timeframe ranges defined in the inputs.

// Manual Mode: Use the user-requested timeframe filters.



tf_ok_mic_V = modeltype == mdl1 ? (timeframe.in_seconds(tf) >= timeframe.in_seconds(botm) and timeframe.in_seconds(tf) <= timeframe.in_seconds(topm)) : (timeframe.in_seconds(tf) <= 120)



// 90m SSMT Visibility: Show on <= 15m charts in Manual mode.

tf_ok_V = modeltype == mdl1 ? (timeframe.in_seconds(tf) >= timeframe.in_seconds(botN) and timeframe.in_seconds(tf) <= timeframe.in_seconds(topN)) : (timeframe.in_seconds(tf) <= 900)



// Daily SSMT Visibility: Show on <= 1h charts in Manual mode.

tf_okD_V = modeltype == mdl1 ? (timeframe.in_seconds(tf) >= timeframe.in_seconds(botD) and timeframe.in_seconds(tf) <= timeframe.in_seconds(topD)) : (timeframe.in_seconds(tf) <= 3600)



// Weekly SSMT Visibility: Show on <= 4h charts in Manual mode.

tf_okW_V = modeltype == mdl1 ? (timeframe.in_seconds(tf) >= timeframe.in_seconds(botW) and timeframe.in_seconds(tf) <= timeframe.in_seconds(topW)) : (timeframe.in_seconds(tf) <= 14400)



// Monthly SSMT Visibility: Always show in Manual mode, respect range in Auto mode.

tf_okMo_V = modeltype == mdl1 ? (timeframe.in_seconds(tf) >= timeframe.in_seconds(botMo) and timeframe.in_seconds(tf) <= timeframe.in_seconds(topMo)) : true



// Quarterly Cycle Visibility 1 Day only

tf_okQ_V = modeltype == mdl1 ? (timeframe.in_seconds(tf) >= timeframe.in_seconds(botQ) and timeframe.in_seconds(tf) <= timeframe.in_seconds(topQ)) : (timeframe.in_seconds(tf) <= timeframe.in_seconds(topQ))



// Yearly Cycle Visibility 1 week only

tf_okY_V  = modeltype == mdl1 ? (timeframe.in_seconds(tf) >= timeframe.in_seconds(botY) and timeframe.in_seconds(tf) <= timeframe.in_seconds(topY)) : (timeframe.in_seconds(tf) <= timeframe.in_seconds(topY))



f_q_lbl(t) => 

    t == "A" or t == "W1" ? "Q1" :

      t == "M" or t == "W2" ? "Q2" :

      t == "D" or t == "W3" ? "Q3" :

      t == "X" or t == "W4" ? "Q4" :

      t == "Fr" ? "QFr" : t



f_cycle_box_manage(new_cycle, lbl_array, val_index)=>

    var box[] boxes = array.new_box()

    

    lbl = array.get(lbl_array, val_index)

    q = f_q_lbl(lbl)

    

    c_color = q == "Q1" ? color.red : q == "Q2" ? color.teal : q == "Q3" ? color.blue : q == "Q4" ? color.gray : q == "QFr" ? color.orange : color.gray

    

    transp = canvas_theme == "Dark" ? 85 : 90

    bg_color = lbl == "Gap" ? color.new(color.white, 100) : color.new(c_color, transp)

    border_color = lbl == "Gap" ? color.new(color.white, 100) : color.new(c_color, 50)

    

    if new_cycle

        if array.size(boxes) > 0

            prev_b = array.get(boxes, 0)

            box.set_right(prev_b, time)

        b = box.new(left=time, top=high, right=time, bottom=low, xloc=xloc.bar_time, border_color=border_color, border_style=line.style_dashed, bgcolor=bg_color)

        array.unshift(boxes, b)



    if show_today_only

        t_day = time("1D")

        if not na(t_day)

            while array.size(boxes) > 0

                last_b = array.get(boxes, array.size(boxes) - 1)

                if box.get_left(last_b) < t_day

                    box.delete(array.pop(boxes))

                else

                    break

            

    if array.size(boxes) > 0

        b = array.get(boxes, 0)

        box.set_right(b, time)

        if high > box.get_top(b)

            box.set_top(b, high)

        if low < box.get_bottom(b)

            box.set_bottom(b, low)



/////////////////////////////////////

add_to_array(arr, value) =>

    array.unshift(arr, value)

    if array.size(arr) > num_candles -1

        array.pop(arr)

add_to_array_box(arr, value) =>

    array.unshift(arr, value)

    if array.size(arr) > ssmt_history_limit

        popped_id = array.pop(arr)

        line.delete(popped_id)



add_to_line_array(arr, value) =>

    array.unshift(arr, value)

    if array.size(arr) > ssmt_history_limit

        line.delete(array.pop(arr))



add_to_label_array(arr, value) =>

    array.unshift(arr, value)

    if array.size(arr) > ssmt_history_limit

        label.delete(array.pop(arr))





///////////////////////////////////





f_leap_year(y) =>

    y % 4 == 0 and (y % 100 != 0 or y % 400 == 0)



f_month_length(is_leap, m) =>

    if m == 2

        is_leap ? 29 : 28

    else if (m == 4 or m == 6 or m == 9 or m == 11)

        30

    else

        31



//-----------------------------------------------------------------------------}

//Sessions

//-----------------------------------------------------------------------------{



msDay   = 24 * 60 * 60 * 1000

msWeek  = 7  * 24 * 60 * 60 * 1000

ms90m   = 90 * 60 * 1000

msMicro = 1350000  // 22.5 minutes in ms



yy  = year(time, tz)

mo  = month(time, tz)

dom = dayofmonth(time, tz)

dow = dayofweek(time, tz)



dayStartToday = timestamp(tz, yy, mo, dom, dayStartHour, 0)

dayStart      = time >= dayStartToday ? dayStartToday : (dayStartToday - msDay)

minsFromDayStart = int(((time - dayStart) % msDay) / (60 * 1000))  // 0..1439



yy_c  = year(dayStart, tz)

mo_c  = month(dayStart, tz)

dom_c = dayofmonth(dayStart, tz)

dow_c = dayofweek(dayStart, tz)



qYear = mo_c <= 3 ? 1 : mo_c <= 6 ? 2 : mo_c <= 9 ? 3 : 4



is_year1 = qYear == 1

is_year2 = qYear == 2

is_year3 = qYear == 3

is_year4 = qYear == 4



qs_m = math.floor((mo_c - 1) / 3) * 3 + 1

qs_t = timestamp(tz, yy_c, qs_m, 1, dayStartHour, 0)

qe_t = timestamp(tz, yy_c, qs_m + 3, 1, dayStartHour, 0)

q_dur = qe_t - qs_t

q2Month = int(math.floor((time - qs_t) / q_dur * 4)) + 1

q2Month := math.max(1, math.min(4, q2Month))



is_quarter1 = q2Month == 1

is_quarter2 = q2Month == 2

is_quarter3 = q2Month == 3

is_quarter4 = q2Month == 4



monday_time = dayStart - (dow_c == dayofweek.sunday ? -1 : dow_c - 2) * msDay

mon_y = year(monday_time, tz)

mon_m = month(monday_time, tz)

mon_d = dayofmonth(monday_time, tz)



// Timezone-safe mathematical calculation of the first Monday of the calendar month

dow_1st = ((1 - (mon_d - 1) % 7 + 7) % 7) + 1



first_monday_mon_m_raw = dow_1st == dayofweek.monday ? 1 :

                          dow_1st == dayofweek.tuesday ? 7 :

                          dow_1st == dayofweek.wednesday ? 6 :

                          dow_1st == dayofweek.thursday ? 5 :

                          dow_1st == dayofweek.friday ? 4 :

                          dow_1st == dayofweek.saturday ? 3 : 2



first_monday_mon_m = first_monday_mon_m_raw < 4 ? first_monday_mon_m_raw + 7 : first_monday_mon_m_raw



week_index = math.round((mon_d - first_monday_mon_m) / 7)

qMonth_raw = week_index + 1

qMonth = qMonth_raw <= 0 ? qMonth_raw + 5 : qMonth_raw



qWeek = dow_c == dayofweek.sunday ? 1 : dow_c == dayofweek.monday ? 2 : dow_c == dayofweek.tuesday ? 3 : dow_c == dayofweek.wednesday ? 4 : dow_c == dayofweek.thursday ? 5 : dow_c == dayofweek.friday ? 6 : dow_c == dayofweek.saturday ? 7 : na



//Weekly cycle

is_week1 = qWeek == 1

is_week2 = qWeek == 2

is_week3 = qWeek == 3

is_week4 = qWeek == 4

is_week5 = qWeek == 5

is_week6 = qWeek == 6

is_week7 = qWeek == 7



//Monthly Cycle

is_month1 = qMonth == 1

is_month2 = qMonth == 2

is_month3 = qMonth == 3

is_month4 = qMonth == 4

is_month5 = qMonth == 5



qDay = int(math.floor(minsFromDayStart / 360)) + 1  // 1..4



minsIn6H = minsFromDayStart % 360

q90 = int(math.floor(minsIn6H / 90)) + 1 // 1..4



msInto90 = int((time - dayStart) % ms90m)

qMicro = int(math.floor(msInto90 / msMicro)) + 1

qMicro := qMicro < 1 ? 1 : qMicro > 4 ? 4 : qMicro



//-----------------------------------------------------------------------------}

//Overlays

//-----------------------------------------------------------------------------



// Cycle Indices Calculation (Math-based optimization)

val_sesD = math.max(0, int(qDay) - 1)

val_ses  = math.max(0, (val_sesD * 4) + (int(q90) - 1))

val_sesm = math.max(0, (val_ses * 4) + (int(qMicro) - 1))



val_sesW  = math.max(0, int(nz(qWeek, 1)) - 1)

val_sesMo = math.max(0, int(nz(qMonth, 1)) - 1)

val_sesQ  = math.max(0, int(q2Month) - 1)

val_sesY  = math.max(0, int(qYear) - 1)



// Text Arrays (Static lookups)

var arr_sesmy  = array.from(

 "A","M","D","X", "A","M","D","X", "A","M","D","X", "A","M","D","X",

 "A","M","D","X", "A","M","D","X", "A","M","D","X", "A","M","D","X",

 "A","M","D","X", "A","M","D","X", "A","M","D","X", "A","M","D","X",

 "A","M","D","X", "A","M","D","X", "A","M","D","X", "A","M","D","X")



var arr_sesmz  = array.from(

 'Asian Aa','Asian Am','Asian Ad','Asian Ar', 'Asian Ma','Asian Mm','Asian Md','Asian Mr', 'Asian Da','Asian Dm','Asian Dd','Asian Dr', 'Asian Ra','Asian Rm','Asian Rd','Asian Rr',

 'London Aa','London Am','London Ad','London Rr', 'London Ma','London Mm','London Md','London Mr', 'London Da','London Dm','London Dd','London Dr', 'London Ra','London Rm','London Rd','London Rr',

 'NY Aa','NY Am','NY Ad','NY Ar', 'NY Ma','NY Mm','NY Md','NY Mr', 'NY Da','NY Dm','NY Dd','NY Dr', 'NY Ra','NY Rm','NY Rd','NY Rr',

 'PM Aa','PM Am','PM Ad','PM Ar', 'PM Ma','PM Mm','PM Md','PM Mr', 'PM Da','PM Dm','PM Dd','PM Dr', 'PM Ra','PM Rm','PM Rd','PM Rr')



var arr_sesy  = array.from("A","M","D","X", "A","M","D","X", "A","M","D","X", "A","M","D","X")

var arr_sesz  = array.from(

 'Asian A','Asian M','Asian D','Asian R',

 'London A','London M','London D','London R',

 'NY A','NY M','NY D','NY R',

 'PM A','PM M','PM D','PM R')



var arr_sesDy = array.from("A","M","D","X")

var arr_sesDz = array.from('Daily A','Daily M','Daily D','Daily R')



var arr_sesWy = array.from("A","M","D","X","Fr","Sat","Sun") // Mon, Tue, Wed, Thu/Fri

var arr_sesWz = array.from("Weekly A","Weekly M","Weekly D","Weekly R","Weekly x","Weekly x","Weekly x")



var arr_sesMoy = array.from("W1", "W2", "W3", "W4", "Gap")

var arr_sesMoz = array.from("Monthly W1", "Monthly W2", "Monthly W3", "Monthly W4", "Monthly Gap")



var arr_sesQy = array.from("Q1", "Q2", "Q3", "Q4")

var arr_sesQz = array.from("Quarterly Q1", "Quarterly Q2", "Quarterly Q3", "Quarterly Q4")



var arr_sesYy = array.from("Q1", "Q2", "Q3", "Q4")

var arr_sesYz = array.from("Yearly Q1", "Yearly Q2", "Yearly Q3", "Yearly Q4")



newMo = val_sesMo != val_sesMo[1]

newW = val_sesW != val_sesW[1]

newD = val_sesD != val_sesD[1]

newN = val_ses  !=  val_ses[1]

newm = val_sesm != val_sesm[1]

newQ = val_sesQ != val_sesQ[1]

newY  = val_sesY != val_sesY[1]



//🐶 🧫 🥘 🐱

[xc0,xo0,xh0,xl0,xt0,xatr]=request.security(csym,tf,[close,open,high,low,time,ta.atr(20)],lookahead = barmerge.lookahead_on,ignore_invalid_symbol = true)

ssmt_pair  = str.tostring(syminfo.ticker(csym)) 

txt_lbl = triad_ok ? "🐶 " + ssmt_pair + " + " +"🐱 " + str.tostring(syminfo.ticker(tsym3)) : "🐶 " + ssmt_pair 

pair_label = 'SSMT --> '+ txt_lbl 





[yc0,yo0,yh0,yl0,yt0,yatr]=request.security( tsym3,tf,[close,open,high,low,time,ta.atr(20)],lookahead = barmerge.lookahead_on,ignore_invalid_symbol = true)

ssmt_pair2 = str.tostring(syminfo.ticker(tsym3))



////////////////////////////////////////////////

f_main_process(_tf_ok,_tf_ok_V, _val_ses, op,cls,hi,lo,ti,cyc_txt,arr_sesy,arr_sesz)=>

    var o0     = op , var o1 = op , var o2 = op, var c1 = cls, var c2 = cls

    var hmax   = hi , var hmax1 = hi , var hmax2 = hi

    var lmin   = lo , var lmin1 = lo , var lmin2 = lo

    var float hmax_o = op, var float hmax_c = cls, var float hmax_l = lo, var float hmax_po = op

    var float lmin_o = op, var float lmin_c = cls, var float lmin_h = hi, var float lmin_po = op

    var t0     = ti

    var t1     = ti

    var txt0   = ""

    var hmaxt  = ti,  var lmint   = ti

    var hmaxt1 = ti,  var lmint1  = ti

    var clsmax  = math.max(cls,op), var clsmaxt = ti  , var clsmin  = math.min(cls,op) , var clsmint =  ti

    var clsmax1 = math.max(cls,op), var clsmaxt1 = ti , var clsmin1 = math.min(cls,op) , var clsmint1 = ti

    var arr_h = array.new_float(),var arr_l = array.new_float()

    var arr_o = array.new_float(),var arr_c = array.new_float()

    var arr_t = array.new_string()



    if _tf_ok

        if _val_ses  !=  _val_ses[1]

            o0    := op

            hmax  := hi

            lmin  := lo

            t0    := ti

            hmaxt := ti

            lmint := ti

            clsmax  := math.max(cls,op)

            clsmaxt := ti

            clsmin  := math.min(cls,op)

            clsmint := ti 

            hmax_o := op, hmax_c := cls, hmax_l := lo, hmax_po := op[1]

            lmin_o := op, lmin_c := cls, lmin_h := hi, lmin_po := op[1]



    if _val_ses == _val_ses[1]

        if hi >= hmax

            hmax  := hi

            hmaxt := ti

            hmax_o := op, hmax_c := cls, hmax_l := lo, hmax_po := op[1]

        if lo <= lmin

            lmin  := lo

            lmint := ti

            lmin_o := op, lmin_c := cls, lmin_h := hi, lmin_po := op[1]



        if math.max(cls,op) >= clsmax 

            clsmax := math.max(cls,op)

            clsmaxt:= ti

        if math.min(cls,op) <= clsmin 

            clsmin := math.min(cls,op)

            clsmint:= ti 



    c0 = cls

    txt0 := array.get(arr_sesy,_val_ses)

    txtz  = array.get(arr_sesz,_val_ses)

    if _val_ses  !=  _val_ses[1]

        add_to_array(arr_h,hmax[1])

        add_to_array(arr_l,lmin[1])        

        add_to_array(arr_o,o0[1])

        add_to_array(arr_c,cls[1])

        add_to_array(arr_t,txt0[1])

        hmax1 := hmax[1]

        lmin1 := lmin[1]

        hmax2 := hmax1[1]

        lmin2 := lmin1[1]                

  

        hmaxt1 := hmaxt[1]

        lmint1 := lmint[1]        

        t1 := t0[1]

        clsmax1  := clsmax[1]

        clsmaxt1 := clsmaxt[1]

        clsmin1  := clsmin[1]

        clsmint1 := clsmint[1]

        o1 := o0[1]

        o2 := o1[1]

        c1 := c0[1]

        c2 := c1[1]



    var bias = 0

    if _val_ses  !=  _val_ses[1]

        bias:= 0

        if c1 > hmax2 

            bias := 1



        if c1 < lmin2

            bias := -1

        if c1 < hmax2 and c1 > lmin2 and hmax1 > hmax2 and lmin1 > lmin2

            bias := -1

        if c1 > lmin2 and c1 < hmax2 and hmax1 < hmax2 and lmin1 < lmin2

            bias := 1

        if hmax1 <= hmax2 and lmin1 >= lmin2  

            if  c2 > o2

                bias := 1

            else

                bias := -1 

    biastxt = bias == 1 ? "Bullish" : bias == -1 ? "Bearish" : "No Bias"



    [hmaxt,lmint,hmax2, lmin2,hmax1,lmin1,hmax,lmin,hmaxt1,lmint1,clsmax,clsmax1,clsmaxt1,clsmin,clsmin1,clsmint1,clsmaxt,clsmint,o0,txt0,biastxt, hmax_o, hmax_c, hmax_l, hmax_po, lmin_o, lmin_c, lmin_h, lmin_po] 

// /////////////////////////////////////////////////////////////////////// 





/////////////////////////////////////////////////////////////////////////////SMT 

f_ssmt(ah2,ah1,ah0,al2,al1,al0,bh2,bh1,bh0,bl2,bl1,bl0,_hmaxt,_lmint,_hmaxt1,_lmint1,_tfok,_val_ses,showon,_smt_clr,_smt_txt_clr,tri,xx,zh0,zl0,_tf_ok_V,lbl,name,pair,_inv)=>

    _bear1 = ((ah2 >= ah1 and bh2 <= bh1) or (ah2 <= ah1 and bh2 >= bh1) ) and not(ah2 == ah1 and bh2 == bh1) and not _inv

    _bear0 = ((ah1 >= ah0 and bh1 <= bh0) or (ah1 <= ah0 and bh1 >= bh0) ) and not(ah1 == ah0 and bh1 == bh0) and not _inv 

    _bull1 = ((al2 <= al1 and bl2 >= bl1) or (al2 >= al1 and bl2 <= bl1) ) and not(al2 == al1 and bl2 == bl1) and not _inv  

    _bull0 = ((al1 <= al0 and bl1 >= bl0) or (al1 >= al0 and bl1 <= bl0) ) and not(al1 == al0 and bl1 == bl0) and not _inv 

    if _inv 

        _bear1 := ((ah2 >= ah1 and bl2 >= bl1) or (ah2 <= ah1 and bl2 <= bl1) ) and not(ah2 == ah1 and bl2 == bl1) 

        _bear0 := ((ah1 >= ah0 and bl1 >= bl0) or (ah1 <= ah0 and bl1 <= bl0) ) and not(ah1 == ah0 and bl1 == bl0) 

        _bull1 := ((al2 <= al1 and bh2 <= bh1) or (al2 >= al1 and bh2 >= bh1) ) and not(al2 == al1 and bh2 == bh1) 

        _bull0 := ((al1 <= al0 and bh1 <= bh0) or (al1 >= al0 and bh1 >= bh0) ) and not(al1 == al0 and bh1 == bh0)

 

    tooltiplbl = pair == 2 ? name +" " + ssmt_pair  :name +" " + ssmt_pair2 

    lblstyleh = label.style_label_down

    lblstylel = label.style_label_up



    var smtbeh = line.new(na,na,na,na)

    var smtbul = line.new(na,na,na,na) 

    var smtbe  = label.new(na,na)

    var smtbu  = label.new(na,na)  



    label ret_smtbe = na

    label ret_smtbu = na



    var arr_beh = array.new_line()

    var arr_ch1 = array.new_float()

    var arr_lbh = array.new_label()



    var arr_bul = array.new_line()

    var arr_cl1 = array.new_float()

    var arr_lbl = array.new_label()    







    if (_bull0 or _bear0 )and showon and _tfok and _tf_ok_V

        if (_val_ses[1] != _val_ses or not _bear0[1] or _hmaxt != _hmaxt[1] ) and  _bear0           

            smtbeh   := line.new(x1 = _hmaxt1 , y1 = ah1 , x2 = _hmaxt , y2 = ah0 , xloc=xloc.bar_time,color= hidelines ?color.new(_smt_clr,100):_smt_clr,width = 1,style=normstyle) 

            if not hidelabels

                smtbe    := label.new(x=math.round(_hmaxt+_hmaxt1)/2, y = math.round_to_mintick(ah1+ah0)/2,text = lbl ,xloc = xloc.bar_time,yloc = yloc.price,color = color.new(color.white, 100),

                 style=lblstyleh,textcolor = _smt_txt_clr, size = i_font,tooltip = tooltiplbl)

                ret_smtbe := smtbe

                add_to_label_array(arr_lbh,smtbe)

            add_to_line_array(arr_beh,smtbeh) 





        if (_val_ses[1] != _val_ses or not _bull0[1] or _lmint != _lmint[1] ) and  _bull0  

            smtbul := line.new(x1 = _lmint1 , y1 = al1 , x2 = _lmint , y2 = al0 , xloc=xloc.bar_time,color= hidelines ?color.new(_smt_clr,100):_smt_clr,width = 1,style = normstyle)

            if not hidelabels

                smtbu  := label.new(x=math.round(_lmint+_lmint1)/2, y = math.round_to_mintick(al1+al0)/2,text = lbl ,xloc = xloc.bar_time,yloc = yloc.price,color = color.new(color.white, 100),

                 style=lblstylel,textcolor = _smt_txt_clr, size = i_font,tooltip = tooltiplbl)

                ret_smtbu := smtbu

                add_to_label_array(arr_lbl,smtbu)

            add_to_line_array(arr_bul,smtbul)





    if array.size(arr_beh) > 0 and showon and _tfok and _tf_ok_V

        if _val_ses == _val_ses[1] and _bear0[1] and not _bear0 

            line.delete(smtbeh)

            array.remove(arr_beh,0)

            if not hidelabels and array.size(arr_lbh) > 0           

                label.delete(smtbe)

                array.remove(arr_lbh,0)



    if array.size(arr_beh) > 0 and showon //and _tfok and _tf_ok_V

        for i = array.size(arr_beh) -1 to 0

            dline = array.get(arr_beh,i)



            top    = line.get_y2(dline)

            tme    = line.get_x2(dline)

            if time > tme and high >= top

                line.delete(dline)

                array.remove(arr_beh,i)

                if not hidelabels and array.size(arr_lbh) > 0  

                    dlbl   = array.get(arr_lbh,i)

                    label.delete(dlbl)

                    array.remove(arr_lbh,i)







    if array.size(arr_bul) > 0 and showon and _tfok and _tf_ok_V//

        if _val_ses == _val_ses[1] and _bull0[1] and not _bull0 

            line.delete(smtbul)

            array.remove(arr_bul,0)

            if not hidelabels and array.size(arr_lbl) > 0             

                label.delete(smtbu)

                array.remove(arr_lbl,0)   



    if array.size(arr_bul) > 0 and showon and _tfok and _tf_ok_V

        for i = array.size(arr_bul) -1 to 0

            dline = array.get(arr_bul,i)

           

            bot    = line.get_y2(dline)

            tme    = line.get_x2(dline)

            if time > tme and low <= bot

                line.delete(dline)

                array.remove(arr_bul,i) 

                if not hidelabels and array.size(arr_lbl) > 0 

                    dlbl   = array.get(arr_lbl,i)                                    

                    label.delete(dlbl)

                    array.remove(arr_lbl,i)



    [_bear1,_bear0,_bull1,_bull0, ret_smtbe, ret_smtbu]



////////////////////////////////////////////////////////////////

f_hidden_ssmt(_clsmax,_clsmax1,_clsmin,_clsmin1,_clsmaxt,_clsmaxt1,_clsmint,_clsmint1,_cclsmax,_cclsmax1,_cclsmin,_cclsmin1,

 _tfok,showon,_smt_clr,_smt_txt_clr,tri,xx,_val_ses, ah1 ,ah0, al1,al0,bh1,bh0,bl1,bl0,zh0,zl0 , _tf_ok_V,lbl,name,pair,_inv)=>



    _hbear0 = ( (_clsmax >= _clsmax1 and _cclsmax <= _cclsmax1) or (_clsmax <= _clsmax1 and _cclsmax >= _cclsmax1) ) and 

     not (_clsmax == _clsmax1 and _cclsmax == _cclsmax1) and not _inv //and barstate.isconfirmed

    _lbull0 = ( (_clsmin >= _clsmin1 and _cclsmin <= _cclsmin1) or (_clsmin <= _clsmin1 and _cclsmin >= _cclsmin1) ) and 

     not (_clsmin == _clsmin1 and _cclsmin == _cclsmin1) and not _inv //and barstate.isconfirmed



    if _inv

        _hbear0 := ( (_clsmax >= _clsmax1 and _cclsmin >= _cclsmin1) or (_clsmax <= _clsmax1 and _cclsmin <= _cclsmin1) ) and 

         not (_clsmax == _clsmax1 and _cclsmin == _cclsmin1) //and barstate.isconfirmed

        _lbull0 := ( (_clsmin >= _clsmin1 and _cclsmax >= _cclsmax1) or (_clsmin <= _clsmin1 and _cclsmax <= _cclsmax1) ) and 

         not (_clsmin == _clsmin1 and _cclsmax == _cclsmax1)



    tooltiplbl = pair == 2 ? name +" hd " + ssmt_pair  :name +" hd " + ssmt_pair2    

    lblstyleh = label.style_label_down

    lblstylel = label.style_label_up



    var hsmtbeh = line.new(na,na,na,na)

    var hsmtbul = line.new(na,na,na,na) 

    var hsmtbe  = label.new(na,na)

    var hsmtbu  = label.new(na,na)



    label ret_hsmtbe = na

    label ret_hsmtbu = na



    var harr_beh = array.new_line()

    var harr_lbh = array.new_label()



    var harr_bul = array.new_line()

    var harr_lbl = array.new_label() 



    if showon and _tfok and _tf_ok_V

        if (_val_ses[1] != _val_ses or not _hbear0[1] or _clsmaxt != _clsmaxt[1] ) and  _hbear0  // and           

            hsmtbeh := line.new(x1 = _clsmaxt1 , y1 = _clsmax1 , x2 = _clsmaxt , y2 = _clsmax , xloc=xloc.bar_time,color= hidelines ?color.new(_smt_clr,100):_smt_clr,width = 1,style=hiddstyle) 

            add_to_line_array(harr_beh,hsmtbeh)

            if not hidelabels

                hsmtbe    := label.new(x=math.round(_clsmaxt+_clsmaxt1)/2, y = math.round_to_mintick(_clsmax1+_clsmax)/2,text = lbl ,xloc = xloc.bar_time,yloc = yloc.price,color = color.new(color.white, 100),

                 style=lblstyleh,textcolor = _smt_txt_clr, size = i_font,tooltip = tooltiplbl)

                ret_hsmtbe := hsmtbe

                add_to_label_array(harr_lbh,hsmtbe)



        if (_val_ses[1] != _val_ses or not _lbull0[1] or _clsmint != _clsmint[1] ) and  _lbull0 

            hsmtbul := line.new(x1 = _clsmint1 , y1 = _clsmin1 , x2 = _clsmint , y2 = _clsmin , xloc=xloc.bar_time,color= hidelines ?color.new(_smt_clr,100):_smt_clr,width = 1,style = hiddstyle)

            add_to_line_array(harr_bul,hsmtbul)

            if not hidelabels

                hsmtbu  := label.new(x=math.round(_clsmint+_clsmint1)/2, y = math.round_to_mintick(_clsmin1+_clsmin)/2,text = lbl ,xloc = xloc.bar_time,yloc = yloc.price,color = color.new(color.white, 100),

                 style=lblstylel,textcolor = _smt_txt_clr, size = i_font,tooltip = tooltiplbl)

                ret_hsmtbu := hsmtbu

                add_to_label_array(harr_lbl,hsmtbu)





    if array.size(harr_beh) > 0 and showon and _tfok and _tf_ok_V

        if _val_ses == _val_ses[1] and _hbear0[1] and not _hbear0 

            line.delete(hsmtbeh)

            array.remove(harr_beh,0)

            if not hidelabels and array.size(harr_lbh) > 0           

                label.delete(hsmtbe)

                array.remove(harr_lbh,0)            



    if array.size(harr_beh) > 0 and showon and _tfok and _tf_ok_V

        for i = array.size(harr_beh) -1 to 0

            dline = array.get(harr_beh,i)

            top    = line.get_y2(dline)

            tme    = line.get_x2(dline)

            if time > tme and math.max(open,close) >= top //and barstate.isconfirmed

                line.delete(dline)

                array.remove(harr_beh,i)

                if not hidelabels and array.size(harr_lbh) > 0  

                    dlbl   = array.get(harr_lbh,i)

                    label.delete(dlbl)

                    array.remove(harr_lbh,i)                



    if array.size(harr_bul) > 0 and showon and _tfok and _tf_ok_V//

        if _val_ses == _val_ses[1] and _lbull0[1] and not _lbull0 

            line.delete(hsmtbul)

            array.remove(harr_bul,0) 

            if not hidelabels and array.size(harr_lbl) > 0             

                label.delete(hsmtbu)

                array.remove(harr_lbl,0)



    if array.size(harr_bul) > 0 and showon and _tfok and _tf_ok_V

        for i = array.size(harr_bul) -1 to 0

            dline = array.get(harr_bul,i)

            bot    = line.get_y2(dline)

            tme    = line.get_x2(dline)

            if time > tme and math.min(open,close) <= bot //and barstate.isconfirmed

                line.delete(dline)

                array.remove(harr_bul,i)

                if not hidelabels and array.size(harr_lbl) > 0 

                    dlbl   = array.get(harr_lbl,i)                                    

                    label.delete(dlbl)

                    array.remove(harr_lbl,i)

    [_hbear0,_lbull0, ret_hsmtbe, ret_hsmtbu]

////////////////////////////////////////////////////////////////🐶 🧫 🥘 🐱

anime1 = "🐶"

anime2 = "🐱"

M_SSMT  = array.from(false,false,false,false,false,false,false,false,false,false)//0-5 smt1// 6-9 smt2

W_SSMT  = array.from(false,false,false,false,false,false,false,false,false,false)//0-5 smt1// 6-9 smt2

D_SSMT  = array.from(false,false,false,false,false,false,false,false,false,false)

Q_SSMT  = array.from(false,false,false,false,false,false,false,false,false,false)

Y_SSMT  = array.from(false,false,false,false,false,false,false,false,false,false)

N_SSMT  = array.from(false,false,false,false,false,false,false,false,false,false)

m_SSMT  = array.from(false,false,false,false,false,false,false,false,false,false)



N_label = array.from("")

D_label = array.from("")

W_label = array.from("")

Q_label = array.from("")

M_label = array.from("")

Y_label = array.from("")

m_label = array.from("")



N_text  = array.from("","","","","","","","")//

D_text  = array.from("","","","","","","","")

W_text  = array.from("","","","","","","","")

Q_text  = array.from("","","","","","","","")

M_text  = array.from("","","","","","","","")

Y_text  = array.from("","","","","","","","")

m_text  = array.from("","","","","","","","")



N_ext   = array.from(0.0,0.0,0.0,0.0)//hmax,lmin,cmax,cmin

D_ext   = array.from(0.0,0.0,0.0,0.0)

W_ext   = array.from(0.0,0.0,0.0,0.0)

Q_ext   = array.from(0.0,0.0,0.0,0.0)

M_ext   = array.from(0.0,0.0,0.0,0.0)

Y_ext   = array.from(0.0,0.0,0.0,0.0)

m_ext   = array.from(0.0,0.0,0.0,0.0)

//xy_ext   = array.from(0.0,0.0,0.0,0.0)

N_bias = array.from("","","")

D_bias = array.from("","","")

W_bias = array.from("","","")

Q_bias = array.from("","","")

M_bias = array.from("","","")

Y_bias = array.from("","","")

m_bias = array.from("","","")

