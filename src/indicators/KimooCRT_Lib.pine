// ==========================================
// 2. EXPORTED FUNCTIONS
// ==========================================

export DayofWeek(int index) =>
    switch
        index == 1 => 'M'
        index == 2 => 'T'
        index == 3 => 'W'
        index == 4 => 'T'
        index == 5 => 'F'
        index == 6 => 'S'
        index == 7 => 'S'
        na(index) => ''

export MS_State_Init() =>
    MS_State.new(ICTMS.new(), ICTMS.new(), MS.new(), ICTMS.new(), ICTMS.new(), MS.new(), ICTMS.new(), ICTMS.new(), MS.new(), array.new<line>(), array.new<label>(), array.new<box>())

export ValidTimeframe(string HTF) =>
    if timeframe.in_seconds(HTF) >= timeframe.in_seconds('D') and timeframe.in_seconds(HTF) > timeframe.in_seconds()
        true
    else
        n1 = timeframe.in_seconds()
        n2 = timeframe.in_seconds(HTF)
        n1 < n2 and math.round(n2 / n1) == n2 / n1

export RemainingTime(string HTF) =>
    if barstate.isrealtime
        timeRemaining = (time_close(HTF) - timenow) / 1000
        days = math.floor(timeRemaining / 86400)
        hours = math.floor((timeRemaining - days * 86400) / 3600)
        minutes = math.floor((timeRemaining - days * 86400 - hours * 3600) / 60)
        seconds = math.floor(timeRemaining - days * 86400 - hours * 3600 - minutes * 60)
        r = str.tostring(seconds, '00')
        if minutes > 0 or hours > 0 or days > 0
            r := str.tostring(minutes, '00') + ':' + r
        if hours > 0 or days > 0
            r := str.tostring(hours, '00') + ':' + r
        if days > 0
            r := str.tostring(days) + 'D ' + r
        r
    else
        'n/a'

export HTFName(string HTF) =>
    formatted = HTF
    seconds = timeframe.in_seconds(HTF)
    if seconds < 60
        formatted := str.tostring(seconds) + 's'
    else if seconds / 60 < 60
        formatted := str.tostring(seconds / 60) + 'm'
    else if seconds / 60 / 60 < 24
        formatted := str.tostring(seconds / 60 / 60) + 'H'
    formatted

export CandleSetHigh(array<Candle> candles, float h) =>
    float _h = h
    if array.size(candles) > 0
        for i = 0 to array.size(candles) - 1 by 1
            Candle c = array.get(candles, i)
            if c.h > _h
                _h := c.h
    _h

export CandleSetLow(array<Candle> candles, float l) =>
    float _l = l
    if array.size(candles) > 0
        for i = 0 to array.size(candles) - 1 by 1
            Candle c = array.get(candles, i)
            if c.l < _l
                _l := c.l
    _l

export CandlesHigh(array<Candle> candles, string htf_mode, string aligned_tf, CandleSet htf_auto) =>
    h = 0.0
    if htf_mode == "Auto" and ValidTimeframe(aligned_tf)
        h := CandleSetHigh(htf_auto.candles, h)
    if array.size(candles) > 0
        for i = 0 to array.size(candles) - 1 by 1
            Candle c = array.get(candles, i)
            if c.h > h
                h := c.h
    h

export CandlesLow(array<Candle> candles, float h, string htf_mode, string aligned_tf, CandleSet htf_auto) =>
    l = h
    if htf_mode == "Auto" and ValidTimeframe(aligned_tf)
        l := CandleSetLow(htf_auto.candles, l)
    if array.size(candles) > 0
        for i = 0 to array.size(candles) - 1 by 1
            Candle c = array.get(candles, i)
            if c.l < l
                l := c.l
    l

export f_is_killzone() =>
    bool lon = not na(time(timeframe.period, "0200-0500", "America/New_York"))
    bool ny_am = not na(time(timeframe.period, "0830-1100", "America/New_York"))
    bool ny_pm = not na(time(timeframe.period, "1330-1600", "America/New_York"))
    lon or ny_am or ny_pm

// FIX P2-WARN: Removed var arrays from exported function to prevent
// shared state bleed across multiple call sites. Arrays are now local.
export f_htf_poi_arrays() =>
    var float[] bull_tops = array.new_float()
    var float[] bull_bots = array.new_float()
    var int[] bull_types = array.new_int()
    var float[] bear_tops = array.new_float()
    var float[] bear_bots = array.new_float()
    var int[] bear_types = array.new_int()
    
    int left = 3
    int right = 3
    int max_pois = 10
    
    ph = ta.pivothigh(high, left, right)
    pl = ta.pivotlow(low, left, right)
    
    if not na(ph)
        idx = right
        c_h = high[idx], c_l = low[idx], c_o = open[idx], c_c = close[idx]
        array.unshift(bear_tops, c_h), array.unshift(bear_bots, math.min(c_o, c_c)), array.unshift(bear_types, 1)
        if c_h > math.max(c_o, c_c)
            array.unshift(bear_tops, c_h), array.unshift(bear_bots, math.max(c_o, c_c)), array.unshift(bear_types, 2)
        array.unshift(bear_tops, c_h), array.unshift(bear_bots, c_h), array.unshift(bear_types, 3)
            
    if not na(pl)
        idx = right
        c_h = high[idx], c_l = low[idx], c_o = open[idx], c_c = close[idx]
        array.unshift(bull_tops, math.max(c_o, c_c)), array.unshift(bull_bots, c_l), array.unshift(bull_types, 1)
        if c_l < math.min(c_o, c_c)
            array.unshift(bull_tops, math.min(c_o, c_c)), array.unshift(bull_bots, c_l), array.unshift(bull_types, 2)
        array.unshift(bull_tops, c_l), array.unshift(bull_bots, c_l), array.unshift(bull_types, 3)

    if high[2] < low[0]
        array.unshift(bull_tops, low[0]), array.unshift(bull_bots, high[2]), array.unshift(bull_types, 4)
    if low[2] > high[0]
        array.unshift(bear_tops, low[2]), array.unshift(bear_bots, high[0]), array.unshift(bear_types, 4)

    if array.size(bull_tops) > 0
        for i = array.size(bull_tops) - 1 to 0
            t = array.get(bull_tops, i), b = array.get(bull_bots, i), ty = array.get(bull_types, i)
            if close < b
                array.remove(bull_tops, i), array.remove(bull_bots, i), array.remove(bull_types, i)
                array.unshift(bear_tops, t), array.unshift(bear_bots, b), array.unshift(bear_types, 5)
    if array.size(bear_tops) > 0
        for i = array.size(bear_tops) - 1 to 0
            t = array.get(bear_tops, i), b = array.get(bear_bots, i), ty = array.get(bear_types, i)
            if close > t
                array.remove(bear_tops, i), array.remove(bear_bots, i), array.remove(bear_types, i)
                array.unshift(bull_tops, t), array.unshift(bull_bots, b), array.unshift(bull_types, 5)

    while array.size(bull_tops) > max_pois
        array.pop(bull_tops), array.pop(bull_bots), array.pop(bull_types)
    while array.size(bear_tops) > max_pois
        array.pop(bear_tops), array.pop(bear_bots), array.pop(bear_types)
        
    [bull_tops, bull_bots, bull_types, bear_tops, bear_bots, bear_types]

export method check_poi_rejection(CandleSet htf_data, float check_high, float check_low, bool is_bullish_setup) =>
    bool poi_found = false
    string poi_reason = ""
    if is_bullish_setup
        if not na(htf_data.poi_bull_tops) and htf_data.poi_bull_tops.size() > 0
            for i = 0 to htf_data.poi_bull_tops.size() - 1
                float t = htf_data.poi_bull_tops.get(i)
                float b = htf_data.poi_bull_bots.get(i)
                int ty = htf_data.poi_bull_types.get(i)
                if math.max(check_low, b) <= math.min(check_high, t)
                    poi_found := true
                    if ty == 1
                        poi_reason := "OrderBlock"
                    else if ty == 2
                        poi_reason := "Rejection Block"
                    else if ty == 3
                        poi_reason := "Swing Low"
                    else if ty == 4
                        poi_reason := "FVG"
                    else if ty == 5
                        poi_reason := "Breaker Block"
                    else if ty == 6
                        poi_reason := "Previous Low"
                    else if ty == 7
                        poi_reason := "HTF Candle Low"
                    break
    else
        if not na(htf_data.poi_bear_tops) and htf_data.poi_bear_tops.size() > 0
            for i = 0 to htf_data.poi_bear_tops.size() - 1
                float t = htf_data.poi_bear_tops.get(i)
                float b = htf_data.poi_bear_bots.get(i)
                int ty = htf_data.poi_bear_types.get(i)
                if math.max(check_low, b) <= math.min(check_high, t)
                    poi_found := true
                    if ty == 1
                        poi_reason := "OrderBlock"
                    else if ty == 2
                        poi_reason := "Rejection Block"
                    else if ty == 3
                        poi_reason := "Swing High"
                    else if ty == 4
                        poi_reason := "FVG"
                    else if ty == 5
                        poi_reason := "Breaker Block"
                    else if ty == 6
                        poi_reason := "Previous High"
                    else if ty == 7
                        poi_reason := "HTF Candle High"
                    break
    [poi_found, poi_reason]

// FIX P1-4: Unified lookback constant — both scan functions now use 20
// so the bias engine and pattern scanner always agree on the same bar.
export f_cisd_scan_crt(int c2_bar, bool is_bullish, bool usebody_for_confirmation) =>
    bool series_broken = false
    bool c2_is_up = close[bar_index - c2_bar] > open[bar_index - c2_bar]
    bool c2_is_down = close[bar_index - c2_bar] < open[bar_index - c2_bar]
    int start_offset = 0
    if is_bullish
        if not c2_is_down
            start_offset := 1
    else
        if not c2_is_up
            start_offset := 1
    float series_level = is_bullish ? -1.0e20 : 1.0e20
    
    // Include the sweep candle's own body/wick in the initial level
    float c2_o = open[bar_index - c2_bar]
    float c2_c = close[bar_index - c2_bar]
    float c2_h = high[bar_index - c2_bar]
    float c2_l = low[bar_index - c2_bar]
    if is_bullish
        series_level := usebody_for_confirmation ? math.max(c2_o, c2_c) : c2_h
    else
        series_level := usebody_for_confirmation ? math.min(c2_o, c2_c) : c2_l

    bool series_found = true // Sweep candle itself starts the series
    // FIXED: Use same constant lookback (20) as f_cisd_scan_nodraw for consistency
    int lookback = 20
    for i = start_offset to lookback
        check_bar = c2_bar - i
        if check_bar < 0
            break
        float o = open[bar_index - check_bar]
        float c = close[bar_index - check_bar]
        float h = high[bar_index - check_bar]
        float l = low[bar_index - check_bar]
        bool is_candle_up = c > o
        bool is_candle_down = c < o
        bool matches = false
        if is_bullish
            if is_candle_down
                matches := true
                float val = usebody_for_confirmation ? math.max(o, c) : h
                if val > series_level
                    series_level := val
        else
            if is_candle_up
                matches := true
                float val = usebody_for_confirmation ? math.min(o, c) : l
                if val < series_level
                    series_level := val
        if matches
            series_found := true
        else
            break
    if series_found
        for i = 0 to (bar_index - c2_bar)
            check_bar = c2_bar + i
            if check_bar > bar_index
                break
            if check_bar == bar_index and not barstate.isconfirmed
                continue
            if is_bullish
                if close[bar_index - check_bar] > series_level
                    series_broken := true
                    break
            else
                if close[bar_index - check_bar] < series_level
                    series_broken := true
                    break
    [series_broken, series_level]

// FIX P1-4: Now matches f_cisd_scan_crt exactly (same lookback = 20)
export f_cisd_scan_nodraw(int c2_bar, bool is_bullish, bool usebody_for_confirmation) =>
    bool series_broken = false
    bool c2_is_up = close[bar_index - c2_bar] > open[bar_index - c2_bar]
    bool c2_is_down = close[bar_index - c2_bar] < open[bar_index - c2_bar]
    int start_offset = 0
    if is_bullish
        if not c2_is_down
            start_offset := 1
    else
        if not c2_is_up
            start_offset := 1
    float series_level = is_bullish ? -1.0e20 : 1.0e20
    
    // Include the sweep candle's own body/wick in the initial level
    float c2_o = open[bar_index - c2_bar]
    float c2_c = close[bar_index - c2_bar]
    float c2_h = high[bar_index - c2_bar]
    float c2_l = low[bar_index - c2_bar]
    if is_bullish
        series_level := usebody_for_confirmation ? math.max(c2_o, c2_c) : c2_h
    else
        series_level := usebody_for_confirmation ? math.min(c2_o, c2_c) : c2_l

    bool series_found = true // Sweep candle itself starts the series
    // FIXED: Unified lookback constant — was 20 already, kept at 20
    int lookback = 20
    for i = start_offset to lookback
        check_bar = c2_bar - i
        if check_bar < 0
            break
        float o = open[bar_index - check_bar]
        float c = close[bar_index - check_bar]
        float h = high[bar_index - check_bar]
        float l = low[bar_index - check_bar]
        bool is_candle_up = c > o
        bool is_candle_down = c < o
        bool matches = false
        if is_bullish
            if is_candle_down
                matches := true
                float val = usebody_for_confirmation ? math.max(o, c) : h
                if val > series_level
                    series_level := val
        else
            if is_candle_up
                matches := true
                float val = usebody_for_confirmation ? math.min(o, c) : l
                if val < series_level
                    series_level := val
        if matches
            series_found := true
        else
            break
    if series_found
        for i = 0 to (bar_index - c2_bar)
            check_bar = c2_bar + i
            if check_bar > bar_index
                break
            if check_bar == bar_index and not barstate.isconfirmed
                continue
            if is_bullish
                if close[bar_index - check_bar] > series_level
                    series_broken := true
                    break
            else
                if close[bar_index - check_bar] < series_level
                    series_broken := true
                    break
    [series_broken, series_level]

export f_bias_engine(bool usebody_for_confirmation) =>
    string htf_period = "1W"
    if timeframe.in_seconds(timeframe.period) <= 3600
        htf_period := "1D"
    [htf_curr_low, htf_curr_high, htf_prev_low, htf_prev_high, htf_start_time] = request.security(syminfo.tickerid, htf_period, [low, high, low[1], high[1], time], lookahead=barmerge.lookahead_on)
    bool sweep_bull = htf_curr_low < htf_prev_low
    bool sweep_bear = htf_curr_high > htf_prev_high
    var string stb = "Neutral"
    var string cisd_stat = "Waiting"
    bool sweep_confirmed_bull = false
    bool sweep_confirmed_bear = false
    float min_val = 1.0e20
    int min_idx = -1
    float max_val = -1.0e20
    int max_idx = -1
    if sweep_bull
        for i = 0 to 500
            // FIX P1-2: Changed < to <= so the pivot bar itself (time[i] == htf_start_time)
            // is included in the scan. Previously it was skipped causing the bias engine
            // to miss the swing low/high formed at the exact HTF candle open.
            if time[i] <= htf_start_time
                break
            if low[i] <= min_val
                min_val := low[i]
                min_idx := bar_index - i
        if min_idx != -1
            [is_broken, lvl] = f_cisd_scan_nodraw(min_idx, true, usebody_for_confirmation)
            if is_broken
                sweep_confirmed_bull := true
    else if sweep_bear
        for i = 0 to 500
            // FIX P1-2: Same fix — include the pivot bar at htf_start_time
            if time[i] <= htf_start_time
                break
            if high[i] >= max_val
                max_val := high[i]
                max_idx := bar_index - i
        if max_idx != -1
            [is_broken, lvl] = f_cisd_scan_nodraw(max_idx, false, usebody_for_confirmation)
            if is_broken
                sweep_confirmed_bear := true
    var MarketStructureNeo currentStructure = MarketStructureNeo.new(high, low, false)
    var cisdLevelsBu = array.new<CisdNeo>()
    var cisdLevelsBe = array.new<CisdNeo>()
    var bool isBullishPullback = false
    var bool isBearishPullback = false
    var float potentialTopPrice = na
    var float potentialBottomPrice = na
    var int bullishBreakIndex = na
    var int bearishBreakIndex = na
    bearishPullbackDetected = close[1] > open[1]
    bullishPullbackDetected = close[1] < open[1]
    if bearishPullbackDetected and not isBearishPullback
        isBearishPullback := true
        potentialTopPrice := open[1]
        bullishBreakIndex := bar_index[1]
    if bullishPullbackDetected and not isBullishPullback
        isBullishPullback := true
        potentialBottomPrice := open[1]
        bearishBreakIndex := bar_index[1]
    if isBullishPullback
        if open < potentialBottomPrice
            potentialBottomPrice := open
            bearishBreakIndex := bar_index
        if (close < open) and (open > potentialBottomPrice)
            potentialBottomPrice := open
            bearishBreakIndex := bar_index     
    if isBearishPullback
        if open > potentialTopPrice
            potentialTopPrice := open
            bullishBreakIndex := bar_index
        if (close > open) and open < potentialTopPrice
            potentialTopPrice := open
            bullishBreakIndex := bar_index      
    if low < currentStructure.bottomPrice
        currentStructure.bottomPrice := low
        currentStructure.isBullish := false
        if isBearishPullback and (bar_index-bullishBreakIndex != 0)
            currentStructure.topPrice := math.max(high[bar_index-bullishBreakIndex],high[bar_index-bullishBreakIndex+1])
            isBearishPullback := false
            cisdLevelsBe.push(CisdNeo.new(potentialTopPrice, false, false))
        else if close[1] > open[1] and close < open
            currentStructure.topPrice := high[1]
            isBearishPullback := false
            cisdLevelsBe.push(CisdNeo.new(potentialTopPrice, false, false))
    if high > currentStructure.topPrice
        currentStructure.isBullish := true
        currentStructure.topPrice := high
        if isBullishPullback and (bar_index-bearishBreakIndex != 0)
            currentStructure.bottomPrice := math.min(low[bar_index-bearishBreakIndex],low[bar_index-bearishBreakIndex+1])
            isBullishPullback := false
            cisdLevelsBu.push(CisdNeo.new(potentialBottomPrice, false, true))
        else if close[1] < open[1] and close > open
            currentStructure.bottomPrice := low[1]
            isBullishPullback := false
            cisdLevelsBu.push(CisdNeo.new(potentialBottomPrice, false, true))
    if array.size(cisdLevelsBu) > 1
        array.shift(cisdLevelsBu)
    if array.size(cisdLevelsBe) > 1
        array.shift(cisdLevelsBe)
    bool cisd_conf_bull = false
    bool cisd_conf_bear = false
    if array.size(cisdLevelsBe) >= 1
        latest = array.get(cisdLevelsBe, 0)
        if close > latest.level and not latest.completed
            cisd_conf_bull := true
            latest.completed := true
            cisdLevelsBu.push(CisdNeo.new(potentialBottomPrice, false, true))
    if array.size(cisdLevelsBu) >= 1
        latest = array.get(cisdLevelsBu, 0)
        if close < latest.level and not latest.completed
            cisd_conf_bear := true
            latest.completed := true
            cisdLevelsBe.push(CisdNeo.new(potentialTopPrice, false, false))
    
    if sweep_confirmed_bear
        bool found = false
        if array.size(cisdLevelsBe) > 0
            last_lvl = array.get(cisdLevelsBe, array.size(cisdLevelsBe)-1)
            if math.abs(last_lvl.level - max_val) < syminfo.mintick * 10
                last_lvl.level := max_val
                found := true
        if not found
            cisdLevelsBe.push(CisdNeo.new(max_val, false, false))
            if array.size(cisdLevelsBe) > 1
                array.shift(cisdLevelsBe)

    if sweep_confirmed_bull
        bool found = false
        if array.size(cisdLevelsBu) > 0
            last_lvl = array.get(cisdLevelsBu, array.size(cisdLevelsBu)-1)
            if math.abs(last_lvl.level - min_val) < syminfo.mintick * 10
                last_lvl.level := min_val
                found := true
        if not found
            cisdLevelsBu.push(CisdNeo.new(min_val, false, true))
            if array.size(cisdLevelsBu) > 1
                array.shift(cisdLevelsBu)

    if sweep_confirmed_bull
        stb := "Bullish"
        cisd_stat := "Confirmed"
    else if sweep_confirmed_bear
        stb := "Bearish"
        cisd_stat := "Confirmed"
    else if cisd_conf_bull
        stb := "Bullish"
        cisd_stat := "Confirmed"
    else if cisd_conf_bear
        stb := "Bearish"
        cisd_stat := "Confirmed"
    else
        if sweep_bull or sweep_bear
            cisd_stat := "Pending"
            if sweep_bull and stb == "Bullish"
                stb := "Bullish"
            if sweep_bear and stb == "Bearish"
                stb := "Bearish"
        else
            cisd_stat := "Waiting"
    [stb, cisd_stat]

export f_get_parent_tf(string child_tf) =>
    sec = timeframe.in_seconds(child_tf)
    m = sec / 60
    ret = "1M"
    if m <= 1
        ret := "15"
    else if m <= 3
        ret := "30"
    else if m <= 5
        ret := "60"
    else if m <= 15
        ret := "240"
    else if m <= 30
        ret := "360"
    else if m <= 60
        ret := "1D"
    else if m <= 240
        ret := "1W"
    else if m <= 1440
        ret := "1M"
    else
        ret := "3M"
    ret

export f_fractal_check() =>
    bull = low < low[1] and close > low[1]
    bear = high > high[1] and close < high[1]
    [bull, bear]

export f_fractal_check_prev() =>
    [bull, bear] = f_fractal_check()
    [bull[1], bear[1]]

export f_get_setup_rating(CandleSet htf_auto, bool is_bull, bool in_kz, string bias_val, int qt_val, bool ssmt_bull, bool ssmt_bear, bool entry_in_ote, bool volume_conf, bool htf_aligned, bool high_prob_dow, bool sweep_quality) =>
    int points = 0
    string notes = ""
    
    if htf_auto.crt_active
        bool bias_aligned = (is_bull and bias_val == "Bullish") or (not is_bull and bias_val == "Bearish")
        if bias_aligned
            points += 3
            notes += "Bias "
        else if bias_val != "Neutral"
            points -= 1
            
        if htf_auto.crt_at_poi
            points += 2
            notes += "POI "
            
        bool ssmt_aligned = (is_bull and ssmt_bull) or (not is_bull and ssmt_bear)
        bool ssmt_opposing = (is_bull and ssmt_bear and not ssmt_bull) or (not is_bull and ssmt_bull and not ssmt_bear)
        if ssmt_aligned
            points += 2
            notes += "SMT "
        if ssmt_opposing
            points -= 2
            notes += "!SMT "
            
        if entry_in_ote
            points += 2
            notes += "OTE "
            
        if htf_aligned
            points += 2
            notes += "HTF "
            
        if in_kz
            points += 1
            notes += "KZ "
            
        bool qt_aligned = (is_bull and (qt_val % 4 == 0 or qt_val % 4 == 1)) or (not is_bull and (qt_val % 4 == 2 or qt_val % 4 == 3))
        if qt_aligned
            points += 1
            notes += "Cycle "
            
        if volume_conf
            points += 1
            notes += "VOL "
            
        if high_prob_dow
            points += 1
            notes += "DOW "

        if sweep_quality
            points += 1
            notes += "SWP "
            
    int stars = 0
    if points >= 13
        stars := 5
    else if points >= 10
        stars := 4
    else if points >= 8
        stars := 3
    else if points >= 6
        stars := 2
    else if points >= 4
        stars := 1
    else
        stars := 0
        
    [stars, notes]

// FIX P2-WARN: Use math.round() instead of int() truncation so values 1-9%
// correctly show 1 filled block instead of 0.
export f_render_bar(float percent) =>
    string bar = ""
    int filled_chars = math.round(percent / 10)
    for i = 1 to 10
        bar += i <= filled_chars ? "■" : "□"
    bar + " " + str.tostring(math.round(percent)) + "%"

export f_get_qt_data(int minsFromDayStart) =>
    int m_calc = timeframe.in_seconds() / 60
    string c_name = ""
    float c_perc = 0.0
    int c_phase_idx = 0
    if m_calc <= 2
        c_name := "Micro Cycle", c_perc := (minsFromDayStart % 15) / 15.0 * 100
    else if m_calc <= 10
        c_name := "90m Cycle", c_perc := (minsFromDayStart % 90) / 90.0 * 100
    else if m_calc <= 45
        c_name := "Daily Cycle", c_perc := (minsFromDayStart / 1440.0) * 100
    else
        // For longer cycles, we maintain UTC-based time logic
        if m_calc <= 120
            c_name := "Weekly Cycle", c_perc := (time % 604800000) / 604800000.0 * 100
        else if m_calc <= 360
            c_name := "Monthly Cycle", c_perc := (time % 2592000000) / 2592000000.0 * 100
        else if timeframe.isdaily
            c_name := "Quarterly Cycle", c_perc := (time % 7776000000) / 7776000000.0 * 100
        else if timeframe.isweekly
            c_name := "Yearly Cycle", c_perc := (time % 31536000000) / 31536000000.0 * 100
    c_phase_idx := int(c_perc / 25)
    string p_name = c_phase_idx == 0 ? "Accumulation" : c_phase_idx == 1 ? "Manipulation" : c_phase_idx == 2 ? "Distribution" : "Cont/Rev"
    [c_name, c_perc, p_name]

export f_check_ote(float high_val, float low_val, float price, bool is_bull) =>
    float swing_range = high_val - low_val
    float ote_bull_top = low_val + swing_range * 0.79
    float ote_bull_bot = low_val + swing_range * 0.62
    float ote_bear_top = high_val - swing_range * 0.62
    float ote_bear_bot = high_val - swing_range * 0.79
    is_bull ? (price >= ote_bull_bot and price <= ote_bull_top) : (price >= ote_bear_bot and price <= ote_bear_top)

export f_check_sweep_quality(float stop_level, float pdh, float pdl, float pwh, float pwl, float pmh, float pml, bool is_bull) =>
    is_bull ? (stop_level <= pdl or stop_level <= pwl or stop_level <= pml) : (stop_level >= pdh or stop_level >= pwh or stop_level >= pmh)

export f_calc_rr(float entry, float sl, float tp) =>
    risk = math.abs(entry - sl)
    reward = math.abs(tp - entry)
    risk == 0 ? 0 : reward / risk

export f_manage_level_box(box _b, int _l, float _lvl, int _r, string _txt, color _clr, string labelSizeInput) =>
    box res = _b
    if na(res)
        res := box.new(_l, _lvl, _r, _lvl, xloc=xloc.bar_time, border_color=_clr, bgcolor=color.new(color.red,100), text=_txt, text_color=_clr, text_valign=text.align_bottom, text_halign=text.align_right, text_size=labelSizeInput, border_style=line.style_solid)
    else
        box.set_left(res, _l)
        box.set_top(res, _lvl)
        box.set_bottom(res, _lvl)
        box.set_right(res, _r)
        box.set_border_color(res, _clr)
        box.set_text_color(res, _clr)
        box.set_text(res, _txt)
    res

export method update_htf_state(SessionState s, bool new_period) =>
    if new_period
        s.h := s.cur_h, s.ht := s.cur_ht
        s.l := s.cur_l, s.lt := s.cur_lt
        s.cur_h := high, s.cur_ht := time
        s.cur_l := low, s.cur_lt := time
        s.hs := false, s.ls := false
    else
        if high > s.cur_h
            s.cur_h := high, s.cur_ht := time
        if low < s.cur_l
            s.cur_l := low, s.cur_lt := time
    if not s.hs and not na(s.h) and high > s.h
        s.hs := true, s.hst := time
    if not s.ls and not na(s.l) and low < s.l
        s.ls := true, s.lst := time
    s

export method update_session_state(SessionState s, bool active) =>
    if active
        if not active[1]
            s.h := high, s.ht := time
            s.l := low, s.lt := time
            s.hs := false, s.ls := false
        else
            if high > s.h
                s.h := high, s.ht := time
            if low < s.l
                s.l := low, s.lt := time
    else
        if not s.hs and not na(s.h) and high > s.h
            s.hs := true, s.hst := time
        if not s.ls and not na(s.l) and low < s.l
            s.ls := true, s.lst := time
    s

export method render_state(SessionState s, bool show, string txt_h, string txt_l, color c, int dt, string labelSizeInput) =>
    if show and not na(s.h)
        s.bh := f_manage_level_box(s.bh, s.ht, s.h, s.hs ? s.hst : time + 15*dt, txt_h, c, labelSizeInput)
        s.bl := f_manage_level_box(s.bl, s.lt, s.l, s.ls ? s.lst : time + 15*dt, txt_l, c, labelSizeInput)
    else
        box.delete(s.bh), s.bh := box(na)
        box.delete(s.bl), s.bl := box(na)
    s

export f_check_filters(bool is_bull, float h, float l, CandleSet cs, Settings settings, string active_htf_bias, bool sweep_in_kz) =>
    bool f_time = settings.filter_time
    bool f_poi = settings.filter_poi
    bool f_bias = settings.filter_bias
    bool any_filter = f_time or f_poi or f_bias
    
    bool is_valid = false
    color c_col = color(na)
    string c_lbl = ""
    
    if not any_filter
        is_valid := true
    else
        bool m_time = f_time and sweep_in_kz
        [poi_hit, poi_reason] = cs.check_poi_rejection(h, l, is_bull)
        bool m_poi = f_poi and poi_hit
        bool m_bias = f_bias and (active_htf_bias == (is_bull ? "Bullish" : "Bearish"))
        
        if m_poi
            is_valid := true, c_col := #8B4513, c_lbl := "⌛HTF POI\n" + poi_reason
        else if m_bias
            is_valid := true, c_col := color.lime, c_lbl := "⌛HTF BIAS"
        else if m_time
            is_valid := true, c_col := color.blue, c_lbl := "⌛KillZone"
            
    [is_valid, c_col, c_lbl]

// Helper to reset all CRT state fields consistently in one place.
// FIX P1-WARN: Centralised reset prevents missing a field when new CRT
// variants are added in the future.
export method resetCRT(CandleSet cs, bool is_bull, float high_level, float low_level, float entry_level, float stop_level, int high_idx, int low_idx, int id, string crt_type_str, int o_time, color col, string lbl) =>
    cs.crt_active := true
    cs.crt_bull := is_bull
    cs.crt_high_level := high_level
    cs.crt_low_level := low_level
    cs.crt_entry_level := entry_level
    cs.crt_stop_level := stop_level
    cs.crt_high_idx := high_idx
    cs.crt_low_idx := low_idx
    cs.crt_id := id
    cs.crt_type := crt_type_str
    cs.crt_close_outside_count := 0
    cs.crt_swept_high := false
    cs.crt_swept_low := false
    cs.last_checked_candle_time := o_time
    cs.crt_color := col
    cs.crt_label_text := lbl
    // FIX P1-3: Capture the CRT range at formation for stable invalidation threshold
    cs.crt_formation_range := high_level - low_level
    cs.crt_confirmation_bar := bar_index
    cs

export method ScanPatterns(CandleSet candleSet, Settings settings, string active_htf_bias, bool usebody_for_confirmation) =>
    bool cisd_broken_any = false
    bool is_in_kz = f_is_killzone()
    if candleSet.candles.size() >= 2
        Candle current_candle = candleSet.candles.get(0)   
        Candle last_closed = candleSet.candles.get(1)      
        
        start_bar = current_candle.o_idx
        if not na(start_bar)
            if na(candleSet.fractal_start_bar) or start_bar != candleSet.fractal_start_bar
                candleSet.fractal_detected := false
                candleSet.fractal_start_bar := start_bar

            if current_candle.l < last_closed.l
                current_candle.is_bullish_fractal := true
                if not candleSet.fractal_detected
                    candleSet.fractal_detected := true

            if current_candle.h > last_closed.h
                current_candle.is_bearish_fractal := true
                if not candleSet.fractal_detected
                    candleSet.fractal_detected := true

            // Structural invalidation for setups that are NOT entered in a trade.
            // If entered in a trade, invalidation is strictly deferred to TP2/SL hit.
            if candleSet.crt_active and not candleSet.trade_is_live and bar_index > candleSet.crt_confirmation_bar
                if candleSet.crt_type == "Classic"
                    if candleSet.candles.size() > 1
                        Candle last_closed_crt = candleSet.candles.get(1)
                        if last_closed_crt.o_time != candleSet.last_checked_candle_time
                            candleSet.last_checked_candle_time := last_closed_crt.o_time
                            float threshold = 0.0 // Strict invalidation
                            float top_ext = math.max(candleSet.crt_high_level, candleSet.crt_stop_level)
                            float bot_ext = math.min(candleSet.crt_low_level, candleSet.crt_stop_level)
                            
                            bool wick_outside = false
                            if candleSet.crt_bull
                                wick_outside := last_closed_crt.l < bot_ext + threshold or last_closed_crt.h > top_ext - threshold
                            else
                                wick_outside := last_closed_crt.h > top_ext - threshold or last_closed_crt.l < bot_ext + threshold
                            
                            if wick_outside
                                candleSet.crt_active := false

                            candleSet.crt_swept_high := candleSet.crt_swept_high or last_closed_crt.h > top_ext - threshold
                            candleSet.crt_swept_low := candleSet.crt_swept_low or last_closed_crt.l < bot_ext + threshold

                    float threshold_curr = 0.0
                    float top_ext_curr = math.max(candleSet.crt_high_level, candleSet.crt_stop_level)
                    float bot_ext_curr = math.min(candleSet.crt_low_level, candleSet.crt_stop_level)
                    Candle curr_crt = candleSet.candles.get(0)
                    if curr_crt.h > top_ext_curr - threshold_curr or curr_crt.l < bot_ext_curr + threshold_curr
                        candleSet.crt_active := false
                    candleSet.crt_swept_high := candleSet.crt_swept_high or curr_crt.h > top_ext_curr - threshold_curr
                    candleSet.crt_swept_low := candleSet.crt_swept_low or curr_crt.l < bot_ext_curr + threshold_curr
                else
                    float top_ext = math.max(candleSet.crt_high_level, candleSet.crt_stop_level)
                    float bot_ext = math.min(candleSet.crt_low_level, candleSet.crt_stop_level)
                    if high > top_ext or low < bot_ext
                        candleSet.crt_active := false

            // Invalidation is now handled externally by CRT-Algo (+Ultimate).pine based on SL/TP2 hit
            if not candleSet.crt_active and settings.use_classic_crt
                int lookback_limit = 10
                int search_end = math.min(candleSet.candles.size() - 1, lookback_limit)
                
                int best_idx = -1
                bool best_is_bull = false

                for i = 1 to search_end
                    Candle c_range = candleSet.candles.get(i)
                    
                    // No cooldown check here - allow detection of new setups immediately
                    if false
                        continue
                        
                    bool is_valid_range = true
                    
                    if i > 1
                        for k = 1 to i - 1
                            Candle c_inner = candleSet.candles.get(k)
                            if c_inner.h > c_range.h or c_inner.l < c_range.l
                                is_valid_range := false
                                break
                    
                    if is_valid_range
                        if current_candle.l < c_range.l and current_candle.h <= c_range.h
                            best_idx := i
                            best_is_bull := true
                        else if current_candle.h > c_range.h and current_candle.l >= c_range.l
                            best_idx := i
                            best_is_bull := false

                if best_idx != -1
                    Candle c_range = candleSet.candles.get(best_idx)
                    if best_is_bull
                        [cisd_broken, lvl] = f_cisd_scan_crt(current_candle.l_idx, true, usebody_for_confirmation)
                        cisd_broken_any := cisd_broken_any or cisd_broken
                        // Trigger only on NEW break OR NEW sweep ID
                        bool is_new_break = cisd_broken and (not candleSet.cisd_latched or c_range.o_idx != candleSet.crt_id)
                        if is_new_break and not candleSet.crt_swept_low
                            bool sweep_in_kz = is_in_kz[math.max(0, bar_index - current_candle.l_idx)]
                            [is_valid, c_col, c_lbl] = f_check_filters(true, current_candle.h, current_candle.l, candleSet, settings, active_htf_bias, sweep_in_kz)
                            if is_valid
                                candleSet.resetCRT(true, c_range.h, c_range.l, lvl, current_candle.l, c_range.h_idx, c_range.l_idx, c_range.o_idx, "Classic", current_candle.o_time, c_col, c_lbl)
                                [poi_hit_check, _] = candleSet.check_poi_rejection(candleSet.crt_high_level, candleSet.crt_low_level, true)
                                candleSet.crt_at_poi := poi_hit_check
                    else
                        [cisd_broken, lvl] = f_cisd_scan_crt(current_candle.h_idx, false, usebody_for_confirmation)
                        cisd_broken_any := cisd_broken_any or cisd_broken
                        bool is_new_break = cisd_broken and (not candleSet.cisd_latched or c_range.o_idx != candleSet.crt_id)
                        if is_new_break and not candleSet.crt_swept_high
                            bool sweep_in_kz = is_in_kz[math.max(0, bar_index - current_candle.h_idx)]
                            [is_valid, c_col, c_lbl] = f_check_filters(false, current_candle.h, current_candle.l, candleSet, settings, active_htf_bias, sweep_in_kz)
                            if is_valid
                                candleSet.resetCRT(false, c_range.h, c_range.l, lvl, current_candle.h, c_range.h_idx, c_range.l_idx, c_range.o_idx, "Classic", current_candle.o_time, c_col, c_lbl)
                                [poi_hit_check, _] = candleSet.check_poi_rejection(candleSet.crt_high_level, candleSet.crt_low_level, false)
                                candleSet.crt_at_poi := poi_hit_check

            if not candleSet.crt_active and settings.use_classic_crt and candleSet.candles.size() >= 3
                Candle c1 = candleSet.candles.get(1)
                Candle c2 = candleSet.candles.get(2)
                
                if true
                    if c1.l < c2.l and c1.c > c2.l
                        int pid = c2.o_idx
                        if pid != candleSet.crt_id
                            [cisd_broken, lvl] = f_cisd_scan_crt(c1.l_idx, true, usebody_for_confirmation)
                            cisd_broken_any := cisd_broken_any or cisd_broken
                            bool is_new_break = cisd_broken and (not candleSet.cisd_latched or pid != candleSet.crt_id)
                            if is_new_break
                                bool sweep_in_kz = is_in_kz[math.max(0, bar_index - c1.l_idx)]
                                [is_valid, c_col, c_lbl] = f_check_filters(true, c1.h, c1.l, candleSet, settings, active_htf_bias, sweep_in_kz)
                                if is_valid
                                    candleSet.resetCRT(true, c2.h, c2.l, lvl, c1.l, c2.h_idx, c2.l_idx, pid, "Classic", c1.o_time, c_col, c_lbl)
                                    [poi_hit_check, _] = candleSet.check_poi_rejection(candleSet.crt_high_level, candleSet.crt_low_level, true)
                                    candleSet.crt_at_poi := poi_hit_check
                    
                    if c1.h > c2.h and c1.c < c2.h
                        int pid = c2.o_idx
                        if pid != candleSet.crt_id
                            [cisd_broken, lvl] = f_cisd_scan_crt(c1.h_idx, false, usebody_for_confirmation)
                            cisd_broken_any := cisd_broken_any or cisd_broken
                            bool is_new_break = cisd_broken and (not candleSet.cisd_latched or pid != candleSet.crt_id)
                            if is_new_break
                                bool sweep_in_kz = is_in_kz[math.max(0, bar_index - c1.h_idx)]
                                [is_valid, c_col, c_lbl] = f_check_filters(false, c1.h, c1.l, candleSet, settings, active_htf_bias, sweep_in_kz)
                                if is_valid
                                    candleSet.resetCRT(false, c2.h, c2.l, lvl, c1.h, c2.h_idx, c2.l_idx, pid, "Classic", c1.o_time, c_col, c_lbl)
                                    [poi_hit_check, _] = candleSet.check_poi_rejection(candleSet.crt_high_level, candleSet.crt_low_level, false)
                                    candleSet.crt_at_poi := poi_hit_check
    candleSet.cisd_latched := cisd_broken_any
    candleSet

// ==========================================
// 3. EXPORTED METHODS
// ==========================================

export method Monitor(CandleSet candleSet, float t2_o, float t2_c, float t2_h, float t2_l, float t3_o, float t3_c, float t3_h, float t3_l, Settings settings) =>
    HTFBarTime = time(candleSet.settings.htf, 'America/New_York')
    isNewHTFCandle = ta.change(HTFBarTime) > 0

    if isNewHTFCandle
        Candle candle = Candle.new()
        candle.o := open
        candle.c := close
        candle.h := high
        candle.l := low
        candle.o_time := time
        candle.o_idx := bar_index
        candle.c_idx := bar_index
        candle.h_idx := bar_index
        candle.l_idx := bar_index
        candle.dow := switch
            candleSet.settings.htf == '1D' => DayofWeek(dayofweek(time_tradingday, "America/New_York"))
            str.tonumber(candleSet.settings.htf) < 60 => str.format_time(candle.o_time, 'HH:mm', 'America/New_York')
            str.tonumber(candleSet.settings.htf) >= 60 => str.format_time(candle.o_time, 'HH:mm', 'America/New_York')
            candleSet.settings.htf == '1M' => str.format_time(candle.o_time, 'M', 'America/New_York')
            => ''
        bull = candle.c > candle.o

        if candleSet.settings.show
            candle.body := box.new(bar_index, math.max(candle.o, candle.c), bar_index + 2, math.min(candle.o, candle.c), bull ? settings.bull_border : settings.bear_border, 1, bgcolor = bull ? settings.bull_body : settings.bear_body)
            candle.wick_up := line.new(bar_index + 1, candle.h, bar_index, math.max(candle.o, candle.c), color = bull ? settings.bull_wick : settings.bear_wick)
            candle.wick_down := line.new(bar_index + 1, math.min(candle.o, candle.c), bar_index, candle.l, color = bull ? settings.bull_wick : settings.bear_wick)
        else
            candle.body := box(na)
            candle.wick_up := line(na)
            candle.wick_down := line(na)

        candle.t2_o := t2_o
        candle.t2_c := t2_c
        candle.t2_h := t2_h
        candle.t2_l := t2_l
        candle.t3_o := t3_o
        candle.t3_c := t3_c
        candle.t3_h := t3_h
        candle.t3_l := t3_l

        candleSet.candles.unshift(candle)

        if candleSet.candles.size() > candleSet.settings.max_display
            Candle delCandle = array.pop(candleSet.candles)
            box.delete(delCandle.body)
            line.delete(delCandle.wick_up)
            line.delete(delCandle.wick_down)
            if not na(delCandle.dow_label)
                label.delete(delCandle.dow_label)
            if not na(delCandle.swing_high_line)
                line.delete(delCandle.swing_high_line)
            if not na(delCandle.swing_low_line)
                line.delete(delCandle.swing_low_line)
            if not na(delCandle.eq_line)
                line.delete(delCandle.eq_line)
            if not na(delCandle.sweep_high)
                line.delete(delCandle.sweep_high)
            if not na(delCandle.sweep_low)
                line.delete(delCandle.sweep_low)
            if not na(delCandle.smt_line)
                line.delete(delCandle.smt_line)
            if not na(delCandle.smt_label)
                label.delete(delCandle.smt_label)
    candleSet

export method Update(CandleSet candleSet, float t2_o, float t2_c, float t2_h, float t2_l, float t3_o, float t3_c, float t3_h, float t3_l, Settings settings, bool psp_show, bool psp_t2_inv, color psp_bull_color, color psp_bear_color, color tpd_bull_color, color tpd_bear_color) =>
    if candleSet.candles.size() > 0
        Candle candle = candleSet.candles.first()
        candle.h_idx := high > candle.h ? bar_index : candle.h_idx
        candle.h := high > candle.h ? high : candle.h
        candle.l_idx := low < candle.l ? bar_index : candle.l_idx
        candle.l := low < candle.l ? low : candle.l
        candle.c := close
        candle.c_idx := bar_index

        candle.t2_o := t2_o
        candle.t2_c := t2_c
        candle.t2_h := t2_h
        candle.t2_l := t2_l
        candle.t3_o := t3_o
        candle.t3_c := t3_c
        candle.t3_h := t3_h
        candle.t3_l := t3_l

        bull = candle.c > candle.o

        if candleSet.settings.show
            box.set_top(candle.body, candle.o)
            box.set_bottom(candle.body, candle.c)
            box.set_bgcolor(candle.body, bull ? settings.bull_body : settings.bear_body)
            box.set_border_color(candle.body, bull ? settings.bull_border : settings.bear_border)
            line.set_color(candle.wick_up, bull ? settings.bull_wick : settings.bear_wick)
            line.set_color(candle.wick_down, bull ? settings.bull_wick : settings.bear_wick)
            line.set_y1(candle.wick_up, candle.h)
            line.set_y2(candle.wick_up, math.max(candle.o, candle.c))
            line.set_y1(candle.wick_down, candle.l)
            line.set_y2(candle.wick_down, math.min(candle.o, candle.c))

        if psp_show
            bool main_bull = candle.c > candle.o
            bool main_bear = candle.c < candle.o
            bool t2_bull = psp_t2_inv ? (candle.t2_c < candle.t2_o) : (candle.t2_c > candle.t2_o)
            bool t2_bear = psp_t2_inv ? (candle.t2_c > candle.t2_o) : (candle.t2_c < candle.t2_o)
            
            if main_bear and t2_bull
                candle.is_psp_bull := true
                box.set_bgcolor(candle.body, psp_bull_color)
            else
                candle.is_psp_bull := false
            
            if main_bull and t2_bear
                candle.is_psp_bear := true
                box.set_bgcolor(candle.body, psp_bear_color)
            else
                candle.is_psp_bear := false
            
            if psp_show and candleSet.candles.size() >= 3
                Candle c1 = candleSet.candles.get(1)
                Candle c2 = candleSet.candles.get(2)
                Candle c0 = candleSet.candles.get(0)
                
                if c1.is_psp_bull or c1.is_psp_bear
                    bool main_gap_up = c0.o > c2.c
                    bool main_gap_down = c0.o < c2.c
                    bool t2_gap_up = false
                    bool t2_gap_down = false
                    if psp_t2_inv
                        t2_gap_up := c0.t2_o < c2.t2_c
                        t2_gap_down := c0.t2_o > c2.t2_c
                    else
                        t2_gap_up := c0.t2_o > c2.t2_c
                        t2_gap_down := c0.t2_o < c2.t2_c
                    bool tpd_condition = (main_gap_up and t2_gap_down) or (main_gap_down and t2_gap_up)
                    if c1.is_psp_bull
                        c1.is_tpd_bull := tpd_condition
                        if candleSet.settings.show
                            box.set_bgcolor(c1.body, tpd_condition ? tpd_bull_color : psp_bull_color)
                    if c1.is_psp_bear
                        c1.is_tpd_bear := tpd_condition
                        if candleSet.settings.show
                            box.set_bgcolor(c1.body, tpd_condition ? tpd_bear_color : psp_bear_color)
    candleSet

export method FindImbalance(CandleSet candleSet, Settings settings) =>
    if candleSet.imbalances.size() > 0
        for i = candleSet.imbalances.size() - 1 to 0 by 1
            Imbalance del = candleSet.imbalances.get(i)
            if not na(del.b)
                box.delete(del.b)
            candleSet.imbalances.pop()

    if candleSet.settings.show and candleSet.candles.size() > 3 and settings.fvg_show
        for i = 0 to candleSet.candles.size() - 3 by 1
            candle1 = candleSet.candles.get(i)
            candle2 = candleSet.candles.get(i + 2)
            candle3 = candleSet.candles.get(i + 1)

            if candle1.l > candle2.h and math.min(candle1.o, candle1.c) > math.max(candle2.o, candle2.c)
                Imbalance imb = Imbalance.new(na, i * 10 + 1, candle1.l, candle2.h)
                candleSet.imbalances.push(imb)
            if candle1.h < candle2.l and math.max(candle1.o, candle1.c) < math.min(candle2.o, candle2.c)
                Imbalance imb = Imbalance.new(na, i * 10 + 1, candle2.l, candle1.h)
                candleSet.imbalances.push(imb)
            
            box temp = box.copy(candle3.body)
            box.delete(candle3.body)
            candle3.body := temp

            if not na(candle3.sweep_high)
                line.delete(candle3.sweep_high)
                candle3.sweep_high := na
            if not na(candle3.sweep_low)
                line.delete(candle3.sweep_low)
                candle3.sweep_low := na

    if candleSet.settings.show and candleSet.candles.size() > 2 and settings.vi_show
        for i = 0 to candleSet.candles.size() - 2 by 1
            candle1 = candleSet.candles.get(i)
            candle2 = candleSet.candles.get(i + 1)
            if candle1.l < candle2.h and math.min(candle1.o, candle1.c) > math.max(candle2.o, candle2.c)
                Imbalance imb = Imbalance.new(na, i * 10 + 2, math.min(candle1.o, candle1.c), math.max(candle2.o, candle2.c))
                candleSet.imbalances.push(imb)
            if candle1.h > candle2.l and math.max(candle1.o, candle1.c) < math.min(candle2.o, candle2.c)
                Imbalance imb = Imbalance.new(na, i * 10 + 2, math.max(candle1.o, candle1.c), math.min(candle2.o, candle2.c))
                candleSet.imbalances.push(imb)
    candleSet

export method DetectSwings(CandleSet candleSet) =>
    if candleSet.settings.show and candleSet.candles.size() >= 2
        for i = 1 to candleSet.candles.size() - 1
            Candle this_candle = candleSet.candles.get(i)
            Candle next_candle = candleSet.candles.get(i - 1)
            if i > 1
                bool is_swing_high = next_candle.h > this_candle.h and next_candle.c < this_candle.h
                this_candle.is_swing_high := is_swing_high
                bool is_swing_low = next_candle.l < this_candle.l and next_candle.c > this_candle.l
                this_candle.is_swing_low := is_swing_low
                if not is_swing_high and not na(this_candle.swing_high_line)
                    line.delete(this_candle.swing_high_line)
                    this_candle.swing_high_line := na
                if not is_swing_low and not na(this_candle.swing_low_line)
                    line.delete(this_candle.swing_low_line)
                    this_candle.swing_low_line := na
            candleSet.candles.set(i, this_candle)
    candleSet

export method UpdateTime(CandleSet candleSet, Settings settings) =>
    if settings.htf_timer_show and (barstate.isrealtime or barstate.islast)
        string tmr = '[' + RemainingTime(candleSet.settings.htf) + ']'
        if not na(candleSet.tfTimerTop)
            candleSet.tfTimerTop.set_text(tmr)
        if not na(candleSet.tfTimerBottom)
            candleSet.tfTimerBottom.set_text(tmr)
    candleSet

export method Reorder(CandleSet candleSet, int offset, Settings settings, bool show_swing_lines, string confirmed_swing_style, string potential_swing_style, color swing_high_color, color swing_color, int swing_line_width, bool show_eq_line, color eq_line_color, int eq_line_width, string eq_line_style_input, bool htf_label_bold, string htf_mode, string aligned_tf) =>
    color color_transparent = #ffffff00
    
    confirmed_swing_style_value = confirmed_swing_style == "Solid" ? line.style_solid : confirmed_swing_style == "Dashed" ? line.style_dashed : line.style_dotted
    potential_swing_style_value = potential_swing_style == "Solid" ? line.style_solid : potential_swing_style == "Dashed" ? line.style_dashed : line.style_dotted
    eq_line_style_value = eq_line_style_input == "Solid" ? line.style_solid : eq_line_style_input == "Dashed" ? line.style_dashed : line.style_dotted

    if candleSet.settings.show
        set_size = candleSet.candles.size()
        if set_size > 0
            for i = set_size - 1 to 0 by 1
                Candle candle = candleSet.candles.get(i)
                t_buffer = offset + (settings.width + settings.buffer) * (set_size - i - 1)
                
                box.set_left(candle.body, bar_index + t_buffer)
                box.set_right(candle.body, bar_index + settings.width + t_buffer)
                line.set_x1(candle.wick_up, bar_index + settings.width / 2 + t_buffer)
                line.set_x2(candle.wick_up, bar_index + settings.width / 2 + t_buffer)
                line.set_x1(candle.wick_down, bar_index + settings.width / 2 + t_buffer)
                line.set_x2(candle.wick_down, bar_index + settings.width / 2 + t_buffer)

                if not na(candle.sweep_high)
                    x2 = bar_index + t_buffer + settings.width + settings.width
                    t_buffer_prev = offset + ((settings.width+settings.buffer)*(set_size-(i+1)-1))
                    x1 = bar_index + t_buffer_prev + settings.width/2
                    line.set_x1(candle.sweep_high, x1)
                    line.set_x2(candle.sweep_high, x2)
                if not na(candle.sweep_low)
                    x2 = bar_index + t_buffer + settings.width + settings.width
                    t_buffer_prev = offset + ((settings.width+settings.buffer)*(set_size-(i+1)-1))
                    x1 = bar_index + t_buffer_prev + settings.width/2
                    line.set_x1(candle.sweep_low, x1)
                    line.set_x2(candle.sweep_low, x2)

                if settings.daily_name
                    if not na(candle.dow_label)
                        candle.dow_label.set_y(candle.l)
                        candle.dow_label.set_x(bar_index + settings.width / 2 + t_buffer)
                        candle.dow_label.set_text(candle.dow)
                    else
                        candle.dow_label := label.new(bar_index + settings.width / 2 + t_buffer, candle.l, candle.dow, color = color_transparent, textcolor = settings.dow_color, style = label.style_label_up, size = settings.dow_size, text_font_family = font.family_monospace)
                
                if show_swing_lines and i >= 1
                    Candle next_candle = candleSet.candles.get(i - 1)
                    bool is_potential_high = i == 1 and next_candle.h > candle.h
                    bool is_confirmed_high = i > 1 and next_candle.h > candle.h and next_candle.c < candle.h
                    bool is_potential_low = i == 1 and next_candle.l < candle.l
                    bool is_confirmed_low = i > 1 and next_candle.l < candle.l and next_candle.c > candle.l
                    
                    if is_potential_high or is_confirmed_high
                        int next_buffer = offset + (settings.width + settings.buffer) * (set_size - (i - 1) - 1)
                        int line_start = bar_index + settings.width / 2 + t_buffer
                        int line_end = bar_index + next_buffer + settings.width
                        string line_style = is_confirmed_high ? confirmed_swing_style_value : potential_swing_style_value
                        if na(candle.swing_high_line)
                            candle.swing_high_line := line.new(line_start, candle.h, line_end, candle.h, color=swing_high_color, width=swing_line_width, style=line_style)
                        else
                            line.set_x1(candle.swing_high_line, line_start)
                            line.set_y1(candle.swing_high_line, candle.h)
                            line.set_x2(candle.swing_high_line, line_end)
                            line.set_y2(candle.swing_high_line, candle.h)
                            line.set_style(candle.swing_high_line, line_style)
                    else
                        if i > 1 and not na(candle.swing_high_line)
                            line.delete(candle.swing_high_line)
                            candle.swing_high_line := na

                    if is_potential_low or is_confirmed_low
                        int next_buffer = offset + (settings.width + settings.buffer) * (set_size - (i - 1) - 1)
                        int line_start = bar_index + settings.width / 2 + t_buffer
                        int line_end = bar_index + next_buffer + settings.width
                        string line_style = is_confirmed_low ? confirmed_swing_style_value : potential_swing_style_value
                        if na(candle.swing_low_line)
                            candle.swing_low_line := line.new(line_start, candle.l, line_end, candle.l, color=swing_color, width=swing_line_width, style=line_style)
                        else
                            line.set_x1(candle.swing_low_line, line_start)
                            line.set_y1(candle.swing_low_line, candle.l)
                            line.set_x2(candle.swing_low_line, line_end)
                            line.set_y2(candle.swing_low_line, candle.l)
                            line.set_style(candle.swing_low_line, line_style)
                    else
                        if i > 1 and not na(candle.swing_low_line)
                            line.delete(candle.swing_low_line)
                            candle.swing_low_line := na
                
                if show_eq_line and i == 1 and set_size >= 2
                    Candle current_candle = candleSet.candles.get(0)
                    float eq_price = (candle.h + candle.l) / 2
                    int current_buffer = offset + (settings.width + settings.buffer) * (set_size - 1)
                    int line_start_x = bar_index + settings.width + t_buffer
                    int line_end_x = (bar_index + current_buffer + settings.width / 2) + 2
                    if na(candle.eq_line)
                        candle.eq_line := line.new(line_start_x, eq_price, line_end_x, eq_price, color=eq_line_color, width=eq_line_width, style=eq_line_style_value)
                    else
                        line.set_x1(candle.eq_line, line_start_x)
                        line.set_y1(candle.eq_line, eq_price)
                        line.set_x2(candle.eq_line, line_end_x)
                        line.set_y2(candle.eq_line, eq_price)
                else if i != 1 and not na(candle.eq_line)
                    line.delete(candle.eq_line)
                    candle.eq_line := na
        
        if candleSet.imbalances.size() > 0
            for j = 0 to candleSet.imbalances.size() - 1
                Imbalance imb = candleSet.imbalances.get(j)
                
                int val = imb.idx
                int candle_idx = int(val / 10)
                int type = val % 10

                int c1_arr_idx = candle_idx
                int c2_arr_idx = -1
                color imb_color = color(na)

                Candle candle1_imb = na
                Candle candle2_imb = na

                if type == 1
                    c2_arr_idx := candle_idx + 2
                    if c2_arr_idx < set_size
                        imb_color := settings.fvg_color
                        candle1_imb := candleSet.candles.get(c1_arr_idx)
                        candle2_imb := candleSet.candles.get(c2_arr_idx)
                else if type == 2
                    c2_arr_idx := candle_idx + 1
                    if c2_arr_idx < set_size
                        imb_color := settings.vi_color
                        candle1_imb := candleSet.candles.get(c1_arr_idx)
                        candle2_imb := candleSet.candles.get(c2_arr_idx)

                if not na(candle1_imb) and not na(candle2_imb)
                    int t_buffer1 = offset + (settings.width + settings.buffer) * (set_size - c1_arr_idx - 1)
                    int t_buffer2 = offset + (settings.width + settings.buffer) * (set_size - c2_arr_idx - 1)

                    int x1 = bar_index + t_buffer2
                    int x2 = bar_index + settings.width + t_buffer1

                    if na(imb.b)
                        imb.b := box.new(x1, imb.top, x2, imb.bottom, bgcolor = imb_color, border_color = color(na))
                    else
                        box.set_left(imb.b, x1)
                        box.set_right(imb.b, x2)
                        box.set_top(imb.b, imb.top)
                        box.set_bottom(imb.b, imb.bottom)
                        box.set_bgcolor(imb.b, imb_color)

        top = 0.0
        bottom = 0.0
        if settings.label_alignment == 'Align'
            top := CandlesHigh(candleSet.candles, htf_mode, aligned_tf, candleSet)
            bottom := CandlesLow(candleSet.candles, top, htf_mode, aligned_tf, candleSet)
        if settings.label_alignment == 'Follow Candles'
            top := CandleSetHigh(candleSet.candles, 0)
            bottom := CandleSetLow(candleSet.candles, top)
        
        left = bar_index + offset + (settings.width + settings.buffer) * (set_size - 1) / 2
        
        if settings.htf_label_show and (barstate.isrealtime or barstate.islast)
            string lblt = HTFName(candleSet.settings.htf)
            if candleSet.candles.size() >= 2
                Candle last_candle = candleSet.candles.get(1)
                Candle current_candle = candleSet.candles.get(0)
                bool high_broken = current_candle.h > last_candle.h
                bool close_rejected_high = current_candle.c < last_candle.h
                bool confirmed_swing_high = high_broken and close_rejected_high
                bool potential_swing_high = high_broken and not close_rejected_high
                bool low_broken = current_candle.l < last_candle.l
                bool close_rejected_low = current_candle.c > last_candle.l
                bool confirmed_swing_low = low_broken and close_rejected_low
                bool potential_swing_low = low_broken and not close_rejected_low
                
                if confirmed_swing_high
                    lblt := lblt + " ▼"
                else if potential_swing_high
                    lblt := lblt + " ▽"
                if confirmed_swing_low
                    lblt := lblt + " ▲"
                else if potential_swing_low
                    lblt := lblt + " △"

            string lbll = lblt
            if settings.htf_timer_show
                lblt := lblt + '\n'
                lbll := '\n' + lbll
            if settings.daily_name
                lblt := lblt + '\n'
            
            string tmr = '[' + RemainingTime(candleSet.settings.htf) + ']' + (settings.daily_name ? '\n' : '')
            
            if settings.label_position == 'Both' or settings.label_position == 'Top'
                if not na(candleSet.tfNameTop)
                    candleSet.tfNameTop.set_xy(left, top)
                    candleSet.tfNameTop.set_text(lblt)
                else
                    if htf_label_bold
                        candleSet.tfNameTop := label.new(left, top, lblt, color = color_transparent, textcolor = settings.htf_label_color, style = label.style_label_down, size = settings.htf_label_size, text_font_family = font.family_monospace, text_formatting = text.format_bold)
                    else
                        candleSet.tfNameTop := label.new(left, top, lblt, color = color_transparent, textcolor = settings.htf_label_color, style = label.style_label_down, size = settings.htf_label_size, text_font_family = font.family_monospace)
                if settings.htf_timer_show
                    if not na(candleSet.tfTimerTop)
                        candleSet.tfTimerTop.set_xy(left, top)
                    else
                        candleSet.tfTimerTop := label.new(left, top, tmr, color = color_transparent, textcolor = settings.htf_timer_color, style = label.style_label_down, size = settings.htf_timer_size, text_font_family = font.family_monospace)
            
            if settings.label_position == 'Both' or settings.label_position == 'Bottom'
                if not na(candleSet.tfNameBottom)
                    candleSet.tfNameBottom.set_xy(left, bottom)
                    candleSet.tfNameBottom.set_text(lbll)
                else
                    if htf_label_bold
                        candleSet.tfNameBottom := label.new(left, bottom, lbll, color = color_transparent, textcolor = settings.htf_label_color, style = label.style_label_up, size = settings.htf_label_size, text_font_family = font.family_monospace, text_formatting = text.format_bold)
                    else
                        candleSet.tfNameBottom := label.new(left, bottom, lbll, color = color_transparent, textcolor = settings.htf_label_color, style = label.style_label_up, size = settings.htf_label_size, text_font_family = font.family_monospace)
                if settings.htf_timer_show
                    if not na(candleSet.tfTimerBottom)
                        candleSet.tfTimerBottom.set_xy(left, bottom)
                    else
                        candleSet.tfTimerBottom := label.new(left, bottom, tmr, color = color_transparent, textcolor = settings.htf_timer_color, style = label.style_label_up, size = settings.htf_timer_size)
    candleSet

export type QCISD_Data
    array<line> lines
    array<label> lbls
    array<int> dirs
    array<bool> is_hp
    array<bool> confirmed

export method manage_qcisd(QCISD_Data self, QCISD_Alerts alerts, bool showon, bool tfok, int cycle_idx, bool _bear0, bool _bear0_prev, bool _bull0, bool _bull0_prev, int _hmaxt, int _hmaxt_prev, int _lmint, int _lmint_prev, float h_c, float h_o, float h_po, float l_c, float l_o, float l_po, string bias_input, bool show_qcisd, bool smart_alert, color qcisd_bear_clr, color qcisd_bull_clr, color qcisd_pend_clr, color qcisd_text_clr, int qcisd_width, string qcisd_lbl_size, bool qcisd_mono, int qcisd_max_limit, string p_name, string name) =>
    int tfs = timeframe.in_seconds(timeframe.period)
    bool qcisd_vis = false
    string ssmt_src = ""
    if cycle_idx == 0
        qcisd_vis := tfs >= 60 and tfs <= 120
        ssmt_src := "Micro"
    else if cycle_idx == 1
        qcisd_vis := tfs >= 180 and tfs <= 600
        ssmt_src := "90M"
    else if cycle_idx == 2
        qcisd_vis := tfs >= 900 and tfs <= 1800
        ssmt_src := "Daily"
    else if cycle_idx == 3
        qcisd_vis := tfs >= 3600 and tfs <= 10800
        ssmt_src := "Weekly"
    else if cycle_idx == 4
        qcisd_vis := tfs >= 14400 and tfs <= 21600
        ssmt_src := "Monthly"
    else if cycle_idx == 6
        qcisd_vis := tfs == 86400
        ssmt_src := "Quarterly"
    else if cycle_idx == 5
        qcisd_vis := tfs >= 604800 and tfs <= timeframe.in_seconds("1M")
        ssmt_src := "Yearly"

    bool new_bear_signal = _bear0 and not _bear0_prev
    bool bear_pivot_moved = _bear0 and _hmaxt != _hmaxt_prev
    bool new_bull_signal = _bull0 and not _bull0_prev
    bool bull_pivot_moved = _bull0 and _lmint != _lmint_prev
    
    int ext_len_qcisd = timeframe.in_seconds(timeframe.period) * 1000 * 10
    int bar_ms = timeframe.in_seconds(timeframe.period) * 1000

    bool qcisd_alert_active = smart_alert
    bool trig_confirm = qcisd_alert_active
    bool trig_inval  = qcisd_alert_active
    bool qcisd_norm_active = smart_alert
    bool trig_confirm_norm = qcisd_norm_active
    bool trig_inval_norm   = qcisd_norm_active
    
    string font_fam = qcisd_mono ? font.family_monospace : font.family_default

    if showon and tfok and show_qcisd and qcisd_vis
        if new_bear_signal or bear_pivot_moved
            float lvl = na
            if h_c > h_o
                lvl := h_o
            else
                lvl := h_po
            
            bool is_hp = bias_input == "Bearish"

            if not na(lvl)
                bool delete_last = false
                bool skip_creation = false
                int target_idx = -1

                if self.dirs.size() > 0
                    for i = 0 to self.dirs.size() - 1
                        if self.dirs.get(i) == -1
                            target_idx := i
                            break
                
                if target_idx != -1
                    if bear_pivot_moved
                        delete_last := true
                    else if line.get_x1(self.lines.get(target_idx)) == _hmaxt or line.get_x1(self.lines.get(target_idx)) == _hmaxt - bar_ms
                        if self.is_hp.get(target_idx) and not is_hp
                            skip_creation := true
                        else
                            delete_last := true

                if not skip_creation and delete_last
                    line.delete(self.lines.remove(target_idx))
                    label.delete(self.lbls.remove(target_idx))
                    self.dirs.remove(target_idx)
                    self.is_hp.remove(target_idx)
                    self.confirmed.remove(target_idx)

                if not skip_creation
                    bool is_conf = close < lvl
                    string style_to_use = is_conf ? line.style_solid : line.style_dashed
                    string hp_txt = is_hp ? "HP-" : ""
                    line l = na
                    label lb = na
                    if h_c > h_o
                        l := line.new(x1=_hmaxt, y1=lvl, x2=time + ext_len_qcisd, y2=lvl, xloc=xloc.bar_time, color=qcisd_bear_clr, style=style_to_use, width=qcisd_width)
                        lb := label.new(x=time + ext_len_qcisd, y=lvl, text="(-)" + hp_txt + ssmt_src + "_QCISD", xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.white, 100), textcolor=qcisd_text_clr, size=qcisd_lbl_size, text_font_family=font_fam, tooltip=p_name + " " + name)
                    else
                        l := line.new(x1=_hmaxt - bar_ms, y1=lvl, x2=time + ext_len_qcisd, y2=lvl, xloc=xloc.bar_time, color=qcisd_bear_clr, style=style_to_use, width=qcisd_width)
                        lb := label.new(x=time + ext_len_qcisd, y=lvl, text="(-)" + hp_txt + ssmt_src + "_QCISD", xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.white, 100), textcolor=qcisd_text_clr, size=qcisd_lbl_size, text_font_family=font_fam, tooltip=p_name + " " + name)

                    self.lines.unshift(l), self.lbls.unshift(lb), self.dirs.unshift(-1), self.is_hp.unshift(is_hp), self.confirmed.unshift(is_conf)
                    if new_bear_signal and is_conf
                        if is_hp and trig_confirm
                            alerts.bear_hp_conf := true
                            alerts.alert_msg += name + " Cycle | Bearish HP-QCISD | Confirmed\n"
                        else if not is_hp and trig_confirm_norm
                            alerts.bear_norm_conf := true
                            alerts.alert_msg += name + " Cycle | Bearish QCISD | Confirmed\n"

        if new_bull_signal or bull_pivot_moved
            float lvl = na
            if l_c < l_o
                lvl := l_o
            else
                lvl := l_po
            bool is_hp = bias_input == "Bullish"
            if not na(lvl)
                bool delete_last = false
                bool skip_creation = false
                int target_idx = -1
                if self.dirs.size() > 0
                    for i = 0 to self.dirs.size() - 1
                        if self.dirs.get(i) == 1
                            target_idx := i
                            break
                if target_idx != -1
                    if bull_pivot_moved
                        delete_last := true
                    else if line.get_x1(self.lines.get(target_idx)) == _lmint or line.get_x1(self.lines.get(target_idx)) == _lmint - bar_ms
                        if self.is_hp.get(target_idx) and not is_hp
                            skip_creation := true
                        else
                            delete_last := true
                if not skip_creation and delete_last
                    line.delete(self.lines.remove(target_idx)), label.delete(self.lbls.remove(target_idx)), self.dirs.remove(target_idx), self.is_hp.remove(target_idx), self.confirmed.remove(target_idx)
                if not skip_creation
                    bool is_conf = close > lvl
                    string style_to_use = is_conf ? line.style_solid : line.style_dashed
                    string hp_txt = is_hp ? "HP-" : ""
                    line l = na
                    label lb = na
                    if l_c < l_o
                        l := line.new(x1=_lmint, y1=lvl, x2=time + ext_len_qcisd, y2=lvl, xloc=xloc.bar_time, color=qcisd_bull_clr, style=style_to_use, width=qcisd_width)
                        lb := label.new(x=time + ext_len_qcisd, y=lvl, text="(+)" + hp_txt + ssmt_src + "_QCISD", xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.white, 100), textcolor=qcisd_text_clr, size=qcisd_lbl_size, text_font_family=font_fam, tooltip=p_name + " " + name)
                    else
                        l := line.new(x1=_lmint - bar_ms, y1=lvl, x2=time + ext_len_qcisd, y2=lvl, xloc=xloc.bar_time, color=qcisd_bull_clr, style=style_to_use, width=qcisd_width)
                        lb := label.new(x=time + ext_len_qcisd, y=lvl, text="(+)" + hp_txt + ssmt_src + "_QCISD", xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.white, 100), textcolor=qcisd_text_clr, size=qcisd_lbl_size, text_font_family=font_fam, tooltip=p_name + " " + name)
                    self.lines.unshift(l), self.lbls.unshift(lb), self.dirs.unshift(1), self.is_hp.unshift(is_hp), self.confirmed.unshift(is_conf)
                    if new_bull_signal and is_conf
                        if is_hp and trig_confirm
                            alerts.bull_hp_conf := true
                            alerts.alert_msg += name + " Cycle | Bullish HP-QCISD | Confirmed\n"
                        else if not is_hp and trig_confirm_norm
                            alerts.bull_norm_conf := true
                            alerts.alert_msg += name + " Cycle | Bullish QCISD | Confirmed\n"

    while self.lines.size() > qcisd_max_limit
        line.delete(self.lines.pop()), label.delete(self.lbls.pop()), self.dirs.pop(), self.is_hp.pop(), self.confirmed.pop()

    if self.lines.size() > 0
        for i = 0 to self.lines.size() - 1
            line l_curr = self.lines.get(i)
            label lb_curr = self.lbls.get(i)
            int dir = self.dirs.get(i)
            bool is_hp_line = self.is_hp.get(i)
            bool is_conf_line = self.confirmed.get(i)
            float lvl = line.get_y1(l_curr)
            bool delete_it = false
            
            if dir == 1
                if close > lvl
                    line.set_style(l_curr, line.style_solid)
                    if not is_conf_line
                        self.confirmed.set(i, true)
                        if is_hp_line and trig_confirm
                            alerts.bull_hp_conf := true
                            alerts.alert_msg += name + " Cycle | Bullish HP-QCISD | Confirmed\n"
                        else if not is_hp_line and trig_confirm_norm
                            alerts.bull_norm_conf := true
                            alerts.alert_msg += name + " Cycle | Bullish QCISD | Confirmed\n"
                bool body_below_0 = (close < lvl and open < lvl)
                bool body_below_1 = (close[1] < lvl and open[1] < lvl)
                bool body_below_2 = (close[2] < lvl and open[2] < lvl)
                if body_below_0
                    line.set_color(l_curr, qcisd_pend_clr)
                else
                    line.set_color(l_curr, qcisd_bull_clr)
                if body_below_0 and body_below_1 and body_below_2
                    delete_it := true
                    if is_hp_line and trig_inval
                        alerts.bull_hp_inval := true
                        alerts.alert_msg += name + " Cycle | Bullish HP-QCISD | Invalidated\n"
                    else if not is_hp_line and trig_inval_norm
                        alerts.bull_norm_inval := true
                        alerts.alert_msg += name + " Cycle | Bullish QCISD | Invalidated\n"

            else if dir == -1
                if close < lvl
                    line.set_style(l_curr, line.style_solid)
                    if not is_conf_line
                        self.confirmed.set(i, true)
                        if is_hp_line and trig_confirm
                            alerts.bear_hp_conf := true
                            alerts.alert_msg += name + " Cycle | Bearish HP-QCISD | Confirmed\n"
                        else if not is_hp_line and trig_confirm_norm
                            alerts.bear_norm_conf := true
                            alerts.alert_msg += name + " Cycle | Bearish QCISD | Confirmed\n"
                bool body_above_0 = (close > lvl and open > lvl)
                bool body_above_1 = (close[1] > lvl and open[1] > lvl)
                bool body_above_2 = (close[2] > lvl and open[2] > lvl)
                if body_above_0
                    line.set_color(l_curr, qcisd_pend_clr)
                else
                    line.set_color(l_curr, qcisd_bear_clr)
                if body_above_0 and body_above_1 and body_above_2
                    delete_it := true
                    if is_hp_line and trig_inval
                        alerts.bear_hp_inval := true
                        alerts.alert_msg += name + " Cycle | Bearish HP-QCISD | Invalidated\n"
                    else if not is_hp_line and trig_inval_norm
                        alerts.bear_norm_inval := true
                        alerts.alert_msg += name + " Cycle | Bearish QCISD | Invalidated\n"
            
            if delete_it
                line.delete(self.lines.remove(i)), label.delete(self.lbls.remove(i)), self.dirs.remove(i), self.is_hp.remove(i), self.confirmed.remove(i)

export lineStyle(string styleInText) =>
    switch styleInText
        'Solid'     => line.style_solid
        'Dotted'    => line.style_dotted
        'Dashed'    => line.style_dashed

export method queryPatterns(ICTMS this, bool isSwingHigh) =>
    if isSwingHigh
        this.prevPrice < this.midPrice and this.midPrice >= this.lastPrice
    else
        this.prevPrice > this.midPrice and this.midPrice <= this.lastPrice

export method updatePattern(ICTMS this, float price, int index) =>
    this.isCrossed := false
    this.prevPrice := this.midPrice, this.midPrice := this.lastPrice, this.lastPrice := price
    this.prevIndex := this.midIndex, this.midIndex := this.lastIndex, this.lastIndex := index

export method renderStructures(ICTMS this, bool isBullish, MS marketStructure, color col, string style, array<line> lines, array<label> labels, array<box> boxes, int limit, string lbl_size) =>
    condition = isBullish ? close > this.lastPrice : close < this.lastPrice

    if condition and not this.isCrossed
        this.isCrossed := true
        this.isConfirmed := false
        this.msLine := line.new(this.lastIndex, this.lastPrice, bar_index, this.lastPrice, color = col, style = lineStyle(style))
        this.swpBox := box.new(bar_index, this.lastPrice, bar_index, this.lastPrice, color.new(col, 73), bgcolor = color.new(col, 73))
        
        lines.push(this.msLine)
        boxes.push(this.swpBox)

        string txt = marketStructure.type == (isBullish ? -1 : 1) ? 'MSS' : 'BOS'
        if isBullish
            this.msLabel := label.new(int(math.avg(this.lastIndex, bar_index)), this.lastPrice, text = txt, color = color.new(color.white, 100), textcolor = col, style = label.style_label_down, size = lbl_size)
        else
            this.msLabel := label.new(int(math.avg(this.lastIndex, bar_index)), this.lastPrice, text = txt, color = color.new(color.white, 100), textcolor = col, style = label.style_label_up, size = lbl_size)
        
        labels.push(this.msLabel)

        if limit > 0
            while lines.size() > limit
                line.delete(lines.shift())
            while boxes.size() > limit
                box.delete(boxes.shift())
            while labels.size() > limit
                label.delete(labels.shift())

        marketStructure.setType(isBullish ? 1 : -1)

export method MS_Calc(MS_State s, bool show, string term, string style, color bullCol, color bearCol, int limit, string lbl_size) =>
    if low[2] > low[1] and low[1] <= low
        s.stLow.updatePattern(low[1], bar_index[1])
    
    if high[2] < high[1] and high[1] >= high
        s.stHigh.updatePattern(high[1], bar_index[1])

    cITL = s.stLow.queryPatterns(false)
    if cITL and cITL != cITL[1]
        s.itLow.updatePattern(s.stLow.midPrice, s.stLow.midIndex)
    
    cITH = s.stHigh.queryPatterns(true)
    if cITH and cITH != cITH[1]
        s.itHigh.updatePattern(s.stHigh.midPrice, s.stHigh.midIndex)

    cLTL = s.itLow.queryPatterns(false)
    if cLTL and cLTL != cLTL[1]
        s.ltLow.isCrossed := false
        s.ltLow.lastPrice := s.itLow.midPrice
        s.ltLow.lastIndex := s.itLow.midIndex

    cLTH = s.itHigh.queryPatterns(true)
    if cLTH and cLTH != cLTH[1]
        s.ltHigh.isCrossed := false
        s.ltHigh.lastPrice := s.itHigh.midPrice
        s.ltHigh.lastIndex := s.itHigh.midIndex

    if show
        if term == 'Short Term'
            s.stLow.renderStructures(false, s.stMS, bearCol, style, s.hist_lines, s.hist_labels, s.hist_boxes, limit, lbl_size)
            s.stHigh.renderStructures(true, s.stMS, bullCol, style, s.hist_lines, s.hist_labels, s.hist_boxes, limit, lbl_size)

        if term == 'Intermediate Term'
            s.itLow.renderStructures(false, s.itMS, bearCol, style, s.hist_lines, s.hist_labels, s.hist_boxes, limit, lbl_size)
            s.itHigh.renderStructures(true, s.itMS, bullCol, style, s.hist_lines, s.hist_labels, s.hist_boxes, limit, lbl_size)

        if term == 'Long Term'
            s.ltLow.renderStructures(false, s.ltMS, bearCol, style, s.hist_lines, s.hist_labels, s.hist_boxes, limit, lbl_size)
            s.ltHigh.renderStructures(true, s.ltMS, bullCol, style, s.hist_lines, s.hist_labels, s.hist_boxes, limit, lbl_size)

// ==========================================
// DEFINING RANGE & STANDARD DEVIATION (DFR)
// ==========================================

export type dfr_item
    array<line> lines
    array<box> boxes
    label lbl

export get_dfr(bool session, string session_name, color session_css, bool show, int dfr_cycles, string i_font) =>
    var dfr_item[] history = array.new<dfr_item>()
    var t = 0 
    var max = high
    var min = low
    var line bxh = na
    var line bxl = na
    var label lbl = na
    var box[] active_boxes = array.new_box(0)
    var float[] active_levels = array.new_float(0)

    show_txt = show
            
    if session and not session[1]
        t := time
        max := high
        min := low
        
        bxh := line.new(t, max, t, max, xloc=xloc.bar_time, color=session_css, style=line.style_dotted, width=2)
        bxl := line.new(t, min, t, min, xloc=xloc.bar_time, color=session_css, style=line.style_dotted, width=2) 

        if show_txt
            lbl := label.new(t, max, session_name, xloc=xloc.bar_time, textcolor=session_css, style=label.style_label_down, color=color.new(color.white, 100), size=i_font)
        item = dfr_item.new(array.new_line(), array.new_box(), lbl)
        array.push(item.lines, bxh)
        array.push(item.lines, bxl)
        array.push(history, item)
        array.clear(active_boxes)
        array.clear(active_levels)

        while array.size(history) > dfr_cycles
            old = array.shift(history)
            for l in old.lines
                line.delete(l)
            for b in old.boxes
                box.delete(b)
            label.delete(old.lbl)

    if session
        max := math.max(high, max)
        min := math.min(low, min)
        line.set_xy1(bxh, t, max)
        line.set_xy2(bxh, time, max)
        line.set_xy1(bxl, t, min)
        line.set_xy2(bxl, time, min)

        if show_txt 
            label.set_xy(lbl, int(math.avg(t, time)), max)
            
        dr = max - min
        
        levels = array.from(max + dr, max + 2 * dr, max + 2.5 * dr, max + 4 * dr, min - dr, min - 2 * dr, min - 2.5 * dr, min - 4 * dr)
        texts  = array.from("1", "2", "2.5", "4", "-1", "-2", "-2.5", "-4")

        if not session[1]
            array.clear(active_boxes)
            array.clear(active_levels)
            cur_item = array.get(history, array.size(history) - 1)
            
            for i = 0 to 7
                lvl_price = array.get(levels, i)
                txt = array.get(texts, i)
                v_align = i < 4 ? text.align_bottom : text.align_top
                
                bx = box.new(t, lvl_price, time, lvl_price, 
                     xloc=xloc.bar_time, 
                     border_color=session_css, 
                     bgcolor=color.new(color.red, 100), 
                     text=txt, 
                     text_color=session_css, 
                     text_valign=v_align, 
                     text_halign=text.align_right, 
                     text_size=size.tiny, 
                     border_style=line.style_dotted)
                
                array.push(active_boxes, bx)
                array.push(active_levels, lvl_price)
                array.push(cur_item.boxes, bx)
        else
            if array.size(active_boxes) > 0
                for i = 0 to array.size(active_boxes) - 1
                    bx_id = array.get(active_boxes, i)
                    pr    = array.get(levels, i)
                    box.set_right(bx_id, time)
                    box.set_top(bx_id, pr)
                    box.set_bottom(bx_id, pr)

// ==========================================
// NWOG & NDOG LOGIC
// ==========================================

export f_month_from_string(string s) =>
    s == "January" ? 1 : s == "February" ? 2 : s == "March" ? 3 : s == "April" ? 4 : s == "May" ? 5 : s == "June" ? 6 : s == "July" ? 7 : s == "August" ? 8 : s == "September" ? 9 : s == "October" ? 10 : s == "November" ? 11 : 12

export f_quarter_from_string(string s) =>
    s == "Q1" ? 1 : s == "Q2" ? 2 : s == "Q3" ? 3 : 4

export f_nwox_main(string _tf, color clr, int del, bool _show, string nwog_mode, string nwog_manual_month, string nwog_manual_quarter, int nwox_buffer, color i_textcolor, array<float> N_ext, array<float> D_ext, array<float> W_ext, array<float> m_ext, bool tf_ok, bool tf_okW, bool tf_okD, bool tf_ok_mic) =>
    var nwox_top_lines  = array.new_line()
    var nwox_bot_lines  = array.new_line()
    var nwox_ce_lines   = array.new_line()
    var nwox_link_lines = array.new_line() 
    var nwox_fills      = array.new_linefill()
    var nwox_labels     = array.new_label()

    var bool manual_gap_found = false
    var int manual_gap_time = na

    var float csd_level = na
    _tap = false 
    htapW = false, htapD = false, htap90 = false, htapm = false
    ltapW = false, ltapD = false, ltap90 = false, ltapm = false    

    int tc = (time - time[1]) * nwox_buffer

    if timeframe.change(_tf) 
        _max = math.max(close[1], open)
        _min = math.min(close[1], open)
        _ce  = math.avg(_max, _min)
        
        gap_border_clr = i_textcolor 
        gap_fill_clr   = clr

        bool is_manual_target = false
        if _tf == "1W" and nwog_mode == "Manual" and _show and not na(time)
            int target_month = f_month_from_string(nwog_manual_month)
            int target_quarter = f_quarter_from_string(nwog_manual_quarter)
            int wom = math.ceil(dayofmonth(time) / 7.0)
            if month(time) == target_month and wom == target_quarter
                is_manual_target := true

            if is_manual_target
                manual_gap_found := true
                manual_gap_time := time

        bool can_draw = false
        if _show and _max - _min >= 1 * syminfo.mintick and not (_tf == "1D" and timeframe.change("1W"))
            if _tf == "1W"
                if nwog_mode == "Auto"
                    can_draw := true
                else if is_manual_target
                    can_draw := true
            else if _tf == "1D"
                can_draw := true

        if can_draw
            l_top = line.new(x1=time, y1=_max, x2=time + tc, y2=_max, xloc=xloc.bar_time, color=gap_border_clr, style=line.style_solid)
            l_bot = line.new(x1=time, y1=_min, x2=time + tc, y2=_min, xloc=xloc.bar_time, color=gap_border_clr, style=line.style_solid)
            l_ce  = line.new(x1=time, y1=_ce,  x2=time + tc, y2=_ce,  xloc=xloc.bar_time, color=gap_border_clr, style=line.style_dashed)
            l_fill = linefill.new(l_top, l_bot, gap_fill_clr)

            l_link = line.new(x1=time + tc, y1=_max, x2=time + tc, y2=_min, xloc=xloc.bar_time, color=gap_border_clr, style=line.style_solid, width=3)

            string lbl_txt = ""
            if _tf == "1W" and not na(time)
                int wom = math.ceil(dayofmonth(time) / 7.0)
                lbl_txt := str.format("{0,date,MMMM} Q{1} NWOG", time, wom)
            else if _tf == "1D"
                lbl_txt := str.format("{0,date,EEE dd-MM-yyyy} NDOG", time)

            l_lbl = label.new(x=time + tc, y=_ce, text=lbl_txt, xloc=xloc.bar_time, textcolor=gap_border_clr, style=label.style_label_left, color=color.new(color.white, 100), size=size.small)

            array.unshift(nwox_top_lines, l_top)
            array.unshift(nwox_bot_lines, l_bot)
            array.unshift(nwox_ce_lines, l_ce)
            array.unshift(nwox_link_lines, l_link)
            array.unshift(nwox_fills, l_fill)
            array.unshift(nwox_labels, l_lbl)
            
            if array.size(nwox_top_lines) > 60
                line.delete(array.pop(nwox_top_lines))
                line.delete(array.pop(nwox_bot_lines))
                line.delete(array.pop(nwox_ce_lines))
                line.delete(array.pop(nwox_link_lines))
                linefill.delete(array.pop(nwox_fills))
                label.delete(array.pop(nwox_labels))

    dxx   = ta.atr(20)/2
    hmax  = array.get(N_ext,0), lmin  = array.get(N_ext,1)
    hmaxD = array.get(D_ext,0), lminD = array.get(D_ext,1)
    hmaxW = array.get(W_ext,0), lminW = array.get(W_ext,1)
    hmaxm = array.get(m_ext,0), lminm = array.get(m_ext,1)    

    if array.size(nwox_top_lines) > 0
        for i = array.size(nwox_top_lines)-1 to 0
            l_top  = array.get(nwox_top_lines, i)
            l_bot  = array.get(nwox_bot_lines, i)
            l_ce   = array.get(nwox_ce_lines, i)
            l_link = array.get(nwox_link_lines, i)
            l_lbl  = array.get(nwox_labels, i)
            
            top = line.get_y1(l_top)
            bot = line.get_y1(l_bot)
            
            line.set_x2(l_top, time + tc)
            line.set_x2(l_bot, time + tc)
            line.set_x2(l_ce,  time + tc)
            
            line.set_x1(l_link, time + tc)
            line.set_x2(l_link, time + tc)

            label.set_x(l_lbl, time + tc)

            if math.abs(bot - high) <= dxx or math.abs(low - top) <= dxx or (high <= top and low >= bot) or (high >= bot and low <= top)
                _tap := true
            if ((hmax > top and lmin < top + dxx) or ( top >= hmax and bot <= lmin)) and tf_ok 
                ltap90 := true
            if ((lmin < bot and hmax > bot - dxx) or ( top >= hmax and bot <= lmin)) and tf_ok 
                htap90 := true
            if ((hmaxW > top and lminW < top + dxx) or ( top >= hmaxW and bot <= lminW)) and tf_okW 
                ltapW := true
            if ((lminW < bot and hmaxW > bot - dxx) or ( top >= hmaxW and bot <= lminW)) and tf_okW 
                htapW := true  
            if ((hmaxD > top and lminD < top + dxx) or ( top >= hmaxD and bot <= lminD)) and tf_okD 
                ltapD := true
            if ((lminD < bot and hmaxD > bot - dxx) or ( top >= hmaxD and bot <= lminD)) and tf_okD 
                htapD := true                 
            if ((hmaxm > top and lminm < top + dxx) or ( top >= hmaxm and bot <= lminm)) and tf_ok_mic 
                ltapm := true
            if ((lminm < bot and hmaxm > bot - dxx) or ( top >= hmaxm and bot <= lminm)) and tf_ok_mic 
                htapm := true

    int final_del = del
    if _tf == "1W"
        final_del := nwog_mode == "Auto" ? del : 1

    if array.size(nwox_top_lines) > final_del
        for i = array.size(nwox_top_lines)-1 to final_del
            if _tf == "1W" and manual_gap_found and line.get_x1(array.get(nwox_top_lines, i)) == manual_gap_time
                continue

            line.delete(array.pop(nwox_top_lines))
            line.delete(array.pop(nwox_bot_lines))
            line.delete(array.pop(nwox_ce_lines))
            line.delete(array.pop(nwox_link_lines))
            linefill.delete(array.pop(nwox_fills))
            label.delete(array.pop(nwox_labels))

    [_tap, ltapW, htapW, ltapD, htapD, ltap90, htap90, ltapm, htapm]

export f_nwox_corele(string _tf, float fc1, float fo0, float fh0, float fl0, int del, float fatr, string gc, array<float> N_ext, bool show_nwog) =>
    var nwox_max = array.new_float()
    var nwox_min = array.new_float()
    _tap = false
    
    if timeframe.change(_tf) 
        _max = math.max(fc1, fo0)
        _min = math.min(fc1, fo0)
        if _max - _min >= 1 * syminfo.mintick and not (_tf == "1D" and timeframe.change("1W") and show_nwog)
            array.unshift(nwox_max, _max)
            if array.size(nwox_max) > 40
                array.pop(nwox_max)
                
            array.unshift(nwox_min, _min)
            if array.size(nwox_min) > 40
                array.pop(nwox_min)

    hmax = array.get(N_ext, 0)
    lmin = array.get(N_ext, 1)  

    dxx = fatr / 2

    if array.size(nwox_max) > 0
        for i = array.size(nwox_max) - 1 to 0
            top = array.get(nwox_max, i)
            bot = array.get(nwox_min, i)
            
            if gc == "c" and (math.abs(bot - fh0) <= dxx or math.abs(fl0 - top) <= dxx or (fh0 <= top and fl0 >= bot) or (fh0 >= bot and fl0 <= top))
                _tap := true
            if gc == "l" and ((fh0 > top and fl0 < top + dxx) or (top >= fh0 and bot <= fl0))  
                _tap := true
            if gc == "h" and ((lmin < bot and hmax > bot - dxx) or (top >= hmax and bot <= lmin))  
                _tap := true            

    if array.size(nwox_max) > del
        for i = array.size(nwox_max) - 1 to del
            array.remove(nwox_max, i)
            array.remove(nwox_min, i)

    _tap


// =======================================================================
// SFP MULTI TIMEFRAME SINGLES TABLE (OPTIMIZED LIBRARY INTEGRATION)
// =======================================================================

// Loop-free SFP TF calculations (Fully compatible with request.security)
f_tf_calc() =>
    p_high = ta.pivothigh(5, 1)
    p_low  = ta.pivotlow(5, 1)
    
    var float highSwing_price = na
    var float lowSwing_price = na
    
    // Dynamic accumulation of the lowest low / highest high since the pivot occurred
    var float lowest_low_since_pivot_high = na
    var float highest_high_since_pivot_low = na
    
    if not na(p_high)
        highSwing_price := p_high
        lowest_low_since_pivot_high := math.min(low, low[1])
    else if not na(lowest_low_since_pivot_high)
        lowest_low_since_pivot_high := math.min(lowest_low_since_pivot_high, low)
        
    if not na(p_low)
        lowSwing_price := p_low
        highest_high_since_pivot_low := math.max(high, high[1])
    else if not na(highest_high_since_pivot_low)
        highest_high_since_pivot_low := math.max(highest_high_since_pivot_low, high)
        
    bool sfp_bear_sweep = false
    bool sfp_bull_sweep = false
    
    if not na(highSwing_price) and close < highSwing_price and open < highSwing_price and high > highSwing_price
        sfp_bear_sweep := true
    if not na(lowSwing_price) and close > lowSwing_price and open > lowSwing_price and low < lowSwing_price
        sfp_bull_sweep := true
        
    var float sfp_bear_lvl = na
    var float sfp_bull_lvl = na
    
    if sfp_bear_sweep
        sfp_bear_lvl := high
    if sfp_bull_sweep
        sfp_bull_lvl := low
        
    bool sfp_bear_confirmed = false
    bool sfp_bull_confirmed = false
    
    var bool sfp_bear_active = false
    var float bear_opp_price = na
    var bool sfp_bull_active = false
    var float bull_opp_price = na
    
    if sfp_bear_sweep
        sfp_bear_active := true
        bear_opp_price := not na(lowest_low_since_pivot_high[1]) ? lowest_low_since_pivot_high[1] : low
                
    if sfp_bull_sweep
        sfp_bull_active := true
        bull_opp_price := not na(highest_high_since_pivot_low[1]) ? highest_high_since_pivot_low[1] : high
                
    if sfp_bear_active
        if close < bear_opp_price
            sfp_bear_confirmed := true
            sfp_bear_active := false
        else if close > sfp_bear_lvl
            sfp_bear_active := false
            
    if sfp_bull_active
        if close > bull_opp_price
            sfp_bull_confirmed := true
            sfp_bull_active := false
        else if close < sfp_bull_lvl
            sfp_bull_active := false

    var string sfp_status = "Waiting"
    var int bias = 0
    var float sfp_level = na
    
    if sfp_bull_confirmed
        sfp_status := "Confirm"
        bias := 1
        sfp_level := sfp_bull_lvl
    else if sfp_bear_confirmed
        sfp_status := "Confirm"
        bias := -1
        sfp_level := sfp_bear_lvl
        
    if sfp_status == "Confirm"
        if bias == 1
            if close < sfp_level
                sfp_status := "Waiting"
                bias := 0
                sfp_level := na
        else if bias == -1
            if close > sfp_level
                sfp_status := "Waiting"
                bias := 0
                sfp_level := na

    string out_status = sfp_status
    int out_bias = bias
    if sfp_bull_active
        out_status := "Unconfirmed"
        out_bias := 1
    else if sfp_bear_active
        out_status := "Unconfirmed"
        out_bias := -1

    [out_bias, out_status]

// Exact 10 timeframe security requests
[bias_W, status_W] = request.security(syminfo.tickerid, "1W", f_tf_calc(), lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
[bias_D, status_D] = request.security(syminfo.tickerid, "1D", f_tf_calc(), lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
[bias_360, status_360] = request.security(syminfo.tickerid, "360", f_tf_calc(), lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
[bias_240, status_240] = request.security(syminfo.tickerid, "240", f_tf_calc(), lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
[bias_60, status_60] = request.security(syminfo.tickerid, "60", f_tf_calc(), lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
[bias_30, status_30] = request.security(syminfo.tickerid, "30", f_tf_calc(), lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
[bias_15, status_15] = request.security(syminfo.tickerid, "15", f_tf_calc(), lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
[bias_5, status_5] = request.security(syminfo.tickerid, "5", f_tf_calc(), lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
[bias_3, status_3] = request.security(syminfo.tickerid, "3", f_tf_calc(), lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
[bias_1, status_1] = request.security(syminfo.tickerid, "1", f_tf_calc(), lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)

// Standalone Global Helpers (avoids nested function errors in Pine Script)
f_draw_target_row_internal(table tbl, int r, string lbl, bool is_hit, float pr, bool is_conf, color bg_color, color tc, string sz) =>
    table.cell(tbl, 0, r, lbl, bgcolor=bg_color, text_color=tc, text_size=sz)
    txt = is_conf ? (is_hit ? "✅ Hit - " : "⏳ Pending - ") + str.tostring(pr, format.mintick) : "-"
    clr = is_conf ? (is_hit ? color.green : color.yellow) : tc
    table.cell(tbl, 1, r, txt, bgcolor=bg_color, text_color=clr, text_size=sz)

f_draw_simple_row_internal(table tbl, int r, string lbl, string val, color val_clr, color bg_color, color tc, string sz) =>
    table.cell(tbl, 0, r, lbl, bgcolor=bg_color, text_color=tc, text_size=sz)
    table.cell(tbl, 1, r, val, bgcolor=bg_color, text_color=val_clr, text_size=sz)

f_draw_status_row_internal(table tbl, int r, string lbl, int bias, string status, color bg_color, color tc, string sz) =>
    cell_str = status == "Confirm" ? (bias == 1 ? "🟢 Bullish" : "🔴 Bearish") : (status == "Unconfirmed" ? "🟡 Unconfirmed" : "⚪ Waiting")
    cell_col = status == "Confirm" ? (bias == 1 ? color.green : color.red) : (status == "Unconfirmed" ? color.yellow : color.gray)
    table.cell(tbl, 0, r, lbl, bgcolor=bg_color, text_color=tc, text_size=sz)
    table.cell(tbl, 1, r, cell_str, bgcolor=bg_color, text_color=cell_col, text_size=sz)

export f_draw_sfp_mtf_table(
     bool showTable, bool enableMTF, string tablePos, string tableSize, color tblBg, color textClr,
     bool ts_active, string ts_side, bool bear_confirmed, bool bull_confirmed, bool bear_active, bool bull_active,
     string sfp_stars, string sfp_confluence,
     float ts_entryPrice, float bear_oppPrice, float bull_oppPrice,
     float ts_slPrice, float bear_sfpPrice, float bull_sfpPrice,
     bool ts_tp_2rr_hit, bool ts_hist_tp_2rr_hit, float ts_tp_2rr,
     bool ts_tp_2_5_hit, bool ts_hist_tp_2_5_hit, float ts_tp_2_5,
     bool ts_tp_4_hit, bool ts_hist_tp_4_hit, float ts_tp_4,
     bool ts_tp_4_5_hit, bool ts_hist_tp_4_5_hit, float ts_tp_4_5
) =>
    sfp_is_conf = bear_confirmed or bull_confirmed
    sfp_tbl_bg = tblBg
    sfp_tbl_size = switch tableSize
        "tiny"   => size.tiny
        "small"  => size.small
        "normal" => size.normal
        "large"  => size.large
        => size.small
        
    sfp_tablePosition = switch tablePos
        "Top Left"     => position.top_left
        "Top Right"    => position.top_right
        "Bottom Left"  => position.bottom_left
        "Bottom Right" => position.bottom_right
        "Middle Left"  => position.middle_left
        => position.middle_right

    // 10 timeframes + separator + 10 standard SFP parameters = 21 rows
    int total_rows = enableMTF ? 21 : 10
    var table sfp_tbl = table.new(sfp_tablePosition, 2, total_rows, border_width=1, border_color=color.gray)
    
    if barstate.islast and showTable
        table.cell(sfp_tbl, 0, 0, "SFP Parameter", bgcolor=sfp_tbl_bg, text_color=textClr, text_size=sfp_tbl_size)
        table.cell(sfp_tbl, 1, 0, "Value", bgcolor=sfp_tbl_bg, text_color=textClr, text_size=sfp_tbl_size)
        
        sfp_row = 1
        
        sfp_setup_text = ts_active ? (ts_side + " Trade Live") : (bear_confirmed ? "Bearish Confirmed" : bull_confirmed ? "Bullish Confirmed" : bear_active ? "Bearish Active" : bull_active ? "Bullish Active" : "Scanning...")
        sfp_setup_color = ts_active ? (ts_side == "BULL" ? color.green : color.red) : (bear_confirmed ? color.red : bull_confirmed ? color.green : color.gray)
        
        table.cell(sfp_tbl, 0, sfp_row, "SFP Setup State:", bgcolor=sfp_tbl_bg, text_color=textClr, text_size=sfp_tbl_size)
        table.cell(sfp_tbl, 1, sfp_row, sfp_setup_text, bgcolor=sfp_tbl_bg, text_color=sfp_setup_color, text_size=sfp_tbl_size)
        sfp_row += 1
        
        table.cell(sfp_tbl, 0, sfp_row, "SFP Grade:", bgcolor=sfp_tbl_bg, text_color=textClr, text_size=sfp_tbl_size)
        table.cell(sfp_tbl, 1, sfp_row, sfp_stars, bgcolor=sfp_tbl_bg, text_color=textClr, text_size=sfp_tbl_size)
        sfp_row += 1
        
        table.cell(sfp_tbl, 0, sfp_row, "SFP Confluence:", bgcolor=sfp_tbl_bg, text_color=textClr, text_size=sfp_tbl_size)
        table.cell(sfp_tbl, 1, sfp_row, sfp_confluence, bgcolor=sfp_tbl_bg, text_color=textClr, text_size=sfp_tbl_size)
        sfp_row += 1
        
        sfp_ent_val = ts_active ? str.tostring(ts_entryPrice, format.mintick) : (bear_confirmed ? str.tostring(bear_oppPrice, format.mintick) : bull_confirmed ? str.tostring(bull_oppPrice, format.mintick) : "-")
        table.cell(sfp_tbl, 0, sfp_row, "Entry (Validation):", bgcolor=sfp_tbl_bg, text_color=textClr, text_size=sfp_tbl_size)
        table.cell(sfp_tbl, 1, sfp_row, sfp_ent_val, bgcolor=sfp_tbl_bg, text_color=textClr, text_size=sfp_tbl_size)
        sfp_row += 1
        
        sfp_sl_val = ts_active ? str.tostring(ts_slPrice, format.mintick) : (bear_confirmed ? str.tostring(bear_sfpPrice, format.mintick) : bull_confirmed ? str.tostring(bull_sfpPrice, format.mintick) : "-")
        table.cell(sfp_tbl, 0, sfp_row, "Stop Loss (Extremity):", bgcolor=sfp_tbl_bg, text_color=textClr, text_size=sfp_tbl_size)
        table.cell(sfp_tbl, 1, sfp_row, sfp_sl_val, bgcolor=sfp_tbl_bg, text_color=textClr, text_size=sfp_tbl_size)
        sfp_row += 1
        
        f_draw_target_row_internal(sfp_tbl, sfp_row, "Target 2RR:", ts_active ? ts_tp_2rr_hit : ts_hist_tp_2rr_hit, ts_tp_2rr, sfp_is_conf, sfp_tbl_bg, textClr, sfp_tbl_size)
        sfp_row += 1
        f_draw_target_row_internal(sfp_tbl, sfp_row, "Target 2.5RR:", ts_active ? ts_tp_2_5_hit : ts_hist_tp_2_5_hit, ts_tp_2_5, sfp_is_conf, sfp_tbl_bg, textClr, sfp_tbl_size)
        sfp_row += 1
        f_draw_target_row_internal(sfp_tbl, sfp_row, "Target 4RR:", ts_active ? ts_tp_4_hit : ts_hist_tp_4_hit, ts_tp_4, sfp_is_conf, sfp_tbl_bg, textClr, sfp_tbl_size)
        sfp_row += 1
        f_draw_target_row_internal(sfp_tbl, sfp_row, "Target 4.5RR:", ts_active ? ts_tp_4_5_hit : ts_hist_tp_4_5_hit, ts_tp_4_5, sfp_is_conf, sfp_tbl_bg, textClr, sfp_tbl_size)
        
        if enableMTF
            sfp_row := sfp_row + 1
            f_draw_simple_row_internal(sfp_tbl, sfp_row, "-----------------", "-----------------", color.gray, sfp_tbl_bg, textClr, sfp_tbl_size)
            
            sfp_row := sfp_row + 1
            f_draw_status_row_internal(sfp_tbl, sfp_row, "MTF Bias (1W):", bias_W, status_W, sfp_tbl_bg, textClr, sfp_tbl_size)
            sfp_row := sfp_row + 1
            f_draw_status_row_internal(sfp_tbl, sfp_row, "MTF Bias (1D):", bias_D, status_D, sfp_tbl_bg, textClr, sfp_tbl_size)
            sfp_row := sfp_row + 1
            f_draw_status_row_internal(sfp_tbl, sfp_row, "MTF Bias (6H):", bias_360, status_360, sfp_tbl_bg, textClr, sfp_tbl_size)
            sfp_row := sfp_row + 1
            f_draw_status_row_internal(sfp_tbl, sfp_row, "MTF Bias (4H):", bias_240, status_240, sfp_tbl_bg, textClr, sfp_tbl_size)
            sfp_row := sfp_row + 1
            f_draw_status_row_internal(sfp_tbl, sfp_row, "MTF Bias (1H):", bias_60, status_60, sfp_tbl_bg, textClr, sfp_tbl_size)
            sfp_row := sfp_row + 1
            f_draw_status_row_internal(sfp_tbl, sfp_row, "MTF Bias (30m):", bias_30, status_30, sfp_tbl_bg, textClr, sfp_tbl_size)
            sfp_row := sfp_row + 1
            f_draw_status_row_internal(sfp_tbl, sfp_row, "MTF Bias (15m):", bias_15, status_15, sfp_tbl_bg, textClr, sfp_tbl_size)
            sfp_row := sfp_row + 1
            f_draw_status_row_internal(sfp_tbl, sfp_row, "MTF Bias (5m):", bias_5, status_5, sfp_tbl_bg, textClr, sfp_tbl_size)
            sfp_row := sfp_row + 1
            f_draw_status_row_internal(sfp_tbl, sfp_row, "MTF Bias (3m):", bias_3, status_3, sfp_tbl_bg, textClr, sfp_tbl_size)
            sfp_row := sfp_row + 1
            f_draw_status_row_internal(sfp_tbl, sfp_row, "MTF Bias (1m):", bias_1, status_1, sfp_tbl_bg, textClr, sfp_tbl_size)
