    color bull_border = #0f0f0f
    color bull_wick = #0f0f0f
    color bear_body = #636363
    color bear_border = #0f0f0f
    color bear_wick = #0f0f0f
    int offset = 20
    int buffer = 1
    bool htf_smt_show = false
    color smt_bull_color = color.blue
    color smt_bear_color = color.red
    int smt_width = 1
    int htf_buffer = 5
    int width = 2
    bool daily_name = false
    string label_position = "Top"
    string label_alignment = "Follow Candles"
    bool fvg_show = false
    color fvg_color = color.gray 
    bool vi_show = false
    color vi_color = color.red   
    bool htf_label_show = true
    color htf_label_color = #0f0f0f
    string htf_label_size = size.normal
    bool htf_timer_show = true
    color htf_timer_color = #0f0f0f
