# CRT-ALGO Backend Environment Variables Template
# Copy this to .env and fill in your values
# DO NOT commit .env to version control!

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Master Encryption Key (for decrypting stored API secrets)
MASTER_ENCRYPTION_KEY=your-32-char-base64-key

# Webhook Security
WEBHOOK_PASSPHRASE=your-secure-passphrase

# Discord Webhooks (optional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_HTF=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_CRYPTO_LTF=
DISCORD_WEBHOOK_CRYPTO_HTF=
DISCORD_WEBHOOK_CRYPTO_MHTF=
DISCORD_WEBHOOK_CRYPTO_HHTF=
DISCORD_WEBHOOK_FOREX_LTF=
DISCORD_WEBHOOK_FOREX_HTF=
DISCORD_WEBHOOK_FOREX_MHTF=
DISCORD_WEBHOOK_FOREX_HHTF=
DISCORD_WEBHOOK_INDICES_LTF=
DISCORD_WEBHOOK_INDICES_HTF=
DISCORD_WEBHOOK_INDICES_MHTF=
DISCORD_WEBHOOK_INDICES_HHTF=
DISCORD_WEBHOOK_METALS_LTF=
DISCORD_WEBHOOK_METALS_HTF=
DISCORD_WEBHOOK_METALS_MHTF=
DISCORD_WEBHOOK_METALS_HHTF=

# Price API Keys (optional)
FCS_API_KEY=
GOLD_API_KEY=
EODHD_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Render uses these
# PORT=10000 (automatically set by Render)